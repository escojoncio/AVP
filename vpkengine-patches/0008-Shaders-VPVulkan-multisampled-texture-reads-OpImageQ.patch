diff --git a/gpu/shader/msl/tests/ms_textures.metal b/gpu/shader/msl/tests/ms_textures.metal
new file mode 100644
index 0000000..da4f204
--- /dev/null
+++ b/gpu/shader/msl/tests/ms_textures.metal
@@ -0,0 +1,31 @@
+#include <metal_stdlib>
+using namespace metal;
+#ifndef VP_PSZ
+#define VP_PSZ point_size
+#endif
+
+struct VpArgs {
+    texture2d_ms<float> msaa;
+    depth2d_ms_array<float> mdepth;
+};
+
+struct VpOut {
+    float4 color [[color(0)]];
+};
+
+fragment VpOut vp_main(constant VpArgs& vp_args [[buffer(0)]],
+        float4 in_pos [[position]],
+        uint in_sid [[sample_id]]) {
+    VpOut vp_out;
+    const float2 v4 = float2(in_pos.x, in_pos.y);
+    const uint2 v5 = uint2(v4);
+    const float4 v6 = vp_args.msaa.read(v5, in_sid);
+    const uint3 v10 = uint3(v5.x, v5.y, 1u);
+    const float v12 = vp_args.mdepth.read(v10.xy, v10.z, 0u);
+    const uint v13 = vp_args.msaa.get_num_samples();
+    const float v14 = float(v13);
+    const float v16 = v6.x + v12;
+    const float4 v17 = float4(v16, v14, v12, v6.x);
+    vp_out.color = v17;
+    return vp_out;
+}
diff --git a/gpu/shader/msl/tests/ms_textures.vpir b/gpu/shader/msl/tests/ms_textures.vpir
new file mode 100644
index 0000000..0d00129
--- /dev/null
+++ b/gpu/shader/msl/tests/ms_textures.vpir
@@ -0,0 +1,30 @@
+module fragment
+
+input pos : vec4<f32> builtin(position)
+input sid : u32 builtin(sample_id)
+output color : vec4<f32> location(0)
+texture msaa : 2d f32 multisampled index(0)
+texture mdepth : 2d_array f32 depth multisampled index(1)
+
+; Multisampled reads (texelFetch of sampler2DMS / subpass MS inputs) and the sample count query.
+func main() {
+  %0 = load_input pos : vec4<f32>
+  %1 = load_input sid : u32
+  %2 = extract %0, 0 : f32
+  %3 = extract %0, 1 : f32
+  %4 = construct %2, %3 : vec2<f32>
+  %5 = convert %4 : vec2<u32>
+  %6 = image_fetch msaa, %5, sample(%1) : vec4<f32>
+  %7 = extract %5, 0 : u32
+  %8 = extract %5, 1 : u32
+  %9 = const 1 : u32
+  %10 = construct %7, %8, %9 : vec3<u32>
+  %11 = const 0 : u32
+  %12 = image_fetch mdepth, %10, sample(%11) : f32
+  %13 = image_samples msaa : u32
+  %14 = convert %13 : f32
+  %15 = extract %6, 0 : f32
+  %16 = add %15, %12 : f32
+  %17 = construct %16, %14, %12, %15 : vec4<f32>
+  store_output color, %17
+}
