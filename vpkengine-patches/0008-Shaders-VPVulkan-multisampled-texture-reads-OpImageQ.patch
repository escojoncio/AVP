diff --git a/gpu/vulkan/src/pipelines.cpp b/gpu/vulkan/src/pipelines.cpp
index ebf7485..14d4433 100644
--- a/gpu/vulkan/src/pipelines.cpp
+++ b/gpu/vulkan/src/pipelines.cpp
@@ -1610,8 +1610,38 @@ VPVK_EXPORT VKAPI_ATTR void VKAPI_CALL vkCmdResolveImage(VkCommandBuffer cb, VkI
     }
     return;
   }
-  static std::atomic<unsigned> k{0};
-  if (k.fetch_add(1) < 8) log("vk.unimpl resolve_image (render-pass resolves are supported)");
+  const Image* s = from<Image>(src);
+  const Image* d = from<Image>(dst);
+  if (!s || !d || !s->id || !d->id) return;
+  Recorder& r = rec(cb);
+  const bool depth = vpgpu::formatInfo(s->desc.format).depth() || vpgpu::formatInfo(s->desc.format).stencil();
+  for (uint32_t i = 0; i < n; ++i) {
+    const VkImageResolve& x = regions[i];
+    // Metal resolves whole attachments: a region smaller than the image resolves the rest too
+    // (logged); engines resolve whole images in practice.
+    const uint32_t w = std::max(1u, s->desc.width >> x.srcSubresource.mipLevel);
+    const uint32_t h = std::max(1u, s->desc.height >> x.srcSubresource.mipLevel);
+    if (x.srcOffset.x || x.srcOffset.y || x.extent.width < w || x.extent.height < h || x.dstOffset.x || x.dstOffset.y) {
+      static std::atomic<unsigned> k{0};
+      if (k.fetch_add(1) < 8)
+        logf("vk.note resolve_image partial region %ux%u+%d,%d of %ux%u resolved whole", x.extent.width, x.extent.height,
+             x.srcOffset.x, x.srcOffset.y, w, h);
+    }
+    const uint32_t layers = x.srcSubresource.layerCount == VK_REMAINING_ARRAY_LAYERS
+                                ? s->desc.layers - x.srcSubresource.baseArrayLayer
+                                : x.srcSubresource.layerCount;
+    OpResolve op;
+    vpgpu::Attachment& a = depth ? op.desc.depth : op.desc.colors[0];
+    a.texture = s->id;
+    a.mip = uint16_t(x.srcSubresource.mipLevel), a.layer = uint16_t(x.srcSubresource.baseArrayLayer);
+    a.load = vpgpu::LoadAction::Load;
+    a.store = vpgpu::StoreAction::StoreAndResolve;
+    a.resolve = d->id;
+    a.resolveMip = uint16_t(x.dstSubresource.mipLevel), a.resolveLayer = uint16_t(x.dstSubresource.baseArrayLayer);
+    op.desc.layerCount = uint16_t(std::max(1u, layers));
+    op.desc.label = "vk.resolve_image";
+    r.ops.emplace_back(std::move(op));
+  }
 }
 
