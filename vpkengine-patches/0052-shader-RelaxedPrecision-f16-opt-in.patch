+// RelaxedPrecision (SpirvLowerOptions::relaxedF16; tests/asm/relaxed_f16.frag.spvasm): four decorated ops. The
+// multiply a (vec4) and the add r reach the colour output; the multiply u2 (vec2) is the sample coordinate and
+// the multiply d (scalar) decides a discard: those two must stay f32.
+void relaxedF16(const std::string& dir, const std::string&) {
+    std::printf("[relaxed_f16]\n");
+    spirv::SpirvLowerOptions f;
+    f.entry = "main", f.stage = vpir::Stage::Fragment;
+    f.layout = {bind(0, 1, vpgpu::BindKind::Texture, 0), bind(0, 2, vpgpu::BindKind::Sampler, 0)};
+    const std::string path = dir + "/relaxed_f16.frag.spv";
+    {  // off: the shader is f32 throughout
+        Result r = run(path, f);
+        CHECK(r.ok && r.msl.source.find("half") == std::string::npos);
+    }
+    f.relaxedF16 = true;
+    const spirv::RelaxedF16Totals before = spirv::relaxedF16Totals();
+    Result r = run(path, f);
+    CHECK(r.ok);
+    if (!r.ok) return;
+    const spirv::RelaxedF16Totals t = spirv::relaxedF16Totals();
+    CHECK(t.decorated - before.decorated == 4 && t.demoted - before.demoted == 2 && t.excluded - before.excluded == 2);
+    CHECK(r.msl.source.find("half4") != std::string::npos);
+    int mulHalf4 = 0, addHalf4 = 0, mulF32 = 0, samples = 0;
+    auto walk = [&](const vpir::Block& b, auto&& self) -> void {
+        for (const vpir::Node& n : b) {
+            const vpir::Inst& in = n.inst;
+            if (n.kind == vpir::NodeKind::Inst) {
+                const bool h4 = in.type == vpir::Type(vpir::Scalar::F16, 4);
+                if (in.op == vpir::Op::Mul && h4) ++mulHalf4;
+                if (in.op == vpir::Op::Add && h4) ++addHalf4;
+                if (in.op == vpir::Op::Mul && in.type.scalar == vpir::Scalar::F32 && in.type.width < 4) ++mulF32;
+                if (in.op == vpir::Op::ImageSample) {
+                    ++samples;
+                    CHECK(r.module.functions[0].typeOf(in.args[0]) == vpir::Type(vpir::Scalar::F32, 2));
+                }
+            }
+            self(n.body, self);
+            self(n.elseBody, self);
+        }
+    };
+    walk(r.module.functions[0].body, walk);
+    CHECK(mulHalf4 == 1 && addHalf4 == 1 && mulF32 == 2 && samples == 1);
+
+    // tests/asm/relaxed_f16_b.frag.spvasm, six decorated ops: dot and length of an interpolant (unbounded: stay
+    // f32), dot of a texture result (bounded: f16), a multiply by 1e-6 (not a normal half: stays f32), and an add and
+    // a select of f16 values, the add read after an if (a variable between blocks).
+    const spirv::RelaxedF16Totals before2 = spirv::relaxedF16Totals();
+    Result b = run(dir + "/relaxed_f16_b.frag.spv", f);
+    CHECK(b.ok);
+    if (!b.ok) return;
+    const spirv::RelaxedF16Totals t2 = spirv::relaxedF16Totals();
+    CHECK(t2.decorated - before2.decorated == 6 && t2.demoted - before2.demoted == 3 && t2.excluded - before2.excluded == 3);
+    int dotH = 0, dotF = 0, lenH = 0, lenF = 0, mulH = 0, mulF = 0, selH = 0, addH = 0;
+    auto walk2 = [&](const vpir::Block& blk, auto&& self) -> void {
+        for (const vpir::Node& n : blk) {
+            const vpir::Inst& in = n.inst;
+            if (n.kind == vpir::NodeKind::Inst) {
+                const bool h = in.type.scalar == vpir::Scalar::F16, fl = in.type.scalar == vpir::Scalar::F32;
+                if (in.op == vpir::Op::Dot) ++(h ? dotH : dotF);
+                if (in.op == vpir::Op::Length) ++(h ? lenH : lenF);
+                if (in.op == vpir::Op::Mul) mulH += h, mulF += fl;
+                if (in.op == vpir::Op::Select && h) ++selH;
+                if (in.op == vpir::Op::Add && h) ++addH;
+            }
+            self(n.body, self);
+            self(n.elseBody, self);
+        }
+    };
+    walk2(b.module.functions[0].body, walk2);
+    CHECK(dotH == 1 && dotF == 1 && lenH == 0 && lenF == 1 && mulH == 0 && mulF == 1 && selH == 1 && addH == 1);
+    // The MSL types agree: a variable is only assigned a value of its own type, a select picks between operands
+    // of the select's type.
+    std::map<std::string, std::string> ty;
+    std::istringstream is(b.msl.source);
+    int stores = 0, halfSelects = 0, bad = 0;
+    for (std::string line; std::getline(is, line);) {
+        std::istringstream ls(line);
+        std::vector<std::string> tok;
+        for (std::string x; ls >> x;) tok.push_back(x);
+        auto bare = [](std::string x) { while (!x.empty() && (x.back() == ';' || x.back() == ',')) x.pop_back(); return x; };
+        if (tok.size() >= 2 && tok[1].starts_with("l") && tok[1].ends_with("{};")) ty[tok[1].substr(0, tok[1].size() - 3)] = tok[0];
+        else if (tok.size() >= 4 && tok[0] == "const") ty[tok[2]] = tok[1];
+        if (tok.size() == 3 && tok[0].starts_with("l") && tok[1] == "=" && ty.count(tok[0]) && ty.count(bare(tok[2]))) {
+            ++stores;
+            bad += ty[tok[0]] != ty[bare(tok[2])];
+        }
+        if (tok.size() == 9 && tok[0] == "const" && tok[5] == "?" && tok[7] == ":") {
+            halfSelects += tok[1] == "half";
+            for (const std::string& op : {bare(tok[6]), bare(tok[8])}) bad += ty.count(op) && ty[op] != tok[1];
+        }
+    }
+    CHECK(stores >= 1 && halfSelects == 1 && bad == 0);
+}
