--- /dev/null
+++ b/gpu/shader/spirv/tests/asm/relaxed_f16.frag.spvasm
@@ -0,0 +1,57 @@
+OpCapability Shader
+OpMemoryModel Logical GLSL450
+OpEntryPoint Fragment %main "main" %uv %col %out
+OpExecutionMode %main OriginUpperLeft
+OpDecorate %uv Location 0
