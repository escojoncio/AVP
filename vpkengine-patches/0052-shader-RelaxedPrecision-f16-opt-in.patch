     std::memcpy(&b, &f, 4);
@@ -201,6 +205,9 @@ private:
     int mvCurIn_ = -1, mvPrevIn_ = -1;
     Scope* entryScope_ = nullptr;
     std::unordered_map<uint32_t, uint64_t> specValue_;
+    // SpirvLowerOptions::relaxedF16: VPIR values (fragment) that are the result of a float op decorated
+    // RelaxedPrecision, for vpir::demoteRelaxed at the end of run().
+    std::vector<bool> relaxed_;
 
     // ---- types ---------------------------------------------------------------------------------
     const TypeInfo& T(uint32_t id) const {
@@ -1754,7 +1761,11 @@ private:
     // Emits one block; returns the next block to emit in this region, or 0.
     uint32_t emitBlock(const Block& bl, uint32_t stop) {
         scope_->block = bl.label;
-        for (const Instr& in : bl.body) instruction(in);
+        for (const Instr& in : bl.body) {
+            const size_t first = b_fn().valueTypes.size();
+            instruction(in);
+            markRelaxed(in, first);
+        }
         const Instr& t = bl.terminator;
         switch (t.op) {
             case OpBranch: {
@@ -1982,6 +1993,32 @@ private:
         return bin(op, a, c, resultVt(in));
     }
 
+    // Records the result of `in` (lowered to values >= `first`) when it is a float op the shader decorated
+    // RelaxedPrecision. Only the final value: what the lowering built around it stays f32.
+    void markRelaxed(const Instr& in, size_t first) {
+        if (!o_.relaxedF16 || stage_ != vpir::Stage::Fragment) return;
+        switch (in.op) {
+            case OpFNegate: case OpFAdd: case OpFSub: case OpFMul: case OpFDiv: case OpVectorTimesScalar: case OpDot:
+            case OpCompositeExtract: case OpCompositeConstruct: case OpVectorShuffle: case OpSelect: break;
+            case OpExtInst:
+                switch (w(in, 4)) {
+                    case GLSL_FAbs: case GLSL_Floor: case GLSL_Ceil: case GLSL_Fract: case GLSL_Trunc: case GLSL_Sqrt:
+                    case GLSL_InverseSqrt: case GLSL_Exp2: case GLSL_Log2: case GLSL_Pow: case GLSL_FMin: case GLSL_NMin:
+                    case GLSL_FMax: case GLSL_NMax: case GLSL_FClamp: case GLSL_NClamp: case GLSL_FMix: case GLSL_Fma:
+                    case GLSL_Length: case GLSL_Distance: case GLSL_Normalize: break;
+                    default: return;
+                }
+                break;
+            default: return;
+        }
+        const Decorations* d = m_.deco(w(in, 2));
+        if (!d || !d->has(Deco::RelaxedPrecision)) return;
+        auto it = scope_->vals.find(w(in, 2));
+        if (it == scope_->vals.end() || it->second.v.size() != 1 || it->second.v[0] < first) return;
+        if (relaxed_.size() <= it->second.v[0]) relaxed_.resize(it->second.v[0] + 1);
+        relaxed_[it->second.v[0]] = true;
+    }
+
     void instruction(const Instr& in) {
         const uint16_t op = in.op;
         switch (op) {
@@ -3328,6 +3365,10 @@ void Lowering::run() {
     initPrivates();
     flow(fit->second.blocks.front().label, 0);
     b_->finish();
+    if (o_.relaxedF16 && stage_ == vpir::Stage::Fragment) {
+        vpir::RelaxedStats rs = vpir::demoteRelaxed(out_, relaxed_);
+        gRelaxedDecorated += rs.decorated, gRelaxedDemoted += rs.demoted, gRelaxedExcluded += rs.excluded;
+    }
 
     // Buffers never stored to are read-only; storage textures keep the access their decorations
     // gave.
@@ -3364,6 +3405,10 @@ void Lowering::run() {
 
 }  // namespace
 
+RelaxedF16Totals relaxedF16Totals() {
+    return {gRelaxedDecorated.load(), gRelaxedDemoted.load(), gRelaxedExcluded.load()};
+}
