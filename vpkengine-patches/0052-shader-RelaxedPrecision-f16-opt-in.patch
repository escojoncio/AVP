+struct RelaxedStats {
+    uint32_t decorated = 0;  // relaxed candidate ops seen
+    uint32_t demoted = 0;    // ... computed in f16
+    uint32_t excluded = 0;   // ... kept f32 because they feed something that needs full precision
+};
+
+// Fragment shaders: computes in f16 the float ops the source marked RelaxedPrecision (`relaxed[v]` for the
+// result value v of the entry point), with explicit f32 <-> f16 converts at the boundaries (an operand that
+// is f32 is converted; a consumer that is not demoted reads an f32 copy). An op stays f32 when its result
+// feeds, directly or through operands, variables and memory, an image/atomic/derivative/subgroup/call
+// operand, a non-colour output (depth, sample mask), a memory address, an integer or bitcast, or an
+// if/return condition. Ops with `precise` stay f32, and so do ops with a constant operand f16 cannot hold as a
+// normal number (|c| > 65504 or 0 < |c| < 6.1e-5) and dot/length/normalize/rsq/div/rcp/pow/exp2 with an operand
+// that is not already f16 or bounded (texture result, saturate/clamp to constants, normalize, constant).
+RelaxedStats demoteRelaxed(Module& module, const std::vector<bool>& relaxed);
+
 }  // namespace vpir
diff --git a/gpu/shader/ir/src/relaxed.cpp b/gpu/shader/ir/src/relaxed.cpp
new file mode 100644
index 0000000..e194b12
--- /dev/null
+++ b/gpu/shader/ir/src/relaxed.cpp
@@ -0,0 +1,259 @@
+#include <bit>
+#include <cmath>
+#include <map>
+#include <set>
+#include <unordered_map>
+
+#include "vpir/passes.h"
+
+namespace vpir {
+
+namespace {
+
+// Float ops the source may mark relaxed that run in f16 with every float operand converted. Data
+// movement (extract/construct/shuffle/select) is included so a relaxed chain does not bounce
+// between f16 and f32 at each swizzle. Trig, rem and round stay f32.
+bool candidate(Op op) {
+    switch (op) {
+        case Op::Add: case Op::Sub: case Op::Mul: case Op::Div: case Op::Neg: case Op::Abs:
+        case Op::Min: case Op::Max: case Op::Fma: case Op::Clamp: case Op::Mix:
+        case Op::Floor: case Op::Ceil: case Op::Trunc: case Op::Fract:
+        case Op::Sqrt: case Op::Rsq: case Op::Rcp: case Op::Exp2: case Op::Log2: case Op::Pow:
+        case Op::Saturate: case Op::Dot: case Op::Length: case Op::Normalize:
+        case Op::Extract: case Op::Construct: case Op::Shuffle: case Op::Select: return true;
+        default: return false;
+    }
+}
+
+// Ops that blow up or flush in f16 when an operand is large or tiny (squares, reciprocals, powers): they are
+// only demoted when every f32 operand is bounded (see `bounded` below).
+bool sensitive(Op op) {
+    switch (op) {
+        case Op::Dot: case Op::Length: case Op::Normalize: case Op::Rsq: case Op::Div: case Op::Rcp: case Op::Pow:
+        case Op::Exp2: return true;
+        default: return false;
+    }
+}
+
+// A constant that f16 holds as a normal number (zero too).
+bool halfNormal(uint32_t bits) {
+    const float a = std::fabs(std::bit_cast<float>(bits));
+    return std::isfinite(a) && a <= 65504.0f && (a == 0.0f || a >= 6.104e-5f);
+}
+
+// Ops whose operands must keep full precision: atomics, images (coordinates, lod, compare…),
+// interpolation offsets, derivatives, subgroup/quad exchange, calls, bit reinterpretation.
+// (Ranges of the VPIR_OPS order: AtomicAdd..Fwidth, SubgroupBallot..MeshPrimitiveCount.)
+bool pinsOperands(Op op) {
+    return (op >= Op::AtomicAdd && op <= Op::Fwidth) || (op >= Op::SubgroupBallot && op <= Op::MeshPrimitiveCount) ||
+           op == Op::Call || op == Op::Bitcast;
+}
+
+}  // namespace
+
+RelaxedStats demoteRelaxed(Module& m, const std::vector<bool>& relaxed) {
+    RelaxedStats st;
+    if (m.stage != Stage::Fragment || !m.entry()) return st;
+    Function& f = m.functions[size_t(m.entry() - m.functions.data())];
+    const size_t n = f.valueTypes.size();
+
+    // ---- 1. Values that must stay f32: everything feeding, directly or through operands, variables
+    // and memory, a pinned operand, a non-colour output, an address, an integer, or a branch condition.
+    std::vector<const Inst*> def(n, nullptr);
+    std::vector<char> tainted(n, 0);
+    std::vector<ValueId> work;
+    std::vector<std::vector<ValueId>> varStores(f.vars.size());
+    std::map<uint32_t, std::vector<ValueId>> memStores;
+    auto mark = [&](ValueId v) {
+        if (v < n && !tainted[v]) tainted[v] = 1, work.push_back(v);
+    };
+    auto seed = [&](const Block& b, auto&& self) -> void {
+        for (const Node& nd : b) {
+            if (nd.kind == NodeKind::Inst) {
+                const Inst& in = nd.inst;
+                if (in.result != kNoValue && in.result < n) {
+                    def[in.result] = &in;
+                    if (in.type.isInt()) mark(in.result);
+                }
+                if (pinsOperands(in.op)) {
+                    for (ValueId a : in.args) mark(a);
+                } else if (in.op == Op::StoreVar) {
+                    varStores[in.sym].push_back(in.args[0]);
+                } else if (in.op == Op::StoreOutput) {
+                    if (m.outputs[in.sym].builtin != Builtin::None) mark(in.args[0]);  // depth, sample mask
+                } else if (in.op == Op::Load) {
+                    mark(in.args[0]);
+                } else if (in.op == Op::Store) {
+                    mark(in.args[0]);
+                    memStores[in.sym].push_back(in.args[1]);
+                }
+            } else if (nd.value != kNoValue) {
+                mark(nd.value);  // if condition, returned value
+            }
+            self(nd.body, self);
+            self(nd.elseBody, self);
+        }
+    };
+    seed(f.body, seed);
+    std::vector<char> varDone(f.vars.size(), 0);
+    std::set<uint32_t> memDone;
+    while (!work.empty()) {
+        const Inst* d = def[work.back()];
+        work.pop_back();
+        if (!d) continue;
+        for (ValueId a : d->args) mark(a);
+        if (d->op == Op::LoadVar && !varDone[d->sym]) {
+            varDone[d->sym] = 1;
+            for (ValueId s : varStores[d->sym]) mark(s);
+        }
+        if (d->op == Op::Load && memDone.insert(d->sym).second)
+            for (ValueId s : memStores[d->sym]) mark(s);
+    }
+
+    // ---- 2. Decorated candidates that are not tainted are demoted.
+    std::vector<char> demote(n, 0), needsFull(n, 0);
+    std::unordered_map<ValueId, std::vector<uint32_t>> constLits;  // f32 constants (the nodes move below)
+    auto constOk = [&](ValueId v) {
+        for (uint32_t l : constLits[v])
+            if (!halfNormal(l)) return false;
+        return true;
+    };
+    // Whether f32 value v is already f16 (demoted, so decided earlier in program order) or provably small and
+    // finite: a texture result, a saturate or a clamp to constant limits, a normalize, a representable constant,
+    // or data movement of those.
+    std::vector<char> boundedMemo(n, 0);  // 1 = yes, 2 = no
+    auto bounded = [&](ValueId v, auto&& self) -> bool {
+        if (v >= n) return false;
+        if (demote[v]) return true;
+        if (boundedMemo[v]) return boundedMemo[v] == 1;
+        const Inst* d = def[v];
+        bool ok = false;
+        if (d && d->op == Op::Const) {
+            ok = constOk(v);
+        } else if (d) {
+            switch (d->op) {
+                case Op::ImageSample: case Op::ImageGather: case Op::ImageFetch: case Op::Saturate: case Op::Normalize:
+                    ok = true;
+                    break;
+                case Op::Clamp:
+                    ok = constLits.count(d->args[1]) && constLits.count(d->args[2]) && constOk(d->args[1]) && constOk(d->args[2]);
+                    break;
+                case Op::Extract: case Op::Shuffle: case Op::Construct:
+                    ok = true;
+                    for (ValueId a : d->args) ok = ok && self(a, self);
+                    break;
+                case Op::Select:
+                    ok = self(d->args[1], self) && self(d->args[2], self);
+                    break;
+                default: break;
+            }
+        }
+        boundedMemo[v] = ok ? 1 : 2;
+        return ok;
+    };
+    auto choose = [&](const Block& b, auto&& self) -> void {
+        for (const Node& nd : b) {
+            const Inst& in = nd.inst;
+            if (nd.kind == NodeKind::Inst && in.result < n) {
+                if (in.op == Op::Const && in.type.scalar == Scalar::F32) constLits[in.result] = in.lits;
+                if (in.result < relaxed.size() && relaxed[in.result] && candidate(in.op) &&
+                    in.type.scalar == Scalar::F32 && !in.precise) {
+                    ++st.decorated;
+                    // A constant f16 cannot hold, or an unbounded operand of a sensitive op, keeps it f32.
+                    bool ok = !tainted[in.result];
+                    for (ValueId a : in.args) {
+                        if (!ok || a >= n || f.valueTypes[a].scalar != Scalar::F32) continue;
+                        if (constLits.count(a)) ok = constOk(a);
+                        else if (sensitive(in.op)) ok = bounded(a, bounded);
+                    }
+                    if (!ok) ++st.excluded;
+                    else demote[in.result] = 1, ++st.demoted;
+                }
+            }
+            self(nd.body, self);
+            self(nd.elseBody, self);
+        }
+    };
+    choose(f.body, choose);
+    if (!st.demoted) return st;
+
+    // ---- 3. Rewrite: f16 operands converted at the boundary, an f32 copy right after each demoted
+    // value that something not demoted reads.
+    auto usesFull = [&](const Block& b, auto&& self) -> void {
+        for (const Node& nd : b) {
+            if (nd.kind == NodeKind::Inst) {
+                if (!(nd.inst.result < n && demote[nd.inst.result]))
+                    for (ValueId a : nd.inst.args)
+                        if (a < n && demote[a]) needsFull[a] = 1;
+            } else if (nd.value < n && demote[nd.value]) {
+                needsFull[nd.value] = 1;
+            }
+            self(nd.body, self);
+            self(nd.elseBody, self);
+        }
+    };
+    usesFull(f.body, usesFull);
+
+    std::vector<ValueId> full(n, kNoValue);
+    auto fresh = [&](Inst in, Block& out) {
+        in.result = ValueId(f.valueTypes.size());
+        f.valueTypes.push_back(in.type);
+        Node nd;
+        nd.inst = std::move(in);
+        out.push_back(std::move(nd));
+        return ValueId(f.valueTypes.size() - 1);
+    };
+    // The f16 version of an operand: demoted values and non-float operands are as they are.
+    auto halfOf = [&](ValueId a, Block& out) {
+        const Type t = f.typeOf(a);
+        if (t.scalar != Scalar::F32) return a;
+        Inst c;
+        c.type = t.withScalar(Scalar::F16);
+        if (auto k = constLits.find(a); k != constLits.end()) {
+            c.op = Op::Const;
+            for (uint32_t l : k->second) c.lits.push_back(floatToHalf(std::bit_cast<float>(l)));
+        } else {
+            c.op = Op::Convert;
+            c.args = {a};
+        }
+        return fresh(std::move(c), out);
+    };
+    auto rewrite = [&](Block& b, auto&& self) -> void {
+        Block out;
+        out.reserve(b.size());
+        for (Node& nd : b) {
+            if (nd.kind != NodeKind::Inst) {
+                if (nd.value < n && demote[nd.value]) nd.value = full[nd.value];
+                self(nd.body, self);
+                self(nd.elseBody, self);
+                out.push_back(std::move(nd));
+                continue;
+            }
+            Inst& in = nd.inst;
+            if (!(in.result < n && demote[in.result])) {
+                for (ValueId& a : in.args)
+                    if (a < n && demote[a]) a = full[a];
+                out.push_back(std::move(nd));
+                continue;
+            }
+            for (ValueId& a : in.args) a = halfOf(a, out);
+            const ValueId r = in.result;
+            in.type = in.type.withScalar(Scalar::F16);
+            f.valueTypes[r] = in.type;
+            const Type back = in.type.withScalar(Scalar::F32);
+            out.push_back(std::move(nd));
+            if (needsFull[r]) {
+                Inst c;
+                c.op = Op::Convert;
+                c.type = back;
+                c.args = {r};
+                full[r] = fresh(std::move(c), out);
+            }
+        }
+        b = std::move(out);
+    };
+    rewrite(f.body, rewrite);
+    return st;
+}
+
+}  // namespace vpir
