 gpu/core/include/vpgpu/core/commands.h |  3 ++
 gpu/core/src/commands.cpp              |  4 +++
 gpu/core/tests/core_tests.cpp          | 47 +++++++++++++++++++++++++-
 gpu/vulkan/src/commands.cpp            |  1 +
 5 files changed, 55 insertions(+), 2 deletions(-)

