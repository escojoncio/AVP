diff --git a/gpu/core/src/frame_compiler.cpp b/gpu/core/src/frame_compiler.cpp
index 4f768af..87c141b 100644
--- a/gpu/core/src/frame_compiler.cpp
+++ b/gpu/core/src/frame_compiler.cpp
@@ -828,12 +828,16 @@ void hoistCopyWaits(CompiledFrame& out, const std::vector<Command>& cmds) {
   out.barriers = std::move(kept);
 }
 
+// Consecutive dead stores of an MSAA texture before its store is elided (CompileOptions::msaaDeadStore).
+constexpr uint8_t kDeadStoreFrames = 3;
+
 // Phase 3: decide which attachments never need memory (see TileVerdict).
 void placeTiles(CompiledFrame& out, const std::vector<Command>& cmds, const std::vector<AccessList>& accesses,
                 const ResourceTable& res, const CompileOptions& options) {
   struct Use {
     int encoder = -1, last = -1;  // render encoder holding it as attachment; last encoder using it
     int firstRead = -1;           // first encoder that samples, copies or loads it (-1: none)
+    int firstAttach = -1;         // first encoder that attaches it (-1: none)
     bool multi = false, pixelLocal = false, sampled = false, elsewhere = false, badFetch = false;
   };
   std::unordered_map<uint64_t, Use> uses;
@@ -860,6 +864,7 @@ void placeTiles(CompiledFrame& out, const std::vector<Command>& cmds, const std:
       Use& u = uses[key(a.texture.index, a.texture.generation)];
       u.multi = u.multi || (u.encoder >= 0 && u.encoder != static_cast<int>(e));
       if (a.load == LoadAction::Load && u.encoder < 0 && u.firstRead < 0) u.firstRead = static_cast<int>(e);
+      if (u.firstAttach < 0) u.firstAttach = static_cast<int>(e);
       u.encoder = static_cast<int>(e);
       if (a.resolve) uses[key(a.resolve.index, a.resolve.generation)].elsewhere = true;  // resolved into memory
     });
@@ -872,6 +877,25 @@ void placeTiles(CompiledFrame& out, const std::vector<Command>& cmds, const std:
     const TextureDesc* d = res.get(TextureId{uint32_t(k & 0xffffffffu), uint32_t(k >> 32)});
     if (d && d->samples > 1 && (u.encoder < 0 || u.firstRead < u.encoder)) ++out.stats.msaaStaleReads;
   }
+  // Dead-store history (CompileOptions::msaaDeadStore): what each touched MSAA texture's first access needs.
+  std::unordered_map<uint64_t, size_t> obsAt;
+  std::unordered_set<uint64_t> missed;
+  if (options.msaaDeadStore)
+    for (const auto& [k, u] : uses) {
+      const TextureId id{uint32_t(k & 0xffffffffu), uint32_t(k >> 32)};
+      const TextureDesc* d = res.get(id);
+      if (!d || d->samples < 2 || (u.firstAttach < 0 && u.firstRead < 0)) continue;
+      StoreObs o;
+      o.texture = id;
+      o.readFirst = u.firstRead >= 0 && (u.firstAttach < 0 || u.firstRead <= u.firstAttach);
+      if (o.readFirst && res.storeHistory(id).elided) {  // contents the elided store never wrote: this frame cannot be saved
+        missed.insert(k);
+        ++out.stats.elideMiss;
+        out.elideMisses.push_back(id);
+      }
+      obsAt[k] = out.storeObs.size();
+      out.storeObs.push_back(o);
+    }
   std::unordered_set<uint64_t> rejected;
   for (uint32_t e = 0; e < out.encoders.size(); ++e) {
     Encoder& enc = out.encoders[e];
@@ -913,7 +937,11 @@ void placeTiles(CompiledFrame& out, const std::vector<Command>& cmds, const std:
       // Loading memory no frame has defined returns anything, so it may as well be DontCare (below,
       // once the texture can stay on tile).
       const bool undefinedLoad = a.load == LoadAction::Load && !res.memValid(a.texture);
-      if (a.store != StoreAction::DontCare && a.store != StoreAction::Resolve && !d->transient && !msaaResolve) v = TileVerdict::None;
+      const bool kept = a.store != StoreAction::DontCare && a.store != StoreAction::Resolve && !d->transient && !msaaResolve;
+      // A client Store of MSAA samples may be a dead store: judged below as if it were dropped.
+      const bool deadCand = kept && options.msaaDeadStore && d->samples > 1 && !missed.count(k) &&
+                            !res.storeHistory(a.texture).banned;
+      if (kept && !deadCand) v = TileVerdict::None;
       else if (d->persistent && !msaaResolve) v = TileVerdict::Persistent;
       else if (u.elsewhere) v = TileVerdict::UsedElsewhere;
       else if (u.badFetch) v = TileVerdict::BadFetch;
@@ -923,6 +951,16 @@ void placeTiles(CompiledFrame& out, const std::vector<Command>& cmds, const std:
       else if (d->type != TextureType::Tex2D || d->mips != 1 || d->layers != enc.pass.layerCount || a.layer) v = TileVerdict::Partial;
       else if (!(extent(a, res) == ref)) v = TileVerdict::SizeMismatch;
       else v = TileVerdict::TileLocal;
+      if (deadCand) {
+        if (v == TileVerdict::TileLocal) {
+          StoreObs& o = out.storeObs[obsAt.at(k)];
+          o.candidate = true;
+          if (res.storeHistory(a.texture).dead >= kDeadStoreFrames && !heavy) o.elided = true, ++out.stats.storesElided;
+          else v = TileVerdict::None;  // stored for real this frame (the history keeps counting)
+        } else {
+          v = TileVerdict::None;  // the contents are used (or kept) otherwise: not a dead store
+        }
+      }
       if (v == TileVerdict::TileLocal && heavy) {
         v = TileVerdict::HeavyGeometry;  // would stay on tile, but the tiler may flush: real memory (backend: memBacked)
         if (msaaResolve) {
@@ -993,6 +1031,16 @@ void trackMemory(CompiledFrame& out, const std::vector<AccessList>& accesses, co
 
 void commitMemory(const CompiledFrame& compiled, ResourceTable& resources) {
   for (const auto& [t, valid] : compiled.memAfter) resources.setMemValid(t, valid);
+  for (const StoreObs& o : compiled.storeObs) {
+    ResourceTable::StoreHistory h = resources.storeHistory(o.texture);
+    if (h.pending) {  // the previous touching frame's candidate store: did this frame's first access need it?
+      if (!o.readFirst) h.dead = h.dead < 255 ? h.dead + 1 : h.dead;
+      else h.dead = 0, h.banned = h.banned || h.elided;
+    }
+    if (!o.candidate) h.dead = 0, h.banned = h.banned || h.elided;  // elided, then a frame we cannot vouch for (e.g. partial): ban
+    h.pending = o.candidate, h.elided = o.elided;
+    resources.setStoreHistory(o.texture, h);
+  }
 }
 
 bool CompiledFrame::skipped(uint32_t command, uint32_t draw) const {
diff --git a/gpu/core/tests/core_tests.cpp b/gpu/core/tests/core_tests.cpp
index 62eb0b5..ecb082d 100644
--- a/gpu/core/tests/core_tests.cpp
+++ b/gpu/core/tests/core_tests.cpp
@@ -2222,6 +2222,186 @@ void testAstroFrame() {
     if (l.find("tile=") != std::string::npos || l.find("mem=") != std::string::npos) std::printf("  %s\n", l.c_str());
 }
 
+// MSAA dead-store elision (CompileOptions::msaaDeadStore): a client Store nothing reads afterwards is dropped once 3
+// consecutive frames showed the next frame did not need the contents.
+void testDeadStore() {
+  struct Ms {
+    Scene s;
+    TextureId ms, other;
+    Ms() {
+      TextureDesc d;
+      d.format = Format::RGBA8Unorm;
+      d.width = d.height = 64;
+      d.samples = 4;
+      d.usage = usage::colorTarget;
+      ms = s.res.createTexture(d);
+      other = s.rt(64);
+    }
+    // Frame of one pass on `ms` (Store), optionally followed by a pass that reads it back.
+    static CompileOptions on() {
+      CompileOptions o;
+      o.msaaDeadStore = true;  // opt-in
+      return o;
+    }
+    CompiledFrame run(LoadAction first, int readBack = 0, const CompileOptions& o = on()) {
+      Frame f;
+      RenderPassDesc w = Scene::pass(ms, {}, first);
+      w.colors[0].store = StoreAction::Store;
+      Scene::passWithDraw(f, w);
+      if (readBack == 1) Scene::passWithDraw(f, Scene::pass(other, {}, LoadAction::Clear), {Scene::sample(ms)});
+      if (readBack == 2) {  // a Load of it in an encoder of its own
+        Scene::passWithDraw(f, Scene::pass(other, {}, LoadAction::Clear));
+        RenderPassDesc r = Scene::pass(ms);
+        r.colors[0].store = StoreAction::DontCare;
+        Scene::passWithDraw(f, r, {Scene::sample(other)});
+      }
+      CompiledFrame cf = compileFrame(f, &s.res, o);
+      commitMemory(cf, s.res);
+      return cf;
+    }
+  };
+  {  // (a) Clear every frame: 3 dead stores seen, then the store is elided and the attachment stays on tile
+    Ms t;
+    for (int n = 0; n < 4; ++n) {
+      const CompiledFrame cf = t.run(LoadAction::Clear);
+      CHECK(cf.encoders[0].tile[0] == TileVerdict::None && cf.encoders[0].pass.colors[0].store == StoreAction::Store);
+      CHECK_EQ(cf.stats.storesElided, 0u);
+      CHECK(t.s.res.memValid(t.ms));
+    }
+    for (int n = 0; n < 3; ++n) {
+      const CompiledFrame cf = t.run(LoadAction::Clear);
+      CHECK(cf.encoders[0].tileLocal(0) && cf.encoders[0].pass.colors[0].store == StoreAction::DontCare);
+      CHECK_EQ(cf.stats.storesElided, 1u);
+      CHECK_EQ(cf.stats.elideMiss, 0u);
+      CHECK(!t.s.res.memValid(t.ms));
+    }
+  }
+  {  // (a') a DontCare first load counts as dead too; a non-MSAA texture is never touched
+    Ms t;
+    for (int n = 0; n < 4; ++n) t.run(LoadAction::DontCare);
+    CHECK(t.run(LoadAction::DontCare).encoders[0].tileLocal(0));
+    RenderPassDesc w = Scene::pass(t.other, {}, LoadAction::Clear);
+    for (int n = 0; n < 6; ++n) {
+      Frame g;
+      Scene::passWithDraw(g, w);
+      const CompiledFrame cf = compileFrame(g, &t.s.res);
+      CHECK(cf.encoders[0].tile[0] == TileVerdict::None && cf.stats.storesElided == 0u && cf.storeObs.empty());
+      commitMemory(cf, t.s.res);
+    }
+  }
+  {  // (b) something later in the frame reads it (sample, or a Load in another encoder): never elided
+    for (int mode = 1; mode <= 2; ++mode) {
+      Ms t;
+      for (int n = 0; n < 10; ++n) {
+        const CompiledFrame cf = t.run(LoadAction::Clear, mode);
+        CHECK(cf.encoders[0].tile[0] != TileVerdict::TileLocal);
+        CHECK_EQ(cf.stats.storesElided, 0u);
+        CHECK(cf.encoders[0].pass.colors[0].store == StoreAction::Store);
+        if (mode == 2) CHECK(cf.encoders.size() > 1);
+      }
+    }
+  }
+  {  // (c) after the elision a frame Loads it: the miss is counted once, the texture is banned from then on
+    Ms t;
+    for (int n = 0; n < 7; ++n) t.run(LoadAction::Clear);
+    CompiledFrame cf = t.run(LoadAction::Load);
+    CHECK_EQ(cf.stats.elideMiss, 1u);
+    CHECK(cf.elideMisses.size() == 1 && cf.elideMisses[0] == t.ms);
+    CHECK_EQ(cf.stats.storesElided, 0u);  // this frame stores for real
+    CHECK(cf.encoders[0].pass.colors[0].store == StoreAction::Store);
+    CHECK(t.s.res.storeHistory(t.ms).banned);
+    for (int n = 0; n < 10; ++n) {
+      cf = t.run(LoadAction::Clear);
+      CHECK(cf.encoders[0].tile[0] == TileVerdict::None && cf.stats.storesElided == 0u && cf.stats.elideMiss == 0u);
+    }
+  }
+  {  // (c') a Load while the store was not yet elided is not a miss: it only restarts the count
+    Ms t;
+    for (int n = 0; n < 3; ++n) t.run(LoadAction::Clear);
+    CHECK_EQ(t.run(LoadAction::Load).stats.elideMiss, 0u);
+    CHECK(!t.s.res.storeHistory(t.ms).banned && t.s.res.storeHistory(t.ms).dead == 0);
+    for (int n = 0; n < 4; ++n) CHECK_EQ(t.run(LoadAction::Clear).stats.storesElided, 0u);
+    CHECK_EQ(t.run(LoadAction::Clear).stats.storesElided, 1u);
+  }
+  {  // (d) feature off (the default): never elided
+    Ms t;
+    const CompileOptions off;
+    CHECK(!off.msaaDeadStore);
+    for (int n = 0; n < 10; ++n) {
+      const CompiledFrame cf = t.run(LoadAction::Clear, 0, off);
+      CHECK(cf.encoders[0].tile[0] == TileVerdict::None && cf.stats.storesElided == 0u && cf.storeObs.empty());
+    }
+  }
+  {  // (d') Device: off unless VPVK_MSAA_DEAD_STORE=1, and the miss reaches the log once
+    for (int envOn = 0; envOn < 2; ++envOn) {
+      if (envOn) setenv("VPVK_MSAA_DEAD_STORE", "1", 1);
+      std::vector<std::string> log;
+      NullBackend be;
+      Device dev(be, 0, [&](const std::string& l) { log.push_back(l); });
+      unsetenv("VPVK_MSAA_DEAD_STORE");
+      TextureDesc d;
+      d.format = Format::RGBA8Unorm;
+      d.width = d.height = 64;
+      d.samples = 4;
+      d.usage = usage::colorTarget;
+      const TextureId ms = dev.createTexture(d);
+      auto frame = [&](LoadAction load) {
+        Frame f;
+        RenderPassDesc w = Scene::pass(ms, {}, load);
+        w.colors[0].store = StoreAction::Store;
+        Scene::passWithDraw(f, w);
+        return dev.submit(f);
+      };
+      uint32_t elided = 0, misses = 0;
+      for (int n = 0; n < 8; ++n) elided += frame(LoadAction::Clear).compile.storesElided;
+      misses += frame(LoadAction::Load).compile.elideMiss;
+      for (int n = 0; n < 4; ++n) misses += frame(LoadAction::Clear).compile.elideMiss;
+      size_t logged = 0;
+      for (const std::string& l : log) logged += l.starts_with("gpu.msaa elide_miss");
+      CHECK_EQ(elided, envOn ? 4u : 0u);
