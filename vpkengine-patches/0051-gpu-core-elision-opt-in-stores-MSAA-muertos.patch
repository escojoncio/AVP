diff --git a/gpu/core/include/vpgpu/core/frame_compiler.h b/gpu/core/include/vpgpu/core/frame_compiler.h
index 85eab12..d9305db 100644
--- a/gpu/core/include/vpgpu/core/frame_compiler.h
+++ b/gpu/core/include/vpgpu/core/frame_compiler.h
@@ -148,6 +148,8 @@ struct CompileStats {
   uint32_t copiesGathered = 0, gatherFlushes = 0;
   uint32_t heavyResolve = 0;   // StoreAndResolve MSAA attachments of HeavyGeometry encoders reduced to Resolve with real memory
   uint32_t loadsDropped = 0;   // Loads of undefined memory (ResourceTable::memValid) turned into DontCare so the texture stays tile-local
+  uint32_t storesElided = 0;   // client Stores of MSAA attachments dropped as dead (CompileOptions::msaaDeadStore)
+  uint32_t elideMiss = 0;      // frames' first access needed contents whose store had been elided (the texture is banned from it)
 };
 
 // A draw by position: Frame::commands()[command] is a RenderPass, draws[draw] the draw.
@@ -172,8 +174,18 @@ struct MsaaReject {
   LoadAction load = LoadAction::DontCare;
 };
 
+// What one frame showed about an MSAA texture it touched, for ResourceTable::StoreHistory (applied by commitMemory).
+struct StoreObs {
+  TextureId texture;
+  bool readFirst = false;   // the frame's first access needs the contents from before it (Load, sample, copy source, partial)
+  bool candidate = false;   // the client Stores it and nothing else in the frame uses it: the store could be dropped
+  bool elided = false;      // ... and it was
+};
+
 struct CompiledFrame {
   std::vector<Encoder> encoders;
+  std::vector<StoreObs> storeObs;  // MSAA textures touched (only with CompileOptions::msaaDeadStore and a resource table)
+  std::vector<TextureId> elideMisses;  // textures whose elided contents were needed this frame (Device logs them once)
   std::vector<Barrier> barriers;  // sorted by (encoder, item)
   std::vector<MsaaReject> msaaRejects;  // MSAA attachments the resolve-on-tile option could not keep on tile
   // Draws the backend must not execute: a pixel-local read that no colour attachment of their
@@ -226,6 +238,13 @@ struct CompileOptions {
   // and then they all run in one compute encoder (or join the compute encoder that is last). Copies recorded while
   // no render encoder is open join the waiting ones. Needs nothing from the resource table.
   bool gatherCopies = false;
+  // A client Store of an MSAA attachment that nothing in the frame reads afterwards is dropped (DontCare / Resolve, so the
+  // texture can stay on tile) once ResourceTable::StoreHistory shows 3 consecutive frames whose next first access did not need
+  // those contents. A frame that then needs them (miss) bans the texture from it. OFF by default and opt-in (Device:
+  // VPVK_MSAA_DEAD_STORE=1). Speculative: "nothing read it for 3 frames" does not prove the next frame will not, so a miss
+  // costs one frame of undefined samples before the per-texture ban. The proper long-term fix is an explicit keepSamples /
+  // real-storeOp hint from the Vulkan translator.
+  bool msaaDeadStore = false;
 };
 
 class ResourceTable;
diff --git a/gpu/core/include/vpgpu/core/resources.h b/gpu/core/include/vpgpu/core/resources.h
index 7c7d163..60fa85a 100644
--- a/gpu/core/include/vpgpu/core/resources.h
+++ b/gpu/core/include/vpgpu/core/resources.h
@@ -4,6 +4,7 @@
 #include <cstdint>
 #include <optional>
 #include <string>
+#include <unordered_map>
 #include <unordered_set>
 #include <vector>
 
@@ -177,6 +178,7 @@ class ResourceTable {
   bool destroy(BufferId id) { return buffers_.destroy(id); }
   bool destroy(TextureId id) {
     memValid_.erase(uint64_t{id.generation} << 32 | id.index);
+    storeHistory_.erase(uint64_t{id.generation} << 32 | id.index);
     return textures_.destroy(id);
   }
   bool destroy(SamplerId id) { return samplers_.destroy(id); }
@@ -195,8 +197,25 @@ class ResourceTable {
     else memValid_.erase(k);
   }
 
+  // Dead-store history of an MSAA attachment the client Stores (CompileOptions::msaaDeadStore): `pending` = the last frame
+  // that touched it stored samples nothing in that frame read; `dead` = consecutive such stores whose next frame did not
+  // need the contents; `elided` = that last store was dropped; `banned` = a frame needed contents that were elided.
+  // placeTiles reads it, commitMemory updates it.
+  struct StoreHistory {
+    uint8_t dead = 0;
+    bool pending = false, elided = false, banned = false;
+  };
+  StoreHistory storeHistory(TextureId id) const {
+    const auto it = storeHistory_.find(uint64_t{id.generation} << 32 | id.index);
+    return it == storeHistory_.end() ? StoreHistory{} : it->second;
+  }
+  void setStoreHistory(TextureId id, StoreHistory h) {
+    if (get(id)) storeHistory_[uint64_t{id.generation} << 32 | id.index] = h;
+  }
+
  private:
   std::unordered_set<uint64_t> memValid_;
+  std::unordered_map<uint64_t, StoreHistory> storeHistory_;
   Pool<BufferDesc, BufferId> buffers_;
   Pool<TextureDesc, TextureId> textures_;
   Pool<SamplerDesc, SamplerId> samplers_;
