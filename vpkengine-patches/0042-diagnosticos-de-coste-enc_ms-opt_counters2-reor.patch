+// Any overlap with a write on one side, attachments included (conflicts() leaves out attachment-vs-attachment:
+// inside one encoder the rasterizer orders them; between encoders, or against work not yet in one, they are
+// ordered by program order only).
+bool touches(const AccessList& a, const AccessIndex& b) {
+  for (const Tagged& x : a) {
+    const auto& map = x.access.write ? b.byResource : b.writesByResource;
+    auto it = map.find(resourceKey(x.access.range));
+    if (it == map.end()) continue;
+    for (uint32_t i : it->second)
+      if (x.access.range.overlaps(b.list[i].access.range)) return true;
+  }
+  return false;
+}
