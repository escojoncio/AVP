+  // CompileStats::reorderable. Walks back from the newest encoder: the pass can only move up past encoders it
+  // does not touch (and past the copies sunk after the open encoder).
+  void countReorderable(const RenderPassDesc& desc, const RenderPassDesc& need, const AccessList& acc) {
+    if (!options_.countReorderable) return;
+    if (touches(acc, sunkAcc_)) return;
+    int renders = 0;
+    for (int e = static_cast<int>(out_.encoders.size()) - 1; e >= 0 && renders < 8; --e) {
+      const Encoder& en = out_.encoders[e];
+      if (en.kind == Encoder::Kind::Render) {
+        ++renders;
+        if (en.pass.sameTargets(need)) {
+          if (!clearsExisting(en.pass, desc) && !conflicts(acc, acc_[e])) ++out_.stats.reorderable;
+          return;
+        }
+      }
+      if (touches(acc, acc_[e])) return;
+    }
+  }
