     std::lock_guard lock(logMutex);
     log(line);
   }
+  // Metal refused to create an object (nil), usually under jetsam memory pressure. Counted per kind:
+  // the first one is logged in full and then every power-of-two count, each with n= and the process
+  // memory (memNote), so a storm of refusals neither floods the log nor goes unseen. Failure paths only.
+  enum Fail : uint8_t { kFailTexture, kFailBuffer, kFailMemoryless, kFailView, kFailCommandBuffer, kFailRing, kFailKinds };
+  std::atomic<uint32_t> failCount[kFailKinds] = {};
+  bool failDue(Fail k, uint32_t& n) {
+    n = failCount[k].fetch_add(1, std::memory_order_relaxed) + 1;
+    return (n & (n - 1)) == 0;
+  }
+  // " footprint_mb=.. avail_mb=.." (avail 0 = unknown: not visionOS/iOS).
+  static std::string memNote() {
+    uint64_t avail = 0;
+#if TARGET_OS_IPHONE
+    avail = uint64_t(os_proc_available_memory());
+#endif
+    char b[80];
+    std::snprintf(b, sizeof b, " footprint_mb=%llu avail_mb=%llu", (unsigned long long)(MetalBackend::footprint() >> 20),
+                  (unsigned long long)(avail >> 20));
+    return b;
+  }
 
   void init();
   void calibrate();
