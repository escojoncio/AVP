+  // True when Metal refused the resource behind a live id (nil MTLBuffer / failed MTLTexture, gpu.err
+  // logged), or the id is unknown or stale. A render target whose memory is deferred to first use
+  // reads false until that use fails. Thread-safe; for VPVulkan's vkBind*Memory result.
+  bool allocationFailed(BufferId) const;
+  bool allocationFailed(TextureId) const;
   // Writes the pipeline binary archive under cacheRoot; false (and a gpu.err line) on failure.
