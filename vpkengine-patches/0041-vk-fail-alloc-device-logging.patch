+      impl_->err("what=pipeline key=%016llx label=%s error=%s%s", (unsigned long long)s.key().value,
+                 token(s.label).c_str(), token(error).c_str(), Impl::memNote().c_str());
       return false;
     }
     {
@@ -4353,6 +4393,20 @@ void MetalBackend::destroyView(TextureId t) {
 void* MetalBackend::nativeDevice() const { return (__bridge void*)impl_->device; }
 void* MetalBackend::nativeQueue() const { return (__bridge void*)impl_->queue; }
 
+bool MetalBackend::allocationFailed(BufferId handle) const {
+  if (!ok()) return true;
+  std::lock_guard<std::recursive_mutex> tables(impl_->tableMutex);
+  auto it = impl_->buffers.find(handle.index);
+  return it == impl_->buffers.end() || it->second.generation != handle.generation || !it->second.buffer;
+}
+
+bool MetalBackend::allocationFailed(TextureId handle) const {
+  if (!ok()) return true;
+  std::lock_guard<std::recursive_mutex> tables(impl_->tableMutex);
+  auto it = impl_->textures.find(handle.index);
+  return it == impl_->textures.end() || it->second.generation != handle.generation || it->second.failed;
+}
+
 void* MetalBackend::nativeTexture(TextureId handle) {
   std::lock_guard<std::recursive_mutex> tables(impl_->tableMutex);
   return (__bridge void*)impl_->texture(handle);
diff --git a/gpu/vulkan/include/vpvk/platform.h b/gpu/vulkan/include/vpvk/platform.h
index 999e12a..048be1c 100644
--- a/gpu/vulkan/include/vpvk/platform.h
+++ b/gpu/vulkan/include/vpvk/platform.h
@@ -74,6 +74,11 @@ class Platform {
   virtual ArchiveStats archiveStats() { return {}; }
   // Process footprint in bytes (visionOS: phys_footprint, what jetsam counts), 0 = unknown.
   virtual uint64_t footprint() { return 0; }
+  // The backend refused the native object behind a live id (Metal returned nil, logged as gpu.err):
+  // vkBind*Memory then fails with VK_ERROR_OUT_OF_DEVICE_MEMORY instead of handing out a resource
+  // with no storage. A render target allocated lazily on first use reads false until that use.
+  virtual bool allocationFailed(vpgpu::BufferId) { return false; }
+  virtual bool allocationFailed(vpgpu::TextureId) { return false; }
 };
 
