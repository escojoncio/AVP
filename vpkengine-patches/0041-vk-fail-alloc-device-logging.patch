-          d.guestMemory != nullptr, token(d.label).c_str());
+    uint32_t k;
+    if (m.failDue(Impl::kFailBuffer, k))
+      m.err("what=buffer index=%u size=%llu guest=%d label=%s n=%u%s", handle.index, (unsigned long long)d.size,
+            d.guestMemory != nullptr, token(d.label).c_str(), k, Impl::memNote().c_str());
     return;
