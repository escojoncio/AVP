diff --git a/gpu/vulkan/CMakeLists.txt b/gpu/vulkan/CMakeLists.txt
index 46907d7..eea010a 100644
--- a/gpu/vulkan/CMakeLists.txt
+++ b/gpu/vulkan/CMakeLists.txt
@@ -37,6 +37,9 @@ if(BUILD_TESTING OR NOT DEFINED BUILD_TESTING)
     foreach(t exports physical memory passes submit pipeline recipes alyx depth_resolve resolve_1x suspend_resume local_read sync host_image_copy motion)
       add_test(NAME gpu_vulkan.${t} COMMAND vpvk_tests ${t} $<TARGET_FILE:VPVulkan>)
     endforeach()
+    # msaaTileOn() reads VPVK_MSAA_TILE once per process: its own run with it off.
+    add_test(NAME gpu_vulkan.msaa_tile_off COMMAND vpvk_tests msaa_tile_off $<TARGET_FILE:VPVulkan>)
+    set_tests_properties(gpu_vulkan.msaa_tile_off PROPERTIES ENVIRONMENT "VPVK_MSAA_TILE=0")
     # The same multiview pipeline with the vertex-amplification translator mode.
     add_test(NAME gpu_vulkan.pipeline_amplify COMMAND vpvk_tests pipeline $<TARGET_FILE:VPVulkan>)
     set_tests_properties(gpu_vulkan.pipeline_amplify PROPERTIES ENVIRONMENT "VPVK_AMPLIFY=1")
diff --git a/gpu/vulkan/include/vpvk/platform.h b/gpu/vulkan/include/vpvk/platform.h
index 048be1c..d537e36 100644
--- a/gpu/vulkan/include/vpvk/platform.h
+++ b/gpu/vulkan/include/vpvk/platform.h
@@ -74,6 +74,8 @@ class Platform {
   virtual ArchiveStats archiveStats() { return {}; }
   // Process footprint in bytes (visionOS: phys_footprint, what jetsam counts), 0 = unknown.
   virtual uint64_t footprint() { return 0; }
+  // "key=value ..." texture memory by owner (logged with gpu.mem as gpu.mem_tex); empty where there is none.
+  virtual std::string memStats() { return {}; }
   // The backend refused the native object behind a live id (Metal returned nil, logged as gpu.err):
   // vkBind*Memory then fails with VK_ERROR_OUT_OF_DEVICE_MEMORY instead of handing out a resource
   // with no storage. A render target allocated lazily on first use reads false until that use.
diff --git a/gpu/vulkan/src/config.cpp b/gpu/vulkan/src/config.cpp
index 7de645b..a98b2dd 100644
--- a/gpu/vulkan/src/config.cpp
+++ b/gpu/vulkan/src/config.cpp
@@ -55,6 +55,13 @@ bool vpktaaEnabled() {
   std::lock_guard<std::mutex> l(gMutex);
   return gCfg.vpktaa.enabled != 0;
 }
+bool msaaTileOn() {
+  static const bool on = [] {
+    const char* e = getenv("VPVK_MSAA_TILE");
+    return !(e && e[0] == '0' && !e[1]);
+  }();
+  return on;
+}
 bool forceSingleSample() {
   if (const char* e = getenv("VPVK_FORCE_1X"); e && (*e == '0' || *e == '1')) return *e == '1';
   const int f = gForce1x.load();
diff --git a/gpu/vulkan/src/entry.cpp b/gpu/vulkan/src/entry.cpp
index f683671..425ed04 100644
--- a/gpu/vulkan/src/entry.cpp
+++ b/gpu/vulkan/src/entry.cpp
@@ -628,7 +628,16 @@ VPVK_EXPORT VKAPI_ATTR VkResult VKAPI_CALL vkAllocateMemory(VkDevice dv, const V
   auto* m = new DeviceMemory;
   m->size = ai->allocationSize;
   m->typeIndex = ai->memoryTypeIndex;
-  // Page-aligned host memory for every type: GPU buffers alias it in place (no staging).
+  // Lazily-allocated memory (transient attachments only, vkGetImageMemoryRequirements): like the
+  // Adreno's on-chip GMEM it takes no RAM. The texture bound to it lives in memoryless tile
+  // storage (frame compiler TileLocal) or, when it must be loaded/stored, gets its own Metal memory.
+  m->lazy = (memoryProperties().memoryTypes[m->typeIndex].propertyFlags & VK_MEMORY_PROPERTY_LAZILY_ALLOCATED_BIT) != 0;
+  if (m->lazy) {
+    allocatedBytes() += m->size;
+    *out = to<VkDeviceMemory>(m);
+    return VK_SUCCESS;
+  }
+  // Page-aligned host memory for every other type: GPU buffers alias it in place (no staging).
   m->host = static_cast<uint8_t*>(std::aligned_alloc(kPage, alignUp(std::max<uint64_t>(m->size, 1), kPage)));
   if (!m->host) {
     delete m;
@@ -676,7 +685,8 @@ VPVK_EXPORT VKAPI_ATTR VkResult VKAPI_CALL vkInvalidateMappedMemoryRanges(VkDevi
 }
 VPVK_EXPORT VKAPI_ATTR void VKAPI_CALL vkGetDeviceMemoryCommitment(VkDevice, VkDeviceMemory m,
                                                                    VkDeviceSize* out) {
-  *out = from<DeviceMemory>(m)->size;
+  const DeviceMemory* dm = from<DeviceMemory>(m);
+  *out = dm->lazy ? 0 : dm->size;  // lazily-allocated: no RAM committed (tile memory)
 }
 
 // ---------------------------------------------------------------------------------------------
@@ -720,6 +730,7 @@ VPVK_EXPORT VKAPI_ATTR VkResult VKAPI_CALL vkBindBufferMemory(VkDevice dv, VkBuf
                                                               VkDeviceMemory mem, VkDeviceSize off) {
   Buffer* b = from<Buffer>(buf);
   DeviceMemory* m = from<DeviceMemory>(mem);
+  if (!m || !m->host) return VK_ERROR_OUT_OF_DEVICE_MEMORY;  // lazily-allocated memory holds no buffers
   b->memory = m;
   b->offset = off;
   vpgpu::BufferDesc d;
@@ -783,6 +794,27 @@ VPVK_EXPORT VKAPI_ATTR VkResult VKAPI_CALL vkCreateImage(VkDevice, const VkImage
       logf("vk.msaa forced 1x (was %ux) image=%ux%u format=%d", forcedFrom, ci->extent.width, ci->extent.height,
            ci->format);
   }
+  // Every ATTACHMENT (colour or depth/stencil, any sample count, whatever else its usage says) is memoryless first, as
+  // on the Adreno's GMEM: not persistent, so the backend gives it no memory until a frame cannot keep it on tile (a
+  // load, a sample, a copy, a stored contents: msaa_materialized names the frame compiler's verdict) and takes that
+  // memory back after VPVK_MSAA_RELEASE_FRAMES tile-local frames (msaa_released). A client that keeps the MTLTexture
+  // (nativeTexture: vkExportMetalObjectsEXT, motion vectors) pins it in memory. Contents stay correct across frames: a
+  // tile-local frame neither loads nor stores them (Vulkan leaves them undefined there), and a frame that stores them
+  // materialises the memory first. A "Too much geometry for memoryless" tiler flush bans the memoryless stand-in for
+  // the textures of that command buffer only (backend tileBanned), not for the whole process.
+  // Storage writes may go through view ids the frame compiler does not track as writes of this texture
+  // (ResourceTable::memValid), so such images keep their memory. VPVK_MSAA_TILE=0 restores fully resident attachments.
+  const bool attachment =
+      (ci->usage & (VK_IMAGE_USAGE_COLOR_ATTACHMENT_BIT | VK_IMAGE_USAGE_DEPTH_STENCIL_ATTACHMENT_BIT)) != 0;
+  if (attachment && desc.persistent && msaaTileOn() && ci->tiling == VK_IMAGE_TILING_OPTIMAL &&
+      !(desc.usage & vpgpu::usage::storage)) {
+    desc.persistent = false;
+    static std::atomic<unsigned> k{0};
+    if (k.fetch_add(1) < 64)
+      logf("vk.msaa_tile memoryless image=%ux%ux%u samples=%u format=%d usage=%#x (%.1f MiB if resident)",
+           ci->extent.width, ci->extent.height, ci->arrayLayers, unsigned(desc.samples), ci->format,
+           unsigned(ci->usage), double(imageBytes(desc)) / 1048576.0);
+  }
   if (desc.format == vpgpu::Format::Undefined || !vpgpu::validate(desc)) {
     logf("vk.err what=image_desc format=%d %ux%ux%u mips=%u layers=%u", ci->format, ci->extent.width,
          ci->extent.height, ci->extent.depth, ci->mipLevels, ci->arrayLayers);
@@ -1505,6 +1537,9 @@ void logDeviceMemory(Device& d, const char* when, uint64_t frame) {
        (unsigned long long)(as.bytesLoaded >> 20), (long long)(as.memDelta / (1 << 20)), d.prewarmedRecipes,
        d.recipeMode, (unsigned long long)(recipeFile >> 20), recipeSrc >> 20, (unsigned long long)(foot >> 20),
        (unsigned long long)(avail >> 20));
+  // Texture memory by owner (memoryless counters, ledger): the backend's line, when it keeps one.
+  const std::string ms = d.platform->memStats();
+  if (!ms.empty()) logf("gpu.mem_tex when=%s f=%llu %s", when, (unsigned long long)frame, ms.c_str());
 }
 
 // After each submitted frame (sync.cpp): gpu.mem every kMemLogFrames frames. Cheap when not due.
diff --git a/gpu/vulkan/src/platform_metal.mm b/gpu/vulkan/src/platform_metal.mm
index bb7bae1..b9c39a4 100644
--- a/gpu/vulkan/src/platform_metal.mm
+++ b/gpu/vulkan/src/platform_metal.mm
@@ -32,6 +32,18 @@ class MetalPlatform final : public Platform {
   void waitIdle() override { backend_.waitIdle(); }
   uint64_t availableMemory() override { return os_proc_available_memory(); }
   uint64_t footprint() override { return vpgpu::metal2::MetalBackend::footprint(); }
+  // Texture memory by owner: live MTLTexture bytes by kind, msaa_memoryless (render targets with no memory now: bytes
+  // they would take), then " ledger: " (metal_backend.mm memLedger).
+  std::string memStats() override {
+    const auto s = backend_.memStats();
+    char b[512];
+    std::snprintf(b, sizeof b, "tex_astc=%llu tex_color=%llu tex_depth=%llu tex_msaa=%llu msaa_memoryless=%llu tile_rejected=%llu",
+                  (unsigned long long)s.texAstc, (unsigned long long)s.texColor, (unsigned long long)s.texDepth,
+                  (unsigned long long)s.texMsaa, (unsigned long long)s.msaaMemoryless, (unsigned long long)s.tileRejected);
+    std::string out = b;
+    if (!s.ledger.empty()) out += " ledger: " + s.ledger;
+    return out;
+  }
   bool allocationFailed(vpgpu::BufferId id) override { return backend_.allocationFailed(id); }
   bool allocationFailed(vpgpu::TextureId id) override { return backend_.allocationFailed(id); }
   ArchiveStats archiveStats() override {
diff --git a/gpu/vulkan/src/vpvk.h b/gpu/vulkan/src/vpvk.h
index 4739463..917c704 100644
--- a/gpu/vulkan/src/vpvk.h
+++ b/gpu/vulkan/src/vpvk.h
@@ -31,6 +31,11 @@ void logConfig();  // config.cpp: "vk.cfg effective ..." (called from vkCreateDe
 void logf(const char* fmt, ...) __attribute__((format(printf, 1, 2)));
 bool prewarmEnabled();  // config.cpp: vpvk_config_set_prewarm
 bool forceSingleSample();  // config.cpp: vpvk_config_set_force_single_sample
+// Todo attachment del juego (color o profundidad, cualquier número de muestras, con cualquier otro uso): no persistente,
+// memoryless mientras el compilador de frames pueda dejarlo en tile; memoria solo en los frames que la necesitan
+// (msaa_materialized) y devuelta tras VPVK_MSAA_RELEASE_FRAMES frames en tile (msaa_released). VPVK_MSAA_TILE=0 lo
+// apaga (por defecto 1).
+bool msaaTileOn();
 bool vpktaaEnabled();      // config.cpp: vpvk_config_set_vpktaa
 struct Device;
 // entry.cpp: "gpu.mem ..." (pipelines held, archives, recipes, footprint) at device creation and
@@ -81,6 +86,7 @@ struct DeviceMemory {
   uint32_t typeIndex = 0;
   uint8_t* host = nullptr;  // page-aligned; unified memory: GPU buffers alias it in place
   bool mapped = false;
+  bool lazy = false;  // VK_MEMORY_PROPERTY_LAZILY_ALLOCATED_BIT type: no host memory (host stays null)
   // Some GPU command (copy, fill, update, storage write) wrote a buffer bound here: indirect
   // arguments read from it must be read by the GPU, not at submit (commands.cpp). Submit thread.
   bool gpuWritten = false;
diff --git a/gpu/vulkan/tests/vk_tests.cpp b/gpu/vulkan/tests/vk_tests.cpp
index 4d5c933..5544ed3 100644
--- a/gpu/vulkan/tests/vk_tests.cpp
+++ b/gpu/vulkan/tests/vk_tests.cpp
@@ -219,6 +219,11 @@ VkImage image(Ctx& c, VkFormat f, uint32_t w, uint32_t layers, VkImageUsageFlags
 }
 
 void testMemory() {
+  // An earlier group may leave force-1x on (vpktaa enabled): the MSAA block below wants real multisampled images, so
+  // the env switch (wins over the config API) is off for this group and put back at its end.
+  const char* oldForce = getenv("VPVK_FORCE_1X");
+  const std::string savedForce = oldForce ? oldForce : "";
+  setenv("VPVK_FORCE_1X", "0", 1);
   Ctx c;
   const auto& mp = memoryProperties();
   CHECK(mp.memoryHeapCount == 1);
@@ -246,6 +251,65 @@ void testMemory() {
   CHECK(r.memoryTypeBits & 8);
   CHECK(r.size >= 64 * 64 * 4);
   CHECK(from<Image>(t)->desc.transient && !from<Image>(t)->desc.persistent);
+  {
+    // Every attachment (colour or depth, any sample count, whatever else its usage says) starts memoryless: not
+    // persistent, so it may stay on tile and only gets memory for frames that need it.
+    auto make = [&](VkFormat f, VkImageUsageFlags u, VkSampleCountFlagBits n) {
+      VkImageCreateInfo ii{VK_STRUCTURE_TYPE_IMAGE_CREATE_INFO};
+      ii.imageType = VK_IMAGE_TYPE_2D, ii.format = f, ii.extent = {64, 64, 1}, ii.mipLevels = 1, ii.arrayLayers = 1;
+      ii.samples = n, ii.tiling = VK_IMAGE_TILING_OPTIMAL, ii.usage = u;
+      VkImage i = VK_NULL_HANDLE;
+      return vkCreateImage(c.dev, &ii, nullptr, &i) == VK_SUCCESS ? i : VK_NULL_HANDLE;
+    };
+    const VkImageUsageFlags colorUse = VK_IMAGE_USAGE_COLOR_ATTACHMENT_BIT, depthUse = VK_IMAGE_USAGE_DEPTH_STENCIL_ATTACHMENT_BIT;
+    VkImage ma = make(VK_FORMAT_R8G8B8A8_UNORM, colorUse, VK_SAMPLE_COUNT_4_BIT);
+    VkImage ms = make(VK_FORMAT_R8G8B8A8_UNORM, colorUse | VK_IMAGE_USAGE_SAMPLED_BIT, VK_SAMPLE_COUNT_4_BIT);
+    VkImage mi = make(VK_FORMAT_R8G8B8A8_UNORM, colorUse | VK_IMAGE_USAGE_INPUT_ATTACHMENT_BIT | VK_IMAGE_USAGE_TRANSFER_SRC_BIT,
+                      VK_SAMPLE_COUNT_4_BIT);
+    VkImage md = make(VK_FORMAT_D32_SFLOAT, depthUse, VK_SAMPLE_COUNT_4_BIT);
+    VkImage mds = make(VK_FORMAT_D24_UNORM_S8_UINT, depthUse | VK_IMAGE_USAGE_SAMPLED_BIT, VK_SAMPLE_COUNT_4_BIT);
+    VkImage mtc = make(VK_FORMAT_R8G8B8A8_UNORM, colorUse | VK_IMAGE_USAGE_TRANSIENT_ATTACHMENT_BIT, VK_SAMPLE_COUNT_4_BIT);
+    VkImage mt = make(VK_FORMAT_R8G8B8A8_UNORM, VK_IMAGE_USAGE_SAMPLED_BIT | VK_IMAGE_USAGE_TRANSFER_DST_BIT, VK_SAMPLE_COUNT_4_BIT);
+    VkImage d1 = make(VK_FORMAT_D32_SFLOAT, depthUse, VK_SAMPLE_COUNT_1_BIT);
+    VkImage c1 = make(VK_FORMAT_R8G8B8A8_UNORM, colorUse | VK_IMAGE_USAGE_SAMPLED_BIT, VK_SAMPLE_COUNT_1_BIT);
+    VkImage c1s = make(VK_FORMAT_R8G8B8A8_UNORM, colorUse | VK_IMAGE_USAGE_STORAGE_BIT, VK_SAMPLE_COUNT_1_BIT);
+    CHECK(ma && ms && mi && md && mds && mtc && mt && d1 && c1 && c1s);
+    auto deferred = [&](VkImage i) { return !from<Image>(i)->desc.persistent && !from<Image>(i)->desc.transient; };
+    const bool msaaReal = from<Image>(ma)->desc.samples > 1;  // false when an earlier group left force-1x on
+    CHECK(deferred(ma) && deferred(ms) && deferred(mi) && deferred(md) && deferred(mds));
+    CHECK(msaaReal);
+    // The TRANSIENT path is untouched: transient, not persistent.
+    CHECK(from<Image>(mtc)->desc.transient && !from<Image>(mtc)->desc.persistent);
+    // Not an attachment at all (sampled only): nothing to keep on tile, it stays persistent.
+    CHECK(from<Image>(mt)->desc.persistent);
+    // 1x attachments are memoryless too; with STORAGE usage the image keeps its memory.
+    CHECK(deferred(d1) && deferred(c1));
+    CHECK(from<Image>(c1s)->desc.persistent && !from<Image>(c1s)->desc.transient);
+    for (VkImage i : {ma, ms, mi, md, mds, mtc, mt, d1, c1, c1s}) vkDestroyImage(c.dev, i, nullptr);
+  }
+  {
+    // Lazily-allocated memory (type 3, like the Adreno's GMEM): no host RAM, nothing committed, no
+    // buffers; a transient image binds to it and gets a (tile-deferred) texture.
+    VkDeviceMemory lazy = alloc(c, 64 << 20, 3);
+    CHECK(lazy && !from<DeviceMemory>(lazy)->host && from<DeviceMemory>(lazy)->lazy);
+    VkDeviceSize committed = 1;
+    vkGetDeviceMemoryCommitment(c.dev, lazy, &committed);
+    CHECK(committed == 0);
+    VkImage li = image(c, VK_FORMAT_R8G8B8A8_UNORM, 64, 1,
+                       VK_IMAGE_USAGE_COLOR_ATTACHMENT_BIT | VK_IMAGE_USAGE_TRANSIENT_ATTACHMENT_BIT, lazy);
+    CHECK(li && from<Image>(li)->id);
+    VkBufferCreateInfo bi{VK_STRUCTURE_TYPE_BUFFER_CREATE_INFO};
+    bi.size = 256;
+    bi.usage = VK_BUFFER_USAGE_TRANSFER_SRC_BIT;
+    VkBuffer lb = VK_NULL_HANDLE;
+    vkCreateBuffer(c.dev, &bi, nullptr, &lb);
+    CHECK(vkBindBufferMemory(c.dev, lb, lazy, 0) != VK_SUCCESS);
+    void* p = nullptr;
+    CHECK(vkMapMemory(c.dev, lazy, 0, VK_WHOLE_SIZE, 0, &p) == VK_ERROR_MEMORY_MAP_FAILED);
+    vkDestroyBuffer(c.dev, lb, nullptr);
+    vkDestroyImage(c.dev, li, nullptr);
+    vkFreeMemory(c.dev, lazy, nullptr);
+  }
   CHECK(image(c, VK_FORMAT_ASTC_5x4_UNORM_BLOCK, 64, 1, VK_IMAGE_USAGE_SAMPLED_BIT, 0) == VK_NULL_HANDLE);
   {
     VkImage e = image(c, VK_FORMAT_ETC2_R8G8B8_UNORM_BLOCK, 64, 1, VK_IMAGE_USAGE_SAMPLED_BIT, 0);
@@ -258,6 +322,31 @@ void testMemory() {
   vkDestroyBuffer(c.dev, b, nullptr);
   vkFreeMemory(c.dev, m, nullptr);
   vkFreeMemory(c.dev, devOnly, nullptr);
+  if (oldForce) setenv("VPVK_FORCE_1X", savedForce.c_str(), 1);
+  else unsetenv("VPVK_FORCE_1X");
+}
+
+// VPVK_MSAA_TILE=0 (set by ctest for this group only: msaaTileOn() reads it once per process): attachments stay
+// fully resident.
+void testMsaaTileOff() {
+  if (!getenv("VPVK_MSAA_TILE") || std::strcmp(getenv("VPVK_MSAA_TILE"), "0") != 0) {
+    std::printf("skipped (run with VPVK_MSAA_TILE=0: ctest gpu_vulkan.msaa_tile_off)\n");
+    return;
+  }
+  setenv("VPVK_FORCE_1X", "0", 1);
+  Ctx c;
+  auto make = [&](VkFormat f, VkImageUsageFlags u, VkSampleCountFlagBits n) {
+    VkImageCreateInfo ii{VK_STRUCTURE_TYPE_IMAGE_CREATE_INFO};
+    ii.imageType = VK_IMAGE_TYPE_2D, ii.format = f, ii.extent = {64, 64, 1}, ii.mipLevels = 1, ii.arrayLayers = 1;
+    ii.samples = n, ii.tiling = VK_IMAGE_TILING_OPTIMAL, ii.usage = u;
+    VkImage i = VK_NULL_HANDLE;
+    return vkCreateImage(c.dev, &ii, nullptr, &i) == VK_SUCCESS ? i : VK_NULL_HANDLE;
+  };
+  VkImage ma = make(VK_FORMAT_R8G8B8A8_UNORM, VK_IMAGE_USAGE_COLOR_ATTACHMENT_BIT, VK_SAMPLE_COUNT_4_BIT);
+  VkImage md = make(VK_FORMAT_D32_SFLOAT, VK_IMAGE_USAGE_DEPTH_STENCIL_ATTACHMENT_BIT, VK_SAMPLE_COUNT_1_BIT);
+  CHECK(ma && md);
+  CHECK(from<Image>(ma)->desc.persistent && from<Image>(md)->desc.persistent);
+  unsetenv("VPVK_FORCE_1X");
 }
 
 // A two-eye multiview pass with DontCare depth: one core pass, two layers, depth never stored.
@@ -1827,7 +1916,7 @@ void testMotion() {
 int main(int argc, char** argv) {
   gLib = argc > 2 ? argv[2] : "libVPVulkan.so";
   const std::vector<std::pair<const char*, std::function<void()>>> groups = {
-      {"exports", testExports}, {"physical", testPhysical}, {"memory", testMemory},
+      {"exports", testExports}, {"physical", testPhysical}, {"memory", testMemory}, {"msaa_tile_off", testMsaaTileOff},
       {"passes", testPasses},   {"submit", testSubmit}, {"pipeline", testPipeline},
       {"recipes", testRecipes}, {"alyx", testAlyxSurface}, {"depth_resolve", testDepthResolve}, {"resolve_1x", testResolve1x},
       {"suspend_resume", testSuspendResume},
