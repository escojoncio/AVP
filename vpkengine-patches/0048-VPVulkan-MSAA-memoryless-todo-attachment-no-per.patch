 gpu/vulkan/include/vpvk/platform.h |  2 +
 gpu/vulkan/src/config.cpp          |  7 +++
 gpu/vulkan/src/entry.cpp           | 39 ++++++++++++-
 gpu/vulkan/src/platform_metal.mm   | 12 ++++
 gpu/vulkan/src/vpvk.h              |  6 ++
