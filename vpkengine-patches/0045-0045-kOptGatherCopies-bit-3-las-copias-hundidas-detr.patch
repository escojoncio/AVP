+// gatherCopies + producerWaits: an encoder made only of (blit encoder) copies waits for the encoders it depends on when it starts. What
+// an item after the first would wait for in other encoders moves to that first wait (otherwise the backend ends its Metal
+// encoder and opens another to wait there, once per item); an item barrier keeps the producers that are in the encoder
+// itself, and goes away when it has none.
+void hoistCopyWaits(CompiledFrame& out, const std::vector<Command>& cmds) {
+  std::vector<char> copiesOnly(out.encoders.size());
+  for (size_t e = 0; e < out.encoders.size(); ++e)
+    copiesOnly[e] = out.encoders[e].kind == Encoder::Kind::Compute &&
+                    std::all_of(out.encoders[e].commands.begin(), out.encoders[e].commands.end(), [&](uint32_t c) {
+                      // A sampled blit draws in render encoders of its own, which no earlier wait of the encoder orders.
+                      const auto* cp = std::get_if<Copy>(&cmds[c]);
+                      return cp && cp->kind != CopyKind::TextureBlit;
+                    });
+  std::vector<Barrier> kept, firsts;  // `firsts`: the item 0 barriers to merge in, sorted by encoder
+  kept.reserve(out.barriers.size());
+  for (Barrier& b : out.barriers) {
+    if (b.item > 0 && copiesOnly[b.encoder]) {
+      std::vector<uint32_t> external;
+      std::erase_if(b.producers, [&](uint32_t p) {
+        if (p == b.encoder) return false;
+        external.push_back(p);
+        return true;
+      });
+      if (!external.empty()) {
+        if (firsts.empty() || firsts.back().encoder != b.encoder) {
+          firsts.emplace_back();
+          firsts.back().encoder = b.encoder;
+        }
+        Barrier& z = firsts.back();
+        z.after |= b.after, z.before |= b.before, z.hazards |= b.hazards;
+        for (uint32_t p : external)
+          if (auto it = std::lower_bound(z.producers.begin(), z.producers.end(), p); it == z.producers.end() || *it != p)
+            z.producers.insert(it, p);
+        if (b.producers.empty()) continue;
+      }
+    }
+    kept.push_back(std::move(b));
+  }
+  for (Barrier& z : firsts) {
+    auto at = std::lower_bound(kept.begin(), kept.end(), z.encoder, [](const Barrier& b, uint32_t e) { return b.encoder < e; });
+    if (at != kept.end() && at->encoder == z.encoder && at->item == 0) {
+      at->after |= z.after, at->before |= z.before, at->hazards |= z.hazards;
+      for (uint32_t p : z.producers)
+        if (auto it = std::lower_bound(at->producers.begin(), at->producers.end(), p); it == at->producers.end() || *it != p)
+          at->producers.insert(it, p);
+    } else {
+      kept.insert(at, std::move(z));
+    }
+  }
+  out.barriers = std::move(kept);
+}
