+// PRODUCER-WAIT ORACLE for a frame compiled with producerWaits: every conflicting pair of commands in different
+// encoders is ordered, directly or through a chain of producer waits, and two conflicting items of one compute encoder
+// have a barrier between them. Returns the violations; `pairs` (optional) counts the conflicting pairs checked.
+uint32_t producerViolations(const Frame& f, const CompiledFrame& cf, uint32_t* pairs = nullptr) {
+  uint32_t bad = 0;
+  uint32_t scratch = 0;
+  if (!pairs) pairs = &scratch;
+  const auto& cmds = f.commands();
+  // Position of every command.
+  std::vector<std::pair<uint32_t, uint32_t>> pos(cmds.size(), {UINT32_MAX, 0});
+  for (uint32_t e = 0; e < cf.encoders.size(); ++e)
+    for (uint32_t k = 0; k < cf.encoders[e].commands.size(); ++k)
+      pos[cf.encoders[e].commands[k]] = {e, cf.encoders[e].kind == Encoder::Kind::Render ? 0 : k};
+  // Producers each encoder waits on (any item), and the item barriers.
+  std::vector<std::set<uint32_t>> waits(cf.encoders.size());
+  for (const Barrier& b : cf.barriers)
+    for (uint32_t x : b.producers)
+      if (x != b.encoder) waits[b.encoder].insert(x);
+  auto reaches = [&](uint32_t from, uint32_t to) {  // `from` ordered after `to` through producer waits
+    std::vector<uint32_t> st = {from};
+    std::set<uint32_t> seen;
+    while (!st.empty()) {
+      const uint32_t x = st.back();
+      st.pop_back();
+      if (x == to) return true;
+      if (!seen.insert(x).second) continue;
+      for (uint32_t y : waits[x]) st.push_back(y);
+    }
+    return false;
+  };
+  auto accessesFor = [&](uint32_t ci) {
+    std::vector<Access> v;
+    if (const auto* rp = std::get_if<RenderPass>(&cmds[ci])) {
+      v = attachmentAccesses(rp->desc);
+      for (const Draw& d : rp->draws)
+        for (const Access& a : drawAccesses(d)) v.push_back(a);
+    } else if (const auto* d = std::get_if<Dispatch>(&cmds[ci])) {
+      v = d->bindings;
+    } else {
+      v = copyAccesses(std::get<Copy>(cmds[ci]));
+    }
+    return v;
+  };
+  for (uint32_t i = 0; i < cmds.size(); ++i) {
+    if (pos[i].first == UINT32_MAX) continue;
+    for (uint32_t j = 0; j < cmds.size(); ++j) {
+      if (pos[j].first == UINT32_MAX || !(pos[i] < pos[j])) continue;
+      bool conflict = false;
+      for (const Access& a : accessesFor(i))
+        for (const Access& b : accessesFor(j))
+          if (a.range.kind != ResourceRange::Kind::Sampler && a.range.overlaps(b.range) && (a.write || b.write) &&
+              !(a.pixelLocal || b.pixelLocal))
+            conflict = true;
+      if (!conflict) continue;
+      // Only pairs in submission order matter (the compiler may reorder independent work).
+      if (i > j) continue;
+      ++*pairs;
+      if (pos[i].first != pos[j].first) {
+        bad += !reaches(pos[j].first, pos[i].first);
+      } else {
+        bool sep = false;
+        for (const Barrier& b : cf.barriers)
+          sep = sep || (b.encoder == pos[j].first && b.item > pos[i].second && b.item <= pos[j].second);
+        bad += !sep;
+      }
+    }
+  }
+  return bad;
+}
