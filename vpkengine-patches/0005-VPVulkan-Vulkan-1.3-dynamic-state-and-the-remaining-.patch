+// ---- private data (VK_EXT_private_data / 1.3) ----------------------------------------------------
+namespace {
+struct PrivateSlot {
+  std::mutex m;
+  std::unordered_map<uint64_t, uint64_t> data;  // (objectType << 56 ^ handle) -> value
+};
+uint64_t pkey(VkObjectType t, uint64_t h) { return h ^ (uint64_t(t) << 56); }
+}  // namespace
+VPVK_EXPORT VKAPI_ATTR VkResult VKAPI_CALL vkCreatePrivateDataSlot(VkDevice, const VkPrivateDataSlotCreateInfo*,
+                                                                   const VkAllocationCallbacks*, VkPrivateDataSlot* out) {
+  *out = reinterpret_cast<VkPrivateDataSlot>(new PrivateSlot);
+  return VK_SUCCESS;
+}
+VPVK_EXPORT VKAPI_ATTR void VKAPI_CALL vkDestroyPrivateDataSlot(VkDevice, VkPrivateDataSlot s, const VkAllocationCallbacks*) {
+  delete reinterpret_cast<PrivateSlot*>(s);
+}
+VPVK_EXPORT VKAPI_ATTR VkResult VKAPI_CALL vkSetPrivateData(VkDevice, VkObjectType t, uint64_t h, VkPrivateDataSlot s, uint64_t v) {
+  auto* p = reinterpret_cast<PrivateSlot*>(s);
+  std::lock_guard<std::mutex> lock(p->m);
+  p->data[pkey(t, h)] = v;
+  return VK_SUCCESS;
+}
+VPVK_EXPORT VKAPI_ATTR void VKAPI_CALL vkGetPrivateData(VkDevice, VkObjectType t, uint64_t h, VkPrivateDataSlot s, uint64_t* v) {
+  auto* p = reinterpret_cast<PrivateSlot*>(s);
+  std::lock_guard<std::mutex> lock(p->m);
+  auto it = p->data.find(pkey(t, h));
+  *v = it == p->data.end() ? 0 : it->second;
+}
+
+// ---- maintenance4: requirements without an object ------------------------------------------------
+VPVK_EXPORT VKAPI_ATTR void VKAPI_CALL vkGetDeviceBufferMemoryRequirements(VkDevice dv, const VkDeviceBufferMemoryRequirements* i,
+                                                                           VkMemoryRequirements2* out) {
+  VkBuffer b;
+  vkCreateBuffer(dv, i->pCreateInfo, nullptr, &b);
+  VkBufferMemoryRequirementsInfo2 ri{VK_STRUCTURE_TYPE_BUFFER_MEMORY_REQUIREMENTS_INFO_2};
+  ri.buffer = b;
+  vkGetBufferMemoryRequirements2(dv, &ri, out);
+  vkDestroyBuffer(dv, b, nullptr);
+}
+VPVK_EXPORT VKAPI_ATTR void VKAPI_CALL vkGetDeviceImageMemoryRequirements(VkDevice dv, const VkDeviceImageMemoryRequirements* i,
+                                                                          VkMemoryRequirements2* out) {
+  VkImage im = VK_NULL_HANDLE;
+  if (vkCreateImage(dv, i->pCreateInfo, nullptr, &im) != VK_SUCCESS) {
+    out->memoryRequirements = {};
+    return;
+  }
+  VkImageMemoryRequirementsInfo2 ri{VK_STRUCTURE_TYPE_IMAGE_MEMORY_REQUIREMENTS_INFO_2};
+  ri.image = im;
+  vkGetImageMemoryRequirements2(dv, &ri, out);
+  vkDestroyImage(dv, im, nullptr);
+}
+VPVK_EXPORT VKAPI_ATTR void VKAPI_CALL vkGetDeviceImageSparseMemoryRequirements(VkDevice, const VkDeviceImageMemoryRequirements*,
+                                                                                uint32_t* count, VkSparseImageMemoryRequirements2*) {
+  *count = 0;
+}
