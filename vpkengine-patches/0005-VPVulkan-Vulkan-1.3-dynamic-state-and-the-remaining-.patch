+// ---- copy commands 2 --------------------------------------------------------------------------
+VPVK_EXPORT VKAPI_ATTR void VKAPI_CALL vkCmdCopyBuffer2(VkCommandBuffer cb, const VkCopyBufferInfo2* i) {
+  for (uint32_t k = 0; k < i->regionCount; ++k) {
+    const VkBufferCopy r{i->pRegions[k].srcOffset, i->pRegions[k].dstOffset, i->pRegions[k].size};
+    vkCmdCopyBuffer(cb, i->srcBuffer, i->dstBuffer, 1, &r);
+  }
+}
+VPVK_EXPORT VKAPI_ATTR void VKAPI_CALL vkCmdCopyImage2(VkCommandBuffer cb, const VkCopyImageInfo2* i) {
+  for (uint32_t k = 0; k < i->regionCount; ++k) {
+    const VkImageCopy2& x = i->pRegions[k];
+    const VkImageCopy r{x.srcSubresource, x.srcOffset, x.dstSubresource, x.dstOffset, x.extent};
+    vkCmdCopyImage(cb, i->srcImage, i->srcImageLayout, i->dstImage, i->dstImageLayout, 1, &r);
+  }
+}
+namespace {
+VkBufferImageCopy bic(const VkBufferImageCopy2& x) {
+  return {x.bufferOffset, x.bufferRowLength, x.bufferImageHeight, x.imageSubresource, x.imageOffset, x.imageExtent};
+}
+}  // namespace
+VPVK_EXPORT VKAPI_ATTR void VKAPI_CALL vkCmdCopyBufferToImage2(VkCommandBuffer cb, const VkCopyBufferToImageInfo2* i) {
+  for (uint32_t k = 0; k < i->regionCount; ++k) {
+    const VkBufferImageCopy r = bic(i->pRegions[k]);
+    vkCmdCopyBufferToImage(cb, i->srcBuffer, i->dstImage, i->dstImageLayout, 1, &r);
+  }
+}
+VPVK_EXPORT VKAPI_ATTR void VKAPI_CALL vkCmdCopyImageToBuffer2(VkCommandBuffer cb, const VkCopyImageToBufferInfo2* i) {
+  for (uint32_t k = 0; k < i->regionCount; ++k) {
+    const VkBufferImageCopy r = bic(i->pRegions[k]);
+    vkCmdCopyImageToBuffer(cb, i->srcImage, i->srcImageLayout, i->dstBuffer, 1, &r);
+  }
+}
+VPVK_EXPORT VKAPI_ATTR void VKAPI_CALL vkCmdBlitImage2(VkCommandBuffer cb, const VkBlitImageInfo2* i) {
+  for (uint32_t k = 0; k < i->regionCount; ++k) {
+    const VkImageBlit2& x = i->pRegions[k];
+    VkImageBlit r{x.srcSubresource, {x.srcOffsets[0], x.srcOffsets[1]}, x.dstSubresource, {x.dstOffsets[0], x.dstOffsets[1]}};
+    vkCmdBlitImage(cb, i->srcImage, i->srcImageLayout, i->dstImage, i->dstImageLayout, 1, &r, i->filter);
+  }
+}
+VPVK_EXPORT VKAPI_ATTR void VKAPI_CALL vkCmdResolveImage2(VkCommandBuffer cb, const VkResolveImageInfo2* i) {
+  for (uint32_t k = 0; k < i->regionCount; ++k) {
+    const VkImageResolve2& x = i->pRegions[k];
+    const VkImageResolve r{x.srcSubresource, x.srcOffset, x.dstSubresource, x.dstOffset, x.extent};
+    vkCmdResolveImage(cb, i->srcImage, i->srcImageLayout, i->dstImage, i->dstImageLayout, 1, &r);
+  }
+}
+
+// ---- draw indirect count, dispatch base, device groups of one ----------------------------------
+namespace {
+void indirectCount(VkCommandBuffer cb, VkBuffer buf, VkDeviceSize off, VkBuffer countBuf, VkDeviceSize countOff,
+                   uint32_t maxDraws, uint32_t stride, bool indexed) {
+  Recorder& r = *from<CommandBuffer>(cb)->rec;
+  OpDraw op = makeDraw(r, 0, 1, 1, 0, 0, indexed);
+  op.indirect = from<Buffer>(buf), op.indirectOffset = off, op.indirectCount = maxDraws;
+  op.indirectStride = stride ? stride : (indexed ? 20 : 16);
+  op.countBuffer = from<Buffer>(countBuf), op.countOffset = countOff;
+  r.ops.emplace_back(std::move(op));
+}
+}  // namespace
+VPVK_EXPORT VKAPI_ATTR void VKAPI_CALL vkCmdDrawIndirectCount(VkCommandBuffer cb, VkBuffer b, VkDeviceSize o, VkBuffer cbuf,
+                                                              VkDeviceSize co, uint32_t maxDraws, uint32_t stride) {
+  indirectCount(cb, b, o, cbuf, co, maxDraws, stride, false);
+}
+VPVK_EXPORT VKAPI_ATTR void VKAPI_CALL vkCmdDrawIndexedIndirectCount(VkCommandBuffer cb, VkBuffer b, VkDeviceSize o,
+                                                                     VkBuffer cbuf, VkDeviceSize co, uint32_t maxDraws,
+                                                                     uint32_t stride) {
+  indirectCount(cb, b, o, cbuf, co, maxDraws, stride, true);
+}
+VPVK_EXPORT VKAPI_ATTR void VKAPI_CALL vkCmdDispatchBase(VkCommandBuffer cb, uint32_t bx, uint32_t by, uint32_t bz, uint32_t x,
+                                                         uint32_t y, uint32_t z) {
+  if (bx || by || bz) {
+    static std::atomic<unsigned> n{0};
+    if (n.fetch_add(1) < 4) logf("vk.unimpl dispatch_base base=%u,%u,%u (dispatched from 0)", bx, by, bz);
+  }
+  vkCmdDispatch(cb, x, y, z);
+}
+VPVK_EXPORT VKAPI_ATTR void VKAPI_CALL vkCmdSetDeviceMask(VkCommandBuffer, uint32_t) {}
+VPVK_EXPORT VKAPI_ATTR VkResult VKAPI_CALL vkEnumeratePhysicalDeviceGroups(VkInstance inst, uint32_t* count,
+                                                                           VkPhysicalDeviceGroupProperties* out) {
+  if (!out) {
+    *count = 1;
+    return VK_SUCCESS;
+  }
+  if (*count < 1) return VK_INCOMPLETE;
+  *count = 1;
+  uint32_t one = 1;
+  vkEnumeratePhysicalDevices(inst, &one, out[0].physicalDevices);
+  out[0].physicalDeviceCount = 1;
+  out[0].subsetAllocation = VK_FALSE;
+  return VK_SUCCESS;
+}
+VPVK_EXPORT VKAPI_ATTR void VKAPI_CALL vkGetDeviceGroupPeerMemoryFeatures(VkDevice, uint32_t, uint32_t, uint32_t,
+                                                                          VkPeerMemoryFeatureFlags* f) {
+  *f = VK_PEER_MEMORY_FEATURE_COPY_SRC_BIT | VK_PEER_MEMORY_FEATURE_COPY_DST_BIT | VK_PEER_MEMORY_FEATURE_GENERIC_SRC_BIT |
+       VK_PEER_MEMORY_FEATURE_GENERIC_DST_BIT;
+}
+
+// ---- sparse (none), external capabilities (none exportable), tools ------------------------------
+VPVK_EXPORT VKAPI_ATTR void VKAPI_CALL vkGetImageSparseMemoryRequirements2(VkDevice, const VkImageSparseMemoryRequirementsInfo2*,
+                                                                           uint32_t* count, VkSparseImageMemoryRequirements2*) {
+  *count = 0;
+}
+VPVK_EXPORT VKAPI_ATTR void VKAPI_CALL vkGetPhysicalDeviceSparseImageFormatProperties2(
+    VkPhysicalDevice, const VkPhysicalDeviceSparseImageFormatInfo2*, uint32_t* count, VkSparseImageFormatProperties2*) {
+  *count = 0;
+}
+VPVK_EXPORT VKAPI_ATTR void VKAPI_CALL vkGetPhysicalDeviceExternalBufferProperties(VkPhysicalDevice,
+                                                                                   const VkPhysicalDeviceExternalBufferInfo*,
+                                                                                   VkExternalBufferProperties* p) {
+  p->externalMemoryProperties = {};
+}
+VPVK_EXPORT VKAPI_ATTR void VKAPI_CALL vkGetPhysicalDeviceExternalFenceProperties(VkPhysicalDevice,
+                                                                                  const VkPhysicalDeviceExternalFenceInfo*,
+                                                                                  VkExternalFenceProperties* p) {
+  p->exportFromImportedHandleTypes = p->compatibleHandleTypes = 0;
+  p->externalFenceFeatures = 0;
+}
+VPVK_EXPORT VKAPI_ATTR void VKAPI_CALL vkGetPhysicalDeviceExternalSemaphoreProperties(
+    VkPhysicalDevice, const VkPhysicalDeviceExternalSemaphoreInfo*, VkExternalSemaphoreProperties* p) {
+  p->exportFromImportedHandleTypes = p->compatibleHandleTypes = 0;
+  p->externalSemaphoreFeatures = 0;
+}
+VPVK_EXPORT VKAPI_ATTR VkResult VKAPI_CALL vkGetPhysicalDeviceToolProperties(VkPhysicalDevice, uint32_t* count,
+                                                                             VkPhysicalDeviceToolProperties*) {
+  *count = 0;
+  return VK_SUCCESS;
+}
