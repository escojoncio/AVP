+++ b/gpu/core/include/vpgpu/core/commands.h
@@ -146,8 +146,24 @@ struct Indirect {
   uint64_t offset = 0;
 };
 
+// Depth/stencil state set per draw (Vulkan dynamic state) instead of the pipeline's. Same
+// enums as PipelineState (pipeline_cache.h); the backend caches one native object per value.
+struct DepthStencilDynamic {
+  bool depthTest = false, depthWrite = false;
+  uint8_t depthCompare = 7;  // CompareOp
+  bool stencilTest = false;
+  struct Face {
+    uint8_t fail = 0, depthFail = 0, pass = 0, compare = 7;  // StencilOp x3, CompareOp
+    uint8_t readMask = 0xFF, writeMask = 0xFF;
+  } front, back;
+  bool operator==(const DepthStencilDynamic&) const = default;
+};
+
 struct Draw {
   PipelineKey pipeline;
+  // Vulkan dynamic state overriding what the pipeline baked in (unset = the pipeline's).
+  std::optional<DepthStencilDynamic> depthStencil;
+  std::optional<uint8_t> cull;  // CullMode
   std::vector<Access> bindings;  // vertex buffers, constants, textures, storage
   Primitive primitive = Primitive::Triangles;
   uint32_t first = 0, count = 0, instances = 1;  // first/count are indices when indexed
diff --git a/gpu/metal2/src/metal_backend.mm b/gpu/metal2/src/metal_backend.mm
index 1860689..4abb447 100644
--- a/gpu/metal2/src/metal_backend.mm
+++ b/gpu/metal2/src/metal_backend.mm
@@ -452,6 +452,36 @@ struct MetalBackend::Impl {
   bool saveArchiveLocked();
   void maybeSaveArchive();
 
+  // Depth-stencil states of draws with dynamic depth/stencil state (submit thread only).
+  std::unordered_map<uint64_t, id<MTLDepthStencilState>> dynamicDepth;
+  id<MTLDepthStencilState> dynamicDepthStencil(const DepthStencilDynamic& s) {
+    uint64_t h = 1469598103934665603ull;
+    const uint8_t* b = reinterpret_cast<const uint8_t*>(&s);
+    for (size_t i = 0; i < sizeof s; ++i) h = (h ^ b[i]) * 1099511628211ull;
+    auto it = dynamicDepth.find(h);
+    if (it != dynamicDepth.end()) return it->second;
+    MTLDepthStencilDescriptor* ds = [MTLDepthStencilDescriptor new];
+    ds.depthCompareFunction = s.depthTest ? MTLCompareFunction(s.depthCompare) : MTLCompareFunctionAlways;
+    ds.depthWriteEnabled = s.depthTest && s.depthWrite;
+    if (s.stencilTest) {
+      auto face = [](const DepthStencilDynamic::Face& f) {
+        MTLStencilDescriptor* d = [MTLStencilDescriptor new];
+        d.stencilCompareFunction = MTLCompareFunction(f.compare);
+        d.stencilFailureOperation = MTLStencilOperation(f.fail);
+        d.depthFailureOperation = MTLStencilOperation(f.depthFail);
+        d.depthStencilPassOperation = MTLStencilOperation(f.pass);
+        d.readMask = f.readMask;
+        d.writeMask = f.writeMask;
+        return d;
+      };
+      ds.frontFaceStencil = face(s.front);
+      ds.backFaceStencil = face(s.back);
+    }
+    id<MTLDepthStencilState> st = [device newDepthStencilStateWithDescriptor:ds];
+    dynamicDepth[h] = st;
+    return st;
+  }
+
   std::mutex doneMutex;
   std::deque<Done> done;
   // Frames submitted to Metal and not completed yet, and the next frame index expected (guarded by
@@ -1750,8 +1780,11 @@ void MetalBackend::Impl::submit(uint64_t frameIndex, const Frame& frame, const C
           }
           useBound();
           [open.render setRenderPipelineState:p->render];
-          [open.render setDepthStencilState:p->depth];
-          [open.render setCullMode:p->cull];
+          [open.render setDepthStencilState:d.depthStencil ? dynamicDepthStencil(*d.depthStencil) : p->depth];
+          [open.render setCullMode:d.cull ? (*d.cull == uint8_t(CullMode::Front) ? MTLCullModeFront
+                                             : *d.cull == uint8_t(CullMode::Back) ? MTLCullModeBack
+                                                                                   : MTLCullModeNone)
+                                          : p->cull];
           [open.render setStencilReferenceValue:d.stencilRef];
           [open.render setFrontFacingWinding:d.frontFace == Winding::Clockwise ? MTLWindingClockwise : MTLWindingCounterClockwise];
           [open.render setDepthBias:d.depthBias slopeScale:d.depthBiasSlope clamp:d.depthBiasClamp];
