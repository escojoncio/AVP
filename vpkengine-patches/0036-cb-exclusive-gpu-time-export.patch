From 0dc63326134f9ea40c3c2f8ab213424123f5e4bb Mon Sep 17 00:00:00 2001
From: Claude <claude@users.invalid>
Date: Wed, 14 Oct 2026 15:14:24 +0000
Subject: [PATCH] metal2: exclusive GPU time per completed command buffer for
 the host's pace governor (vpgpu_metal2_cb_busy_ms)

- The encoders' stage-boundary timestamps (sampled whatever VP_EXCL_TIMING says)
  are placed on one timeline in the completed handler and each command buffer's
  exclusive ms kept in a 64-entry ring keyed by the command buffer, consumed by
  vpgpu_metal2_cb_busy_ms(cb, &ms) (1 known, 0 nothing sampled, -1 not in the ring).
  vpgpu_metal2_cb_busy_stats gives the counts. The host's completed handler is added
  inside -commit, after ours, so the entry is there when it looks.
- gpu.excl's per-type accounting is unchanged (still behind VP_EXCL_TIMING).
---
 gpu/metal2/src/metal_backend.mm | 70 +++++++++++++++++++++++++++++++++
 1 file changed, 70 insertions(+)

diff --git a/gpu/metal2/src/metal_backend.mm b/gpu/metal2/src/metal_backend.mm
index db4c829..6619946 100644
--- a/gpu/metal2/src/metal_backend.mm
+++ b/gpu/metal2/src/metal_backend.mm
@@ -66,6 +66,48 @@ constexpr NSUInteger kMaxSamples = 2048;      // timestamp samples per frame slo
 // GPU hangs this process caused (not victims, not ignored submissions): read by VPVulkan (motion kill switch).
 std::atomic<uint32_t> gGpuHangs{0};
 std::atomic<bool> gDumpRequest{false};  // vpgpu_metal2_request_dump: the next real frame, pass by pass
+// Exclusive GPU time of each completed command buffer (vpgpu_metal2_cb_busy_ms, for the host's pace governor):
+// its encoders' stage-boundary timestamps placed on one timeline, each counted only for how far it moves the
+// latest end seen so far. A command buffer's [GPUStartTime, GPUEndTime] span holds the waits on earlier command
+// buffers and the time other queues (the host's compositor) had the GPU, so it reads up to twice the work. The
+// timestamps are sampled whatever VP_EXCL_TIMING says (gpu.excl's per-type accounting stays behind it); this costs
+// one small loop per completed command buffer. Entries are consumed by the lookup; a ring of 64 covers the frames
+// in flight (12 slots, up to 8 command buffers each is more than a frame's worth).
+constexpr size_t kBusyRing = 64;
+struct BusyEntry {
+  const void* cb = nullptr;
+  double ms = -1;  // -1: none of its encoders was sampled
+};
+std::mutex gBusyMutex;
+BusyEntry gBusyRing[kBusyRing];
+size_t gBusyNext = 0;
+uint64_t gBusyLastEnd = 0;  // GPU ticks
+std::atomic<uint64_t> gBusyCbs{0}, gBusyUnsampled{0};
+void busyAccount(const void* cb, const std::vector<std::pair<uint64_t, uint64_t>>& span,
+                 const std::vector<std::pair<uint64_t, uint64_t>>& stages, const std::vector<char>& kinds,
+                 double msPerTick) {
+  double ms = 0;
+  bool sampled = false;
+  std::lock_guard lock(gBusyMutex);
+  for (size_t i = 0; i < span.size(); ++i) {
+    uint64_t start = span[i].first, end = span[i].second;
+    if (i < kinds.size() && kinds[i] == 'r' && i < stages.size()) {
+      const uint64_t vtxEnd = stages[i].first, fragStart = stages[i].second;
+      if (fragStart && (!start || fragStart < start)) start = fragStart;  // no vertex work: starts with fragments
+      if (!end) end = vtxEnd;
+    }
+    if (!start || !end || end < start) continue;
+    sampled = true;
+    const uint64_t from = std::max(start, gBusyLastEnd);
+    if (end > from) ms += double(end - from) * msPerTick;
+    gBusyLastEnd = std::max(gBusyLastEnd, end);
+  }
+  for (BusyEntry& e : gBusyRing)  // an entry never consumed (a queue the host does not watch) whose address came back
+    if (e.cb == cb) e.cb = nullptr;
+  gBusyRing[gBusyNext++ % kBusyRing] = BusyEntry{cb, sampled ? ms : -1.0};
+  gBusyCbs.fetch_add(1);
+  if (!sampled) gBusyUnsampled.fetch_add(1);
+}
 // Indirect draws whose arguments the GPU writes (Draw::indirect): rewritten per frame slot by the
 // fix-up kernel into Metal's layout. 16-byte diagnostic header, then 20 (indexed) or 16 bytes per
 // draw: 1 MiB holds ~52k draws a frame.
@@ -3380,6 +3422,12 @@ void MetalBackend::Impl::submit(uint64_t frameIndex, const Frame& frame, const C
         d.timings.encoderMs.push_back(ms);
       }
     }
+    if (sampleCount && diag && finished.status == MTLCommandBufferStatusCompleted) {
+      // Before any later completed handler (the host adds its own after ours at commit) reads it.
+      std::vector<char> kinds(diag->size());
+      for (size_t i = 0; i < diag->size(); ++i) kinds[i] = (*diag)[i].kind;
+      busyAccount((__bridge const void*)finished, raw, stg, kinds, impl->gpuTickNs / 1e6);
+    }
     if (impl->exclOn && sampleCount && diag && finished.status == MTLCommandBufferStatusCompleted)
       impl->exclAccount(exclType, *diag, raw, stg, finished.GPUEndTime, d.timings.frameMs);
     if (finished.status == MTLCommandBufferStatusError) {
@@ -4556,3 +4604,25 @@ extern "C" __attribute__((visibility("default"))) void vpgpu_metal2_request_dump
 extern "C" __attribute__((visibility("default"))) uint32_t vpgpu_metal2_gpu_hangs(void) {
   return vpgpu::metal2::gGpuHangs.load();
 }
+// The exclusive GPU time (ms) of a command buffer that completed on our queue, consumed: 1 and *ms set when
+// known, 0 when none of its encoders was sampled, -1 when the command buffer is not (or no longer) in the ring.
+// Call it from a completed handler added after ours (the host hooks -commit, which runs after we add ours).
+extern "C" __attribute__((visibility("default"))) int vpgpu_metal2_cb_busy_ms(const void* cb, double* ms) {
+  using namespace vpgpu::metal2;
+  std::lock_guard lock(gBusyMutex);
+  for (size_t i = 0; i < kBusyRing; ++i) {
+    BusyEntry& e = gBusyRing[i];
+    if (e.cb != cb) continue;
+    const double v = e.ms;
+    e.cb = nullptr;
+    if (v < 0) return 0;
+    if (ms) *ms = v;
+    return 1;
+  }
+  return -1;
+}
+// Command buffers accounted so far and how many had no sampled encoder (the host logs them).
+extern "C" __attribute__((visibility("default"))) void vpgpu_metal2_cb_busy_stats(uint64_t* cbs, uint64_t* unsampled) {
+  if (cbs) *cbs = vpgpu::metal2::gBusyCbs.load();
+  if (unsampled) *unsampled = vpgpu::metal2::gBusyUnsampled.load();
+}
