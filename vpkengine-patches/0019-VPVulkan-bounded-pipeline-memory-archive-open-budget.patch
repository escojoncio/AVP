+    uint32_t loaded = 0, skipped = 0, pipelines = 0;
+    uint64_t bytesLoaded = 0, bytesSkipped = 0;
+    int64_t memDelta = 0;  // footprint after opening them minus before (bytes)
+  };
+  ArchiveStats archiveStats() const;  // set once at construction
+  static uint64_t footprint();        // phys_footprint of this process, 0 = unknown
