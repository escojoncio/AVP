 struct MetalOptions {
   std::filesystem::path cacheRoot;  // binary archive lives here; empty = no disk cache
   unsigned framesInFlight = 3;
+  // Opening a binary archive costs process footprint roughly in proportion to its contents
+  // (build 13: 9 files, 4109 pipelines, +6.7 GB inside vkCreateDevice -> jetsam). Files are opened
+  // smallest first while the measured footprint growth stays under archiveBudgetBytes and the
+  // available memory stays above archiveFloorBytes; the rest stay on disk unopened (their
+  // pipelines compile from the OS shader cache). 0 = no limit.
+  uint64_t archiveBudgetBytes = 768ull << 20;
+  uint64_t archiveFloorBytes = 5ull << 30;
+  // Reserved (not implemented yet): consolidate every archive into one session file.
+  bool archiveConsolidate = false;
 };
 
