@@ -182,6 +182,13 @@ PipelineStats PipelineCache::totals() const {
   return total_;
 }
 
+size_t PipelineCache::readyCount() const {
+  std::lock_guard lock(mutex_);
+  size_t n = 0;
+  for (const auto& [k, e] : entries_) n += e.status == Status::Ready;
+  return n;
+}
+
