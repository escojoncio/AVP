+namespace vpvk {
+constexpr uint64_t kMemLogFrames = 600;
+
+void logDeviceMemory(Device& d, const char* when, uint64_t frame) {
+  if (!d.gpu || !d.platform) return;
+  const Platform::ArchiveStats as = d.platform->archiveStats();
+  const size_t held = d.gpu->pipelines().readyCount();
+  const uint64_t foot = d.platform->footprint(), avail = d.platform->availableMemory();
+  const uint64_t recipeFile = d.recipes ? d.recipes->fileBytes() : 0;
+  const size_t recipeSrc = d.recipes ? d.recipes->sourceBytes() : 0;
+  logf("gpu.mem when=%s f=%llu pipelines_held=%zu archives=%u archives_skipped=%u archive_pipelines=%u "
+       "archive_mb=%llu archive_open_delta_mb=%lld recipes=%u recipe_mode=%s recipe_file_mb=%llu recipe_msl_mb=%zu "
+       "footprint_mb=%llu avail_mb=%llu",
+       when, (unsigned long long)frame, held, as.loaded, as.skipped, as.pipelines,
+       (unsigned long long)(as.bytesLoaded >> 20), (long long)(as.memDelta / (1 << 20)), d.prewarmedRecipes,
+       d.recipeMode, (unsigned long long)(recipeFile >> 20), recipeSrc >> 20, (unsigned long long)(foot >> 20),
+       (unsigned long long)(avail >> 20));
+}
+
+// After each submitted frame (sync.cpp): gpu.mem every kMemLogFrames frames. Cheap when not due.
+void memFrameSubmitted(Device& d, uint64_t frame) {
+  uint64_t due = d.memNextFrame.load(std::memory_order_relaxed);
+  if (frame < due) return;
+  if (!d.memNextFrame.compare_exchange_strong(due, frame + kMemLogFrames)) return;
+  logDeviceMemory(d, "frame", frame);
+}
+}  // namespace vpvk
+
 // For a host's prewarm device (no game running): blocks until every shader library and pipeline
 // its vkCreate*Pipelines calls queued has compiled, then writes the binary archive, so retiring
 // the device drops nothing. Returns the milliseconds waited. Found with dlsym.
@@ -1409,6 +1466,7 @@ VPVK_EXPORT uint32_t vpvk_device_wait_compiles(VkDevice dv) {
   const double ms = std::chrono::duration<double, std::milli>(std::chrono::steady_clock::now() - t0).count();
   const vpgpu::PipelineStats t = d->gpu->pipelines().totals();
   logf("vk.prewarm drained ms=%.0f pipelines compiled=%u failed=%u hits=%u", ms, t.compiled, t.failed, t.hits);
+  logDeviceMemory(*d, "drained", d->lastFrame == kNoFrame ? 0 : d->lastFrame);
   return uint32_t(ms);
 }
 
