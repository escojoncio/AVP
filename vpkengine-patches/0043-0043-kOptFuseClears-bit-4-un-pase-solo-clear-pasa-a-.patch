diff --git a/gpu/core/tests/core_tests.cpp b/gpu/core/tests/core_tests.cpp
index 24e722f..d2fbbe5 100644
--- a/gpu/core/tests/core_tests.cpp
+++ b/gpu/core/tests/core_tests.cpp
@@ -88,6 +88,51 @@ struct Scene {
 uint32_t cuts(const CompiledFrame& c, CutReason r) { return c.stats.cuts[static_cast<int>(r)]; }
 uint32_t hazards(const CompiledFrame& c, HazardKind k) { return c.stats.hazards[static_cast<int>(k)]; }
 
+// Everything a command touches, as declared (no compiler involved).
+std::vector<Access> accessesOfCommand(const Command& c) {
+  std::vector<Access> v;
+  if (const auto* rp = std::get_if<RenderPass>(&c)) {
+    v = attachmentAccesses(rp->desc);
+    for (const Draw& d : rp->draws)
+      for (const Access& a : drawAccesses(d)) v.push_back(a);
+  } else if (const auto* d = std::get_if<Dispatch>(&c)) {
+    v = d->bindings;
+    if (d->indirect) v.push_back(read(ResourceRange::bytes(d->indirect->buffer, d->indirect->offset, 12), stage::compute));
+  } else {
+    v = copyAccesses(std::get<Copy>(c));
+  }
+  return v;
+}
+
+// ORDER ORACLE: every command is scheduled exactly once, and every pair of commands in conflict (overlapping
+// ranges, a write on one side; attachments and pixel-local reads included) keeps its program order: position is
+// (encoder, index in Encoder::commands). Returns the violations.
+uint32_t orderViolations(const Frame& f, const CompiledFrame& cf) {
+  const auto& cmds = f.commands();
+  std::vector<std::pair<uint32_t, uint32_t>> pos(cmds.size(), {UINT32_MAX, 0});
+  uint32_t bad = 0;
+  for (uint32_t e = 0; e < cf.encoders.size(); ++e)
+    for (uint32_t k = 0; k < cf.encoders[e].commands.size(); ++k) {
+      auto& p = pos[cf.encoders[e].commands[k]];
+      bad += p.first != UINT32_MAX;  // scheduled twice
+      p = {e, k};
+    }
+  std::vector<std::vector<Access>> acc;
+  for (const Command& c : cmds) acc.push_back(accessesOfCommand(c));
+  for (uint32_t i = 0; i < cmds.size(); ++i) {
+    bad += pos[i].first == UINT32_MAX;  // never scheduled (these frames reference only live resources)
+    for (uint32_t j = i + 1; j < cmds.size(); ++j) {
+      if (pos[i].first == UINT32_MAX || pos[j].first == UINT32_MAX || pos[i] < pos[j]) continue;
+      bool conflict = false;
+      for (const Access& a : acc[i])
+        for (const Access& b : acc[j])
+          conflict = conflict || (a.range.kind != ResourceRange::Kind::Sampler && (a.write || b.write) && a.range.overlaps(b.range));
+      bad += conflict;
+    }
+  }
+  return bad;
+}
+
