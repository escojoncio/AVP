+// CompileOptions::fuseClears (kOptFuseClears): a clear-only pass waits for the next pass on its target.
+void testClearFuse() {
+  Scene s;
+  CompileOptions on;
+  on.fuseClears = true;
+  const TextureId c = s.rt(), d = s.depthRt(), other = s.rt();
+  const BufferId buf = s.buf();
+  auto clearPass = [](TextureId t, float v, bool depth = false) {
+    RenderPassDesc p;
+    Attachment& a = depth ? p.depth : p.colors[0];
+    a.texture = t;
+    a.load = LoadAction::Clear;
+    a.clear.color = {v, v, v, 1};
+    a.clear.depth = v;
+    return p;
+  };
+  auto loadPass = [](TextureId col, TextureId dep = {}) { return Scene::pass(col, dep); };
+  auto sameSchedule = [](const CompiledFrame& a, const CompiledFrame& b) {
+    if (a.encoders.size() != b.encoders.size() || a.barriers.size() != b.barriers.size()) return false;
+    for (size_t e = 0; e < a.encoders.size(); ++e) {
+      const Encoder &x = a.encoders[e], &y = b.encoders[e];
+      if (x.kind != y.kind || x.reason != y.reason || x.commands != y.commands || x.passes != y.passes ||
+          !x.pass.sameTargets(y.pass))
+        return false;
+      for (int k = 0; k <= kMaxColorAttachments; ++k) {
+        const Attachment &p = k == kDepthSlot ? x.pass.depth : x.pass.colors[k], &q = k == kDepthSlot ? y.pass.depth : y.pass.colors[k];
+        if (p.load != q.load || p.store != q.store || p.clear.color != q.clear.color || p.clear.depth != q.clear.depth) return false;
+      }
+    }
+    return true;
+  };
+  {  // colour clear + depth clear + one pass loading both: one encoder, both loads are clears
+    Frame f;
+    f.clear(clearPass(c, 0.25f));
+    f.clear(clearPass(d, 0.5f, true));
+    Scene::passWithDraw(f, loadPass(c, d));
+    CHECK_EQ(compileFrame(f, &s.res).encoders.size(), size_t{3});  // without the option: one encoder each
+    const CompiledFrame cf = compileFrame(f, &s.res, on);
+    CHECK_EQ(cf.encoders.size(), size_t{1});
+    const Encoder& e = cf.encoders[0];
+    CHECK(e.pass.colors[0].load == LoadAction::Clear && e.pass.colors[0].clear.color[0] == 0.25f);
+    CHECK(e.pass.depth.load == LoadAction::Clear && e.pass.depth.clear.depth == 0.5f);
+    CHECK(e.commands == (std::vector<uint32_t>{0, 1, 2}));
+    CHECK_EQ(e.passes, 3u);
+    CHECK_EQ(cf.stats.clearOnly, 2u);
+    CHECK_EQ(cf.stats.clearFused, 2u);
+    CHECK_EQ(cf.stats.flushConflict + cf.stats.flushPartial + cf.stats.flushEnd, 0u);
+    CHECK(cf.barriers.empty());
+    CHECK_EQ(orderViolations(f, cf), 0u);
+  }
+  {  // clear, an independent dispatch, the pass: the clear waits behind the dispatch
+    Frame f;
+    f.clear(clearPass(c, 1.0f));
+    f.dispatch(Scene::compute({write(ResourceRange::bytes(buf, 0, 256), stage::compute)}));
+    Scene::passWithDraw(f, loadPass(c));
+    CHECK_EQ(compileFrame(f, &s.res).encoders.size(), size_t{3});
+    const CompiledFrame cf = compileFrame(f, &s.res, on);
+    CHECK_EQ(cf.encoders.size(), size_t{2});
+    CHECK(cf.encoders[0].kind == Encoder::Kind::Compute);
+    CHECK(cf.encoders[1].pass.colors[0].load == LoadAction::Clear);
+    CHECK(cf.encoders[1].commands == (std::vector<uint32_t>{0, 2}));
+    CHECK_EQ(cf.stats.clearFused, 1u);
+    CHECK_EQ(orderViolations(f, cf), 0u);
+  }
+  {  // the clear then a pass on other targets, then the pass on c: fused into the later pass
+    Frame f;
+    f.clear(clearPass(c, 1.0f));
+    Scene::passWithDraw(f, loadPass(other));
+    Scene::passWithDraw(f, loadPass(c));
+    const CompiledFrame cf = compileFrame(f, &s.res, on);
+    CHECK_EQ(cf.encoders.size(), size_t{2});
+    CHECK(cf.encoders[1].pass.colors[0].load == LoadAction::Clear);
+    CHECK_EQ(orderViolations(f, cf), 0u);
+  }
+  {  // something reads what is cleared in between: the clear is an encoder of its own, ahead of the reader
+    Frame f;
+    f.clear(clearPass(c, 1.0f));
+    Scene::passWithDraw(f, loadPass(other), {Scene::sample(c)});
+    Scene::passWithDraw(f, loadPass(c));
+    const CompiledFrame cf = compileFrame(f, &s.res, on), off = compileFrame(f, &s.res);
+    CHECK(sameSchedule(cf, off));
+    CHECK_EQ(cf.stats.clearOnly, 1u);
+    CHECK_EQ(cf.stats.flushConflict, 1u);
+    CHECK_EQ(cf.stats.clearFused, 0u);
+    CHECK_EQ(orderViolations(f, cf), 0u);
+  }
+  {  // a dispatch, a copy that touch it
+    Frame f;
