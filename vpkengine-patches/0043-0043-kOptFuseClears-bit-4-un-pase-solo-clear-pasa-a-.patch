diff --git a/gpu/core/src/frame_compiler.cpp b/gpu/core/src/frame_compiler.cpp
index af93940..089e1da 100644
--- a/gpu/core/src/frame_compiler.cpp
+++ b/gpu/core/src/frame_compiler.cpp
@@ -251,7 +251,57 @@ class Scheduler {
   // `acc` is updated in place: pixel-local reads that cannot be served from the tile lose their
   // attachment tag; they are reported as bad fetches and their draws listed in badDraws.
   void renderPass(uint32_t i, const RenderPass& rp, AccessList& acc) {
-    const RenderPassDesc& desc = rp.desc;
+    if (!options_.fuseClears) return place(i, rp, rp.desc, acc);
+    // Pending clears this pass touches: fused into its load actions, or else materialised first.
+    RenderPassDesc fused = rp.desc;
+    std::vector<uint32_t> fusedCmds;
+    if (!pending_.empty() && touches(acc, pendingAcc_)) {
+      for (size_t k = 0; k < pending_.size();) {
+        PendingClear& pc = pending_[k];
+        if (!touches(acc, pc.idx)) {
+          ++k;
+          continue;
+        }
+        const Fit fit = classify(pc, rp.desc, acc);
+        if (fit == Fit::Fuse) {
+          const int slot = slotOf(rp.desc, pc.target.texture);
+          (slot == kDepthSlot ? fused.depth : fused.colors[slot]).load = LoadAction::Clear;
+          (slot == kDepthSlot ? fused.depth : fused.colors[slot]).clear = pc.target.clear;
+          fusedCmds.push_back(pc.cmd);
+          ++out_.stats.clearFused;
+        } else {
+          ++(fit == Fit::Partial ? out_.stats.flushPartial : out_.stats.flushConflict);
+          materialize(pc);
+        }
+        pending_.erase(pending_.begin() + static_cast<std::ptrdiff_t>(k));
+      }
+      rebuildPending();
+    }
+    if (fusedCmds.empty() && deferrable(rp)) {
+      PendingClear pc;
+      pc.cmd = i;
+      pc.rp = &rp;
+      pc.acc = acc;
+      pc.idx.append(acc);
+      forEachSlot(rp.desc, [&](const Attachment& a, int) {
+        if (a.texture) pc.target = a;
+      });
+      pendingAcc_.append(acc);
+      pending_.push_back(std::move(pc));
+      ++out_.stats.clearOnly;
+      return;
+    }
+    place(i, rp, fused, acc);
+    if (fusedCmds.empty()) return;
+    // The fused clears are part of this encoder, ahead of the pass: barriers and the backend's per-command
+    // bookkeeping see their writes.
+    Encoder& e = out_.encoders[open_];
+    e.commands.insert(e.commands.end() - 1, fusedCmds.begin(), fusedCmds.end());
+    e.passes += static_cast<uint32_t>(fusedCmds.size());
+  }
+
+  // Schedules one pass; `desc` is its attachment set (rp.desc, or that with pending clears fused into the loads).
+  void place(uint32_t i, const RenderPass& rp, const RenderPassDesc& desc, AccessList& acc) {
     // Pixel-local reads are always served as colour attachments of the encoder, at the slot the
     // texture was last rendered through (see fetchIndex). If the texture is not one of this pass's
     // own attachments it is added: merged into the encoder that holds it, or else loaded.
@@ -320,6 +370,7 @@ class Scheduler {
   }
 
   void copy(uint32_t i, AccessList acc) {
+    flushTouched(acc);
     if (open_ < 0) return computeWork(i, CutReason::CopyWork, std::move(acc));
     if (conflicts(acc, acc_[open_]) || conflicts(acc, sunkAcc_)) {
       sunk_.push_back(i);
@@ -341,13 +392,101 @@ class Scheduler {
   }
 
   void dispatch(uint32_t i, AccessList acc) {
+    flushTouched(acc);
     closeRender();
     computeWork(i, CutReason::ComputeWork, std::move(acc));
   }
 
-  void finish() { closeRender(); }
+  void finish() {
+    for (PendingClear& pc : pending_) {
+      ++out_.stats.flushEnd;
+      materialize(pc);
+    }
+    pending_.clear();
+    pendingAcc_.clear();
+    closeRender();
+  }
 
  private:
+  // A clear-only pass held back by CompileOptions::fuseClears.
+  struct PendingClear {
+    uint32_t cmd = 0;
+    const RenderPass* rp = nullptr;
+    AccessList acc;
+    AccessIndex idx;
+    Attachment target;  // its only attachment
+  };
+  enum class Fit { Fuse, Partial, Conflict };
+
+  // Pass `rp` touches the clear's target: can the clear become the load action of rp's attachment? Only if rp
+  // attaches that very target with Load, over the whole mip and the same layers (the clear covers the whole
+  // mip), and nothing else of rp touches it.
+  Fit classify(const PendingClear& pc, const RenderPassDesc& desc, const AccessList& acc) const {
+    const int slot = slotOf(desc, pc.target.texture);
+    if (slot < 0) return Fit::Conflict;
+    const Attachment& a = slot == kDepthSlot ? desc.depth : desc.colors[slot];
+    if (!a.sameTarget(pc.target) || a.load != LoadAction::Load) return Fit::Conflict;
+    if (desc.layerCount != pc.rp->desc.layerCount || !coversMip(desc, a)) return Fit::Partial;
+    const ResourceRange& cleared = pc.acc.front().access.range;
+    int own = 0;
+    for (const Tagged& t : acc) {
+      const ResourceRange& r = t.access.range;
+      if (!r.overlaps(cleared)) continue;
+      // The attachment's own write, once: any other access (a sample, a fetch, a resolve into it) is a use.
+      const bool mine = t.attachment && t.access.write && !t.access.pixelLocal && r.contains(cleared) && cleared.contains(r);
+      if (!mine || own++) return Fit::Partial;
+    }
+    return own == 1 ? Fit::Fuse : Fit::Partial;
+  }
+
+  // The render area of `desc` covers the whole mip of attachment `a` (0 x 0: the attachments' size).
+  bool coversMip(const RenderPassDesc& desc, const Attachment& a) const {
+    const TextureDesc* d = res_->get(a.texture);
+    if (!d) return false;
+    return (!desc.renderWidth && !desc.renderHeight) ||
+           (desc.renderWidth >= std::max(1u, d->width >> a.mip) && desc.renderHeight >= std::max(1u, d->height >> a.mip));
+  }
+
+  // A pass to hold back: no draws, one attachment, Clear + Store, no resolve, over the whole mip of a 1x texture
+  // that is not transient (the backend may allocate a transient one without memory, which a clear must not touch).
+  bool deferrable(const RenderPass& rp) const {
+    if (!res_ || !rp.draws.empty()) return false;
+    const Attachment* only = nullptr;
+    int n = 0;
+    forEachSlot(rp.desc, [&](const Attachment& a, int) {
+      if (a.texture) only = &a, ++n;
+    });
+    if (n != 1 || only->load != LoadAction::Clear || only->store != StoreAction::Store || only->resolve) return false;
+    const TextureDesc* d = res_->get(only->texture);
+    return d && d->samples == 1 && !d->transient && coversMip(rp.desc, *only);
+  }
+
+  // The clear becomes an encoder of its own, exactly as it would have been scheduled where it was recorded.
+  void materialize(PendingClear& pc) {
+    AccessList acc = pc.acc;
+    place(pc.cmd, *pc.rp, pc.rp->desc, acc);
+  }
+
+  void rebuildPending() {
+    pendingAcc_.clear();
+    for (const PendingClear& pc : pending_) pendingAcc_.append(pc.acc);
+  }
+
+  // Materialises the pending clears that a command touches (its program order after them is kept).
+  void flushTouched(const AccessList& acc) {
+    if (pending_.empty() || !touches(acc, pendingAcc_)) return;
+    for (size_t k = 0; k < pending_.size();) {
+      if (!touches(acc, pending_[k].idx)) {
+        ++k;
+        continue;
+      }
+      ++out_.stats.flushConflict;
+      materialize(pending_[k]);
+      pending_.erase(pending_.begin() + static_cast<std::ptrdiff_t>(k));
+    }
+    rebuildPending();
+  }
+
   // CompileStats::reorderable. Walks back from the newest encoder: the pass can only move up past encoders it
   // does not touch (and past the copies sunk after the open encoder).
   void countReorderable(const RenderPassDesc& desc, const RenderPassDesc& need, const AccessList& acc) {
@@ -474,6 +613,8 @@ class Scheduler {
   AccessIndex sunkAcc_;
   RenderPassDesc lastRender_;
   bool haveLastRender_ = false;
+  std::vector<PendingClear> pending_;  // CompileOptions::fuseClears, in program order
+  AccessIndex pendingAcc_;             // their accesses
 };
 
