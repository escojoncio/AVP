+// Fills every property structure of a vkGetPhysicalDeviceProperties2 chain this driver knows.
+void fillProperties2(void* chain) {
+  VkPhysicalDeviceVulkan11Properties p11{VK_STRUCTURE_TYPE_PHYSICAL_DEVICE_VULKAN_1_1_PROPERTIES};
+  VkPhysicalDeviceVulkan12Properties p12{VK_STRUCTURE_TYPE_PHYSICAL_DEVICE_VULKAN_1_2_PROPERTIES};
+  VkPhysicalDeviceVulkan13Properties p13{VK_STRUCTURE_TYPE_PHYSICAL_DEVICE_VULKAN_1_3_PROPERTIES};
+  fillProperties11(p11), fillProperties12(p12), fillProperties13(p13);
+  for (auto* s = static_cast<VkBaseOutStructure*>(chain); s; s = s->pNext) {
+    switch (s->sType) {
+      case VK_STRUCTURE_TYPE_PHYSICAL_DEVICE_VULKAN_1_1_PROPERTIES: {
+        auto* x = reinterpret_cast<VkPhysicalDeviceVulkan11Properties*>(s);
+        void* n = x->pNext;
+        *x = p11, x->pNext = n;
+        break;
+      }
+      case VK_STRUCTURE_TYPE_PHYSICAL_DEVICE_VULKAN_1_2_PROPERTIES: {
+        auto* x = reinterpret_cast<VkPhysicalDeviceVulkan12Properties*>(s);
+        void* n = x->pNext;
+        *x = p12, x->pNext = n;
+        break;
+      }
+      case VK_STRUCTURE_TYPE_PHYSICAL_DEVICE_VULKAN_1_3_PROPERTIES: {
+        auto* x = reinterpret_cast<VkPhysicalDeviceVulkan13Properties*>(s);
+        void* n = x->pNext;
+        *x = p13, x->pNext = n;
+        break;
+      }
+      case VK_STRUCTURE_TYPE_PHYSICAL_DEVICE_MULTIVIEW_PROPERTIES: {
+        auto* m = reinterpret_cast<VkPhysicalDeviceMultiviewProperties*>(s);
+        m->maxMultiviewViewCount = p11.maxMultiviewViewCount;
+        m->maxMultiviewInstanceIndex = p11.maxMultiviewInstanceIndex;
+        break;
+      }
+      case VK_STRUCTURE_TYPE_PHYSICAL_DEVICE_FRAGMENT_DENSITY_MAP_PROPERTIES_EXT: {
+        auto* f = reinterpret_cast<VkPhysicalDeviceFragmentDensityMapPropertiesEXT*>(s);
+        f->minFragmentDensityTexelSize = {32, 32};
+        f->maxFragmentDensityTexelSize = {32, 32};
+        f->fragmentDensityInvocations = VK_FALSE;
+        break;
+      }
+      case VK_STRUCTURE_TYPE_PHYSICAL_DEVICE_ID_PROPERTIES: {
+        auto* id = reinterpret_cast<VkPhysicalDeviceIDProperties*>(s);
+        std::memcpy(id->deviceUUID, p11.deviceUUID, VK_UUID_SIZE);
+        std::memcpy(id->driverUUID, p11.driverUUID, VK_UUID_SIZE);
+        std::memcpy(id->deviceLUID, p11.deviceLUID, VK_LUID_SIZE);
+        id->deviceNodeMask = p11.deviceNodeMask;
+        id->deviceLUIDValid = p11.deviceLUIDValid;
+        break;
+      }
+      case VK_STRUCTURE_TYPE_PHYSICAL_DEVICE_MAINTENANCE_3_PROPERTIES: {
+        auto* m = reinterpret_cast<VkPhysicalDeviceMaintenance3Properties*>(s);
+        m->maxPerSetDescriptors = p11.maxPerSetDescriptors;
+        m->maxMemoryAllocationSize = p11.maxMemoryAllocationSize;
+        break;
+      }
+      case VK_STRUCTURE_TYPE_PHYSICAL_DEVICE_MAINTENANCE_4_PROPERTIES:
+        reinterpret_cast<VkPhysicalDeviceMaintenance4Properties*>(s)->maxBufferSize = p13.maxBufferSize;
+        break;
+      case VK_STRUCTURE_TYPE_PHYSICAL_DEVICE_SUBGROUP_PROPERTIES: {
+        auto* sg = reinterpret_cast<VkPhysicalDeviceSubgroupProperties*>(s);
+        sg->subgroupSize = p11.subgroupSize;
+        sg->supportedStages = p11.subgroupSupportedStages;
+        sg->supportedOperations = p11.subgroupSupportedOperations;
+        sg->quadOperationsInAllStages = p11.subgroupQuadOperationsInAllStages;
+        break;
+      }
+      case VK_STRUCTURE_TYPE_PHYSICAL_DEVICE_POINT_CLIPPING_PROPERTIES:
+        reinterpret_cast<VkPhysicalDevicePointClippingProperties*>(s)->pointClippingBehavior = p11.pointClippingBehavior;
+        break;
+      case VK_STRUCTURE_TYPE_PHYSICAL_DEVICE_DRIVER_PROPERTIES: {
+        auto* x = reinterpret_cast<VkPhysicalDeviceDriverProperties*>(s);
+        x->driverID = p12.driverID;
+        std::memcpy(x->driverName, p12.driverName, sizeof x->driverName);
+        std::memcpy(x->driverInfo, p12.driverInfo, sizeof x->driverInfo);
+        x->conformanceVersion = p12.conformanceVersion;
+        break;
+      }
+      case VK_STRUCTURE_TYPE_PHYSICAL_DEVICE_DEPTH_STENCIL_RESOLVE_PROPERTIES: {
+        auto* x = reinterpret_cast<VkPhysicalDeviceDepthStencilResolveProperties*>(s);
+        x->supportedDepthResolveModes = p12.supportedDepthResolveModes;
+        x->supportedStencilResolveModes = p12.supportedStencilResolveModes;
+        x->independentResolveNone = p12.independentResolveNone;
+        x->independentResolve = p12.independentResolve;
+        break;
+      }
+      case VK_STRUCTURE_TYPE_PHYSICAL_DEVICE_TIMELINE_SEMAPHORE_PROPERTIES:
+        reinterpret_cast<VkPhysicalDeviceTimelineSemaphoreProperties*>(s)->maxTimelineSemaphoreValueDifference =
+            p12.maxTimelineSemaphoreValueDifference;
+        break;
+      case VK_STRUCTURE_TYPE_PHYSICAL_DEVICE_SUBGROUP_SIZE_CONTROL_PROPERTIES: {
+        auto* x = reinterpret_cast<VkPhysicalDeviceSubgroupSizeControlProperties*>(s);
+        x->minSubgroupSize = p13.minSubgroupSize, x->maxSubgroupSize = p13.maxSubgroupSize;
+        x->maxComputeWorkgroupSubgroups = p13.maxComputeWorkgroupSubgroups;
+        x->requiredSubgroupSizeStages = p13.requiredSubgroupSizeStages;
+        break;
+      }
+      case VK_STRUCTURE_TYPE_PHYSICAL_DEVICE_FLOAT_CONTROLS_PROPERTIES: {
+        auto* x = reinterpret_cast<VkPhysicalDeviceFloatControlsProperties*>(s);
+        x->denormBehaviorIndependence = p12.denormBehaviorIndependence;
+        x->roundingModeIndependence = p12.roundingModeIndependence;
+        x->shaderRoundingModeRTEFloat32 = p12.shaderRoundingModeRTEFloat32;
+        x->shaderRoundingModeRTEFloat16 = p12.shaderRoundingModeRTEFloat16;
+        break;
+      }
+      default: fillExtensionProperties(s); break;
+    }
+  }
+}
