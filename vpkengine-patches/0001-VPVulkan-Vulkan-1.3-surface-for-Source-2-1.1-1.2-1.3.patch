+// Property structures of extensions outside core 1.3.
+void fillExtensionProperties(VkBaseOutStructure*) {}
+
+bool hasDeviceExtension(const char* name) {
+  for (const VkExtensionProperties& e : deviceExtensions())
+    if (!std::strcmp(e.extensionName, name)) return true;
+  return false;
+}
