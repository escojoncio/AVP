+// What the driver really does, per Vulkan 1.1/1.2/1.3 feature (VK_FALSE = not implemented; a 1.3
+// device is expected to have some of these, which is noted where they are missing).
+void fillFeatures11(VkPhysicalDeviceVulkan11Features& f) {
+  f.storageBuffer16BitAccess = f.uniformAndStorageBuffer16BitAccess = f.storagePushConstant16 = VK_FALSE;
+  f.storageInputOutput16 = VK_FALSE;
+  f.multiview = VK_TRUE;
+  f.multiviewGeometryShader = f.multiviewTessellationShader = VK_FALSE;
+  f.variablePointersStorageBuffer = f.variablePointers = VK_FALSE;
+  f.protectedMemory = VK_FALSE;
+  f.samplerYcbcrConversion = VK_FALSE;
+  f.shaderDrawParameters = VK_FALSE;  // BaseVertex/BaseInstance/DrawIndex builtins: not lowered
+}
+
+void fillFeatures12(VkPhysicalDeviceVulkan12Features& f) {
+  void* next = f.pNext;
+  const VkStructureType t = f.sType;
+  f = {};
+  f.sType = t, f.pNext = next;
+  f.samplerMirrorClampToEdge = VK_TRUE;
+  f.descriptorIndexing = VK_FALSE;  // dynamically indexed descriptor arrays: not lowered yet
+  f.scalarBlockLayout = VK_TRUE;    // the translator honours every explicit Offset/ArrayStride
+  f.imagelessFramebuffer = VK_TRUE;
+  f.uniformBufferStandardLayout = VK_TRUE;
+  f.separateDepthStencilLayouts = VK_TRUE;  // layouts are not tracked at all
+  f.hostQueryReset = VK_TRUE;
+  f.timelineSemaphore = VK_TRUE;
+  f.shaderOutputLayer = VK_FALSE;
+  f.subgroupBroadcastDynamicId = VK_TRUE;
+}
+
+void fillFeatures13(VkPhysicalDeviceVulkan13Features& f) {
+  void* next = f.pNext;
+  const VkStructureType t = f.sType;
+  f = {};
+  f.sType = t, f.pNext = next;
+  f.pipelineCreationCacheControl = VK_TRUE;
+  f.privateData = VK_TRUE;
+  f.shaderDemoteToHelperInvocation = VK_TRUE;
+  f.shaderTerminateInvocation = VK_TRUE;
+  f.subgroupSizeControl = VK_TRUE;  // one size: 32
+  f.computeFullSubgroups = VK_TRUE;
+  f.synchronization2 = VK_TRUE;
+  f.dynamicRendering = VK_TRUE;
+  f.maintenance4 = VK_TRUE;
+  // Not implemented: robustImageAccess, inlineUniformBlock, textureCompressionASTC_HDR,
+  // shaderZeroInitializeWorkgroupMemory, shaderIntegerDotProduct.
+}
+
+void fillProperties11(VkPhysicalDeviceVulkan11Properties& p) {
+  const VkPhysicalDeviceProperties& d = deviceProperties();
+  std::memcpy(p.deviceUUID, d.pipelineCacheUUID, VK_UUID_SIZE);
+  std::memcpy(p.driverUUID, d.pipelineCacheUUID, VK_UUID_SIZE);
+  static const uint8_t luid[VK_LUID_SIZE] = {'V', 'P', 'V', 'K', 0, 0, 0, 1};
+  std::memcpy(p.deviceLUID, luid, VK_LUID_SIZE);
+  p.deviceNodeMask = 1;
+  p.deviceLUIDValid = VK_TRUE;
+  p.subgroupSize = 32;  // Apple SIMD-group width
+  p.subgroupSupportedStages = VK_SHADER_STAGE_FRAGMENT_BIT | VK_SHADER_STAGE_COMPUTE_BIT;
+  p.subgroupSupportedOperations = VK_SUBGROUP_FEATURE_BASIC_BIT | VK_SUBGROUP_FEATURE_VOTE_BIT | VK_SUBGROUP_FEATURE_BALLOT_BIT;
+  p.subgroupQuadOperationsInAllStages = VK_FALSE;
+  p.pointClippingBehavior = VK_POINT_CLIPPING_BEHAVIOR_ALL_CLIP_PLANES;
+  p.maxMultiviewViewCount = 2;  // Metal vertex amplification: 2 on Apple GPUs
+  p.maxMultiviewInstanceIndex = (1u << 27) - 1;
+  p.protectedNoFault = VK_FALSE;
+  p.maxPerSetDescriptors = 1024;
+  p.maxMemoryAllocationSize = 1ull << 32;
+}
+
+void fillProperties12(VkPhysicalDeviceVulkan12Properties& p) {
+  p.driverID = VK_DRIVER_ID_QUALCOMM_PROPRIETARY;  // matches the Adreno identity of the device
+  std::strncpy(p.driverName, "VPVulkan", VK_MAX_DRIVER_NAME_SIZE - 1);
+  std::strncpy(p.driverInfo, "VPEngine Vulkan on Metal", VK_MAX_DRIVER_INFO_SIZE - 1);
+  p.conformanceVersion = {1, 3, 0, 0};
+  p.denormBehaviorIndependence = VK_SHADER_FLOAT_CONTROLS_INDEPENDENCE_ALL;
+  p.roundingModeIndependence = VK_SHADER_FLOAT_CONTROLS_INDEPENDENCE_ALL;
+  p.shaderSignedZeroInfNanPreserveFloat32 = VK_FALSE;  // fast math
+  p.shaderRoundingModeRTEFloat32 = VK_TRUE;
+  p.shaderRoundingModeRTEFloat16 = VK_TRUE;
+  const VkPhysicalDeviceLimits& l = deviceProperties().limits;
+  p.maxUpdateAfterBindDescriptorsInAllPools = 0;
+  p.maxPerStageDescriptorUpdateAfterBindSamplers = l.maxPerStageDescriptorSamplers;
+  p.maxPerStageDescriptorUpdateAfterBindUniformBuffers = l.maxPerStageDescriptorUniformBuffers;
+  p.maxPerStageDescriptorUpdateAfterBindStorageBuffers = l.maxPerStageDescriptorStorageBuffers;
+  p.maxPerStageDescriptorUpdateAfterBindSampledImages = l.maxPerStageDescriptorSampledImages;
+  p.maxPerStageDescriptorUpdateAfterBindStorageImages = l.maxPerStageDescriptorStorageImages;
+  p.maxPerStageDescriptorUpdateAfterBindInputAttachments = l.maxPerStageDescriptorInputAttachments;
+  p.maxPerStageUpdateAfterBindResources = l.maxPerStageResources;
+  p.maxDescriptorSetUpdateAfterBindSamplers = l.maxDescriptorSetSamplers;
+  p.maxDescriptorSetUpdateAfterBindUniformBuffers = l.maxDescriptorSetUniformBuffers;
+  p.maxDescriptorSetUpdateAfterBindUniformBuffersDynamic = l.maxDescriptorSetUniformBuffersDynamic;
+  p.maxDescriptorSetUpdateAfterBindStorageBuffers = l.maxDescriptorSetStorageBuffers;
+  p.maxDescriptorSetUpdateAfterBindStorageBuffersDynamic = l.maxDescriptorSetStorageBuffersDynamic;
+  p.maxDescriptorSetUpdateAfterBindSampledImages = l.maxDescriptorSetSampledImages;
+  p.maxDescriptorSetUpdateAfterBindStorageImages = l.maxDescriptorSetStorageImages;
+  p.maxDescriptorSetUpdateAfterBindInputAttachments = l.maxDescriptorSetInputAttachments;
+  // Metal resolves depth with sample 0, min or max, and stencil with sample 0.
+  p.supportedDepthResolveModes = VK_RESOLVE_MODE_SAMPLE_ZERO_BIT | VK_RESOLVE_MODE_MIN_BIT | VK_RESOLVE_MODE_MAX_BIT;
+  p.supportedStencilResolveModes = VK_RESOLVE_MODE_SAMPLE_ZERO_BIT;
+  p.independentResolveNone = VK_TRUE;
+  p.independentResolve = VK_TRUE;
+  p.maxTimelineSemaphoreValueDifference = ~0ull >> 1;
+  p.framebufferIntegerColorSampleCounts = VK_SAMPLE_COUNT_1_BIT;
+}
+
+void fillProperties13(VkPhysicalDeviceVulkan13Properties& p) {
+  p.minSubgroupSize = p.maxSubgroupSize = 32;
+  p.maxComputeWorkgroupSubgroups = 32;
+  p.requiredSubgroupSizeStages = VK_SHADER_STAGE_COMPUTE_BIT;
+  p.storageTexelBufferOffsetAlignmentBytes = 64;
+  p.uniformTexelBufferOffsetAlignmentBytes = 64;
+  p.storageTexelBufferOffsetSingleTexelAlignment = VK_FALSE;
+  p.uniformTexelBufferOffsetSingleTexelAlignment = VK_FALSE;
+  p.maxBufferSize = 1ull << 32;
+}
