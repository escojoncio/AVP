+// Features a game enables that the driver does not have. Vulkan says vkCreateDevice fails then;
+// games built against desktop drivers enable what they saw on the capture machine without checking
+// (Alyx: tessellationShader, depthBounds, multiViewport, shaderInt64...), so they are logged, one
+// line per name, and the device is created: what the game then really uses fails visibly at
+// pipeline creation (vk.err what=shader / what=stage) instead of the whole game refusing to start.
+// VkPhysicalDeviceFeatures members in declaration order (log names).
+const char* const kCoreFeatureNames[] = {
+    "robustBufferAccess", "fullDrawIndexUint32", "imageCubeArray", "independentBlend", "geometryShader",
+    "tessellationShader", "sampleRateShading", "dualSrcBlend", "logicOp", "multiDrawIndirect",
+    "drawIndirectFirstInstance", "depthClamp", "depthBiasClamp", "fillModeNonSolid", "depthBounds", "wideLines",
+    "largePoints", "alphaToOne", "multiViewport", "samplerAnisotropy", "textureCompressionETC2",
+    "textureCompressionASTC_LDR", "textureCompressionBC", "occlusionQueryPrecise", "pipelineStatisticsQuery",
+    "vertexPipelineStoresAndAtomics", "fragmentStoresAndAtomics", "shaderTessellationAndGeometryPointSize",
+    "shaderImageGatherExtended", "shaderStorageImageExtendedFormats", "shaderStorageImageMultisample",
+    "shaderStorageImageReadWithoutFormat", "shaderStorageImageWriteWithoutFormat",
+    "shaderUniformBufferArrayDynamicIndexing", "shaderSampledImageArrayDynamicIndexing",
+    "shaderStorageBufferArrayDynamicIndexing", "shaderStorageImageArrayDynamicIndexing", "shaderClipDistance",
+    "shaderCullDistance", "shaderFloat64", "shaderInt64", "shaderInt16", "shaderResourceResidency",
+    "shaderResourceMinLod", "sparseBinding", "sparseResidencyBuffer", "sparseResidencyImage2D",
+    "sparseResidencyImage3D", "sparseResidency2Samples", "sparseResidency4Samples", "sparseResidency8Samples",
+    "sparseResidency16Samples", "sparseResidencyAliased", "variableMultisampleRate", "inheritedQueries"};
+static_assert(sizeof kCoreFeatureNames / sizeof *kCoreFeatureNames == sizeof(VkPhysicalDeviceFeatures) / sizeof(VkBool32));
+
+template <class T>
+void diffBools(const char* group, const T& want, const T& have, size_t firstBool) {
+  const auto* w = reinterpret_cast<const VkBool32*>(reinterpret_cast<const uint8_t*>(&want) + firstBool);
+  const auto* h = reinterpret_cast<const VkBool32*>(reinterpret_cast<const uint8_t*>(&have) + firstBool);
+  const size_t n = (sizeof(T) - firstBool) / sizeof(VkBool32);
+  for (size_t i = 0; i < n; ++i)
+    if (w[i] && !h[i]) {
+      if (!std::strcmp(group, "core")) logf("vk.feature unsupported_enabled=%s", kCoreFeatureNames[i]);
+      else logf("vk.feature unsupported_enabled=%s[%zu]", group, i);
+    }
+}
+
+void logUnsupportedFeatures(const VkDeviceCreateInfo& ci) {
+  VkPhysicalDeviceFeatures have;
+  haveFeatures(&have);
+  if (ci.pEnabledFeatures) diffBools("core", *ci.pEnabledFeatures, have, 0);
+  VkPhysicalDeviceVulkan11Features h11{VK_STRUCTURE_TYPE_PHYSICAL_DEVICE_VULKAN_1_1_FEATURES};
+  VkPhysicalDeviceVulkan12Features h12{VK_STRUCTURE_TYPE_PHYSICAL_DEVICE_VULKAN_1_2_FEATURES};
+  VkPhysicalDeviceVulkan13Features h13{VK_STRUCTURE_TYPE_PHYSICAL_DEVICE_VULKAN_1_3_FEATURES};
+  h11.pNext = &h12, h12.pNext = &h13;
+  fillFeatures2(&h11);
+  constexpr size_t head = offsetof(VkPhysicalDeviceVulkan11Features, storageBuffer16BitAccess);
+  for (auto* s = static_cast<const VkBaseInStructure*>(ci.pNext); s; s = s->pNext) {
+    switch (s->sType) {
+      case VK_STRUCTURE_TYPE_PHYSICAL_DEVICE_FEATURES_2:
+        diffBools("core", reinterpret_cast<const VkPhysicalDeviceFeatures2*>(s)->features, have, 0);
+        break;
+      case VK_STRUCTURE_TYPE_PHYSICAL_DEVICE_VULKAN_1_1_FEATURES:
+        diffBools("v11", *reinterpret_cast<const VkPhysicalDeviceVulkan11Features*>(s), h11, head);
+        break;
+      case VK_STRUCTURE_TYPE_PHYSICAL_DEVICE_VULKAN_1_2_FEATURES:
+        diffBools("v12", *reinterpret_cast<const VkPhysicalDeviceVulkan12Features*>(s), h12, head);
+        break;
+      case VK_STRUCTURE_TYPE_PHYSICAL_DEVICE_VULKAN_1_3_FEATURES:
+        diffBools("v13", *reinterpret_cast<const VkPhysicalDeviceVulkan13Features*>(s), h13, head);
+        break;
+      default: break;  // per-extension feature structs: every one listed by fillFeatures2 is honoured
+    }
+  }
+}
+
 }  // namespace
 }  // namespace vpvk
 
