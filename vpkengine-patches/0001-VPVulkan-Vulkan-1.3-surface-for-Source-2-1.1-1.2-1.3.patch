+// ---- Source 2 (Half-Life: Alyx) surface ----------------------------------------------------------
+// The device Alyx creates (its own capture on Apple silicon: extensions, features, Vulkan 1.1-1.3
+// feature structs) must be accepted, and what it reads back must be the 1.3 the driver implements.
+const char* const kAlyxExts[] = {
+    "VK_KHR_descriptor_update_template", "VK_KHR_image_format_list", "VK_KHR_maintenance1", "VK_KHR_maintenance2",
+    "VK_EXT_separate_stencil_usage", "VK_KHR_swapchain_mutable_format", "VK_KHR_dynamic_rendering",
+    "VK_KHR_dynamic_rendering_local_read", "VK_KHR_depth_stencil_resolve", "VK_KHR_create_renderpass2",
+    "VK_EXT_host_image_copy", "VK_KHR_multiview"};
+
+// Extensions of the capture not implemented yet (emptied as they land).
+const std::vector<std::string> kAlyxPending = {"VK_KHR_dynamic_rendering_local_read", "VK_EXT_host_image_copy"};
+bool pending(const char* e) {
+  for (const auto& p : kAlyxPending)
+    if (p == e) return true;
+  return false;
+}
+
+VkDevice alyxDevice(VkPhysicalDevice pd, uint32_t nExt) {
+  VkPhysicalDeviceFeatures2 f2{VK_STRUCTURE_TYPE_PHYSICAL_DEVICE_FEATURES_2};
+  f2.features.tessellationShader = VK_TRUE;  // enabled by Alyx, not supported: logged, not refused
+  f2.features.shaderInt64 = VK_TRUE;
+  VkPhysicalDeviceVulkan11Features f11{VK_STRUCTURE_TYPE_PHYSICAL_DEVICE_VULKAN_1_1_FEATURES};
+  f11.multiview = VK_TRUE;
+  VkPhysicalDeviceVulkan12Features f12{VK_STRUCTURE_TYPE_PHYSICAL_DEVICE_VULKAN_1_2_FEATURES};
+  f12.timelineSemaphore = VK_TRUE;
+  VkPhysicalDeviceVulkan13Features f13{VK_STRUCTURE_TYPE_PHYSICAL_DEVICE_VULKAN_1_3_FEATURES};
+  f13.dynamicRendering = f13.synchronization2 = VK_TRUE;
+  f2.pNext = &f11, f11.pNext = &f12, f12.pNext = &f13;
+  float prio = 1;
+  VkDeviceQueueCreateInfo q{VK_STRUCTURE_TYPE_DEVICE_QUEUE_CREATE_INFO};
+  q.queueCount = 1;
+  q.pQueuePriorities = &prio;
+  VkDeviceCreateInfo d{VK_STRUCTURE_TYPE_DEVICE_CREATE_INFO, &f2};
+  d.queueCreateInfoCount = 1;
+  d.pQueueCreateInfos = &q;
+  std::vector<const char*> exts;
+  for (uint32_t i = 0; i < nExt; ++i)
+    if (!pending(kAlyxExts[i])) exts.push_back(kAlyxExts[i]);
+  d.enabledExtensionCount = uint32_t(exts.size());
+  d.ppEnabledExtensionNames = exts.data();
+  VkDevice dev = nullptr;
+  return vkCreateDevice(pd, &d, nullptr, &dev) == VK_SUCCESS ? dev : nullptr;
+}
+
+void testAlyxSurface() {
+  Ctx c;
+  uint32_t v = 0;
+  vkEnumerateInstanceVersion(&v);
+  CHECK(v >= VK_API_VERSION_1_3);
+  VkPhysicalDeviceProperties p;
+  vkGetPhysicalDeviceProperties(c.pd, &p);
+  CHECK(VK_API_VERSION_MINOR(p.apiVersion) == 3);
+  CHECK(p.limits.maxPerStageDescriptorSamplers >= 17);  // Alyx's largest set
+  VkPhysicalDeviceVulkan11Features f11{VK_STRUCTURE_TYPE_PHYSICAL_DEVICE_VULKAN_1_1_FEATURES};
+  VkPhysicalDeviceVulkan12Features f12{VK_STRUCTURE_TYPE_PHYSICAL_DEVICE_VULKAN_1_2_FEATURES, &f11};
+  VkPhysicalDeviceVulkan13Features f13{VK_STRUCTURE_TYPE_PHYSICAL_DEVICE_VULKAN_1_3_FEATURES, &f12};
+  VkPhysicalDeviceDynamicRenderingLocalReadFeaturesKHR lr{VK_STRUCTURE_TYPE_PHYSICAL_DEVICE_DYNAMIC_RENDERING_LOCAL_READ_FEATURES_KHR, &f13};
+  VkPhysicalDeviceHostImageCopyFeaturesEXT hic{VK_STRUCTURE_TYPE_PHYSICAL_DEVICE_HOST_IMAGE_COPY_FEATURES_EXT, &lr};
+  VkPhysicalDeviceFeatures2 f{VK_STRUCTURE_TYPE_PHYSICAL_DEVICE_FEATURES_2, &hic};
+  vkGetPhysicalDeviceFeatures2(c.pd, &f);
+  CHECK(f11.multiview && f13.dynamicRendering && f12.timelineSemaphore && f13.synchronization2);
+  CHECK(f13.pNext == &f12 && f12.pNext == &f11);  // chain left intact
+  VkPhysicalDeviceDepthStencilResolveProperties dsr{VK_STRUCTURE_TYPE_PHYSICAL_DEVICE_DEPTH_STENCIL_RESOLVE_PROPERTIES};
+  VkPhysicalDeviceVulkan12Properties p12{VK_STRUCTURE_TYPE_PHYSICAL_DEVICE_VULKAN_1_2_PROPERTIES, &dsr};
+  VkPhysicalDeviceVulkan11Properties p11{VK_STRUCTURE_TYPE_PHYSICAL_DEVICE_VULKAN_1_1_PROPERTIES, &p12};
+  VkPhysicalDeviceProperties2 p2{VK_STRUCTURE_TYPE_PHYSICAL_DEVICE_PROPERTIES_2, &p11};
+  vkGetPhysicalDeviceProperties2(c.pd, &p2);
+  CHECK(p11.maxMultiviewViewCount == 2 && p11.subgroupSize == 32);
+  CHECK(dsr.supportedDepthResolveModes & VK_RESOLVE_MODE_SAMPLE_ZERO_BIT);
+  CHECK(p12.supportedDepthResolveModes == dsr.supportedDepthResolveModes && std::strlen(p12.driverName) > 0);
+  // Every extension of the capture is advertised; the swapchain itself stays the host layer's.
+  uint32_t n = 0;
+  vkEnumerateDeviceExtensionProperties(c.pd, nullptr, &n, nullptr);
+  std::vector<VkExtensionProperties> e(n);
+  vkEnumerateDeviceExtensionProperties(c.pd, nullptr, &n, e.data());
+  for (const char* want : kAlyxExts) {
+    if (pending(want)) continue;
+    bool found = false;
+    for (const auto& x : e) found |= !std::strcmp(x.extensionName, want);
+    if (!found) std::printf("  not advertised: %s\n", want);
+    CHECK(found);
+  }
+  VkDevice dev = alyxDevice(c.pd, sizeof kAlyxExts / sizeof *kAlyxExts);
+  CHECK(dev != nullptr);
+  if (dev) vkDestroyDevice(dev, nullptr);
+  // Format list + mutable format: views in the listed format; stencil usage merged in.
+  VkFormat list[2] = {VK_FORMAT_R8G8B8A8_UNORM, VK_FORMAT_R8G8B8A8_SRGB};
+  VkImageFormatListCreateInfo fl{VK_STRUCTURE_TYPE_IMAGE_FORMAT_LIST_CREATE_INFO};
+  fl.viewFormatCount = 2, fl.pViewFormats = list;
+  VkImageCreateInfo ii{VK_STRUCTURE_TYPE_IMAGE_CREATE_INFO, &fl};
+  ii.flags = VK_IMAGE_CREATE_MUTABLE_FORMAT_BIT;
+  ii.imageType = VK_IMAGE_TYPE_2D, ii.format = VK_FORMAT_R8G8B8A8_UNORM, ii.extent = {64, 64, 1};
+  ii.mipLevels = ii.arrayLayers = 1, ii.samples = VK_SAMPLE_COUNT_1_BIT;
+  ii.usage = VK_IMAGE_USAGE_COLOR_ATTACHMENT_BIT | VK_IMAGE_USAGE_SAMPLED_BIT;
+  VkImage im;
+  CHECK(vkCreateImage(c.dev, &ii, nullptr, &im) == VK_SUCCESS && from<Image>(im)->desc.mutableFormat);
+  vkDestroyImage(c.dev, im, nullptr);
+  VkImageStencilUsageCreateInfo su{VK_STRUCTURE_TYPE_IMAGE_STENCIL_USAGE_CREATE_INFO};
+  su.stencilUsage = VK_IMAGE_USAGE_SAMPLED_BIT;
+  ii.pNext = &su, ii.flags = 0, ii.format = VK_FORMAT_D32_SFLOAT_S8_UINT;
+  ii.usage = VK_IMAGE_USAGE_DEPTH_STENCIL_ATTACHMENT_BIT;
+  CHECK(vkCreateImage(c.dev, &ii, nullptr, &im) == VK_SUCCESS);
+  CHECK(from<Image>(im)->desc.usage & vpgpu::usage::sampled);
+  vkDestroyImage(c.dev, im, nullptr);
+  VkFormatProperties3 fp3{VK_STRUCTURE_TYPE_FORMAT_PROPERTIES_3};
+  VkFormatProperties2 fp2{VK_STRUCTURE_TYPE_FORMAT_PROPERTIES_2, &fp3};
+  vkGetPhysicalDeviceFormatProperties2(c.pd, VK_FORMAT_D32_SFLOAT_S8_UINT, &fp2);
+  CHECK(fp3.optimalTilingFeatures & VK_FORMAT_FEATURE_2_SAMPLED_IMAGE_DEPTH_COMPARISON_BIT);
+}
+
+// Depth/stencil resolve: render pass 2 (VkSubpassDescriptionDepthStencilResolve) and dynamic
+// rendering both resolve the 4x depth attachment into the 1x target with the requested filter.
+void testDepthResolve() {
+  Ctx c;
+  VkDeviceMemory m = alloc(c, 32 << 20, 0);
+  auto make = [&](VkFormat f, VkSampleCountFlagBits s, VkImageUsageFlags u) {
+    VkImageCreateInfo ii{VK_STRUCTURE_TYPE_IMAGE_CREATE_INFO};
+    ii.imageType = VK_IMAGE_TYPE_2D, ii.format = f, ii.extent = {128, 128, 1};
+    ii.mipLevels = ii.arrayLayers = 1, ii.samples = s, ii.usage = u;
+    VkImage i;
+    vkCreateImage(c.dev, &ii, nullptr, &i);
+    vkBindImageMemory(c.dev, i, m, 0);
+    VkImageViewCreateInfo vi{VK_STRUCTURE_TYPE_IMAGE_VIEW_CREATE_INFO};
+    vi.image = i, vi.viewType = VK_IMAGE_VIEW_TYPE_2D, vi.format = f;
+    vi.subresourceRange = {VK_IMAGE_ASPECT_DEPTH_BIT, 0, 1, 0, 1};
+    VkImageView v;
+    vkCreateImageView(c.dev, &vi, nullptr, &v);
+    return std::make_pair(i, v);
+  };
+  auto [ms, msv] = make(VK_FORMAT_D32_SFLOAT, VK_SAMPLE_COUNT_4_BIT, VK_IMAGE_USAGE_DEPTH_STENCIL_ATTACHMENT_BIT);
+  auto [ss, ssv] = make(VK_FORMAT_D32_SFLOAT, VK_SAMPLE_COUNT_1_BIT,
+                        VK_IMAGE_USAGE_DEPTH_STENCIL_ATTACHMENT_BIT | VK_IMAGE_USAGE_SAMPLED_BIT);
+  VkAttachmentDescription2 att[2]{{VK_STRUCTURE_TYPE_ATTACHMENT_DESCRIPTION_2}, {VK_STRUCTURE_TYPE_ATTACHMENT_DESCRIPTION_2}};
+  att[0].format = att[1].format = VK_FORMAT_D32_SFLOAT;
+  att[0].samples = VK_SAMPLE_COUNT_4_BIT, att[1].samples = VK_SAMPLE_COUNT_1_BIT;
+  att[0].loadOp = VK_ATTACHMENT_LOAD_OP_CLEAR, att[0].storeOp = VK_ATTACHMENT_STORE_OP_DONT_CARE;
+  att[1].loadOp = VK_ATTACHMENT_LOAD_OP_DONT_CARE, att[1].storeOp = VK_ATTACHMENT_STORE_OP_STORE;
+  VkAttachmentReference2 dref{VK_STRUCTURE_TYPE_ATTACHMENT_REFERENCE_2}, rref{VK_STRUCTURE_TYPE_ATTACHMENT_REFERENCE_2};
+  dref.attachment = 0, rref.attachment = 1;
+  VkSubpassDescriptionDepthStencilResolve dr{VK_STRUCTURE_TYPE_SUBPASS_DESCRIPTION_DEPTH_STENCIL_RESOLVE};
+  dr.depthResolveMode = VK_RESOLVE_MODE_MAX_BIT;
+  dr.pDepthStencilResolveAttachment = &rref;
+  VkSubpassDescription2 sp{VK_STRUCTURE_TYPE_SUBPASS_DESCRIPTION_2, &dr};
+  sp.pDepthStencilAttachment = &dref;
+  VkRenderPassCreateInfo2 rpi{VK_STRUCTURE_TYPE_RENDER_PASS_CREATE_INFO_2};
+  rpi.attachmentCount = 2, rpi.pAttachments = att, rpi.subpassCount = 1, rpi.pSubpasses = &sp;
+  VkRenderPass rp;
+  vkCreateRenderPass2(c.dev, &rpi, nullptr, &rp);
+  VkImageView fbv[2] = {msv, ssv};
+  VkFramebufferCreateInfo fi{VK_STRUCTURE_TYPE_FRAMEBUFFER_CREATE_INFO};
+  fi.renderPass = rp, fi.attachmentCount = 2, fi.pAttachments = fbv, fi.width = fi.height = 128, fi.layers = 1;
+  VkFramebuffer fb;
+  vkCreateFramebuffer(c.dev, &fi, nullptr, &fb);
+  VkCommandPoolCreateInfo pi{VK_STRUCTURE_TYPE_COMMAND_POOL_CREATE_INFO};
+  VkCommandPool pool;
+  vkCreateCommandPool(c.dev, &pi, nullptr, &pool);
+  VkCommandBufferAllocateInfo ai{VK_STRUCTURE_TYPE_COMMAND_BUFFER_ALLOCATE_INFO};
+  ai.commandPool = pool, ai.commandBufferCount = 1;
+  VkCommandBuffer cb;
+  vkAllocateCommandBuffers(c.dev, &ai, &cb);
+  VkCommandBufferBeginInfo bi{VK_STRUCTURE_TYPE_COMMAND_BUFFER_BEGIN_INFO};
+  vkBeginCommandBuffer(cb, &bi);
+  VkClearValue cv{};
+  VkRenderPassBeginInfo rb{VK_STRUCTURE_TYPE_RENDER_PASS_BEGIN_INFO};
+  rb.renderPass = rp, rb.framebuffer = fb, rb.renderArea = {{0, 0}, {128, 128}}, rb.clearValueCount = 1, rb.pClearValues = &cv;
+  vkCmdBeginRenderPass(cb, &rb, VK_SUBPASS_CONTENTS_INLINE);
+  vkCmdEndRenderPass(cb);
+  // Same through dynamic rendering, MIN filter.
+  VkRenderingAttachmentInfo da{VK_STRUCTURE_TYPE_RENDERING_ATTACHMENT_INFO};
+  da.imageView = msv, da.loadOp = VK_ATTACHMENT_LOAD_OP_CLEAR, da.storeOp = VK_ATTACHMENT_STORE_OP_DONT_CARE;
+  da.resolveMode = VK_RESOLVE_MODE_MIN_BIT, da.resolveImageView = ssv;
+  VkRenderingInfo ri{VK_STRUCTURE_TYPE_RENDERING_INFO};
+  ri.renderArea = {{0, 0}, {128, 128}}, ri.layerCount = 1, ri.pDepthAttachment = &da;
+  vkCmdBeginRendering(cb, &ri);
+  vkCmdEndRendering(cb);
+  vkEndCommandBuffer(cb);
+  vpgpu::Frame frame;
+  TranslateStats st;
+  translate(*from<CommandBuffer>(cb)->rec, frame, st);
+  CHECK(frame.commands().size() == 2 && st.dropped == 0);
+  if (frame.commands().size() == 2) {
+    const auto& a = std::get<vpgpu::RenderPass>(frame.commands()[0]).desc.depth;
+    CHECK(a.resolve == from<Image>(ss)->id && a.store == vpgpu::StoreAction::Resolve &&
+          a.depthResolve == vpgpu::Attachment::DepthResolve::Max);
+    const auto& b = std::get<vpgpu::RenderPass>(frame.commands()[1]).desc.depth;
+    CHECK(b.resolve == from<Image>(ss)->id && b.store == vpgpu::StoreAction::Resolve &&
+          b.depthResolve == vpgpu::Attachment::DepthResolve::Min);
+  }
+  vkDestroyCommandPool(c.dev, pool, nullptr);
+  vkDestroyFramebuffer(c.dev, fb, nullptr);
+  vkDestroyRenderPass(c.dev, rp, nullptr);
+  for (VkImageView v : fbv) vkDestroyImageView(c.dev, v, nullptr);
+  vkDestroyImage(c.dev, ms, nullptr);
+  vkDestroyImage(c.dev, ss, nullptr);
+  vkFreeMemory(c.dev, m, nullptr);
+}
