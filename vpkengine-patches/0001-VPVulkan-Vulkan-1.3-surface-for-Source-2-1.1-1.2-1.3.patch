+// Fills every feature structure of a vkGetPhysicalDeviceFeatures2 chain this driver knows.
+void fillFeatures2(void* chain) {
+  VkPhysicalDeviceVulkan11Features f11{VK_STRUCTURE_TYPE_PHYSICAL_DEVICE_VULKAN_1_1_FEATURES};
+  VkPhysicalDeviceVulkan12Features f12{VK_STRUCTURE_TYPE_PHYSICAL_DEVICE_VULKAN_1_2_FEATURES};
+  VkPhysicalDeviceVulkan13Features f13{VK_STRUCTURE_TYPE_PHYSICAL_DEVICE_VULKAN_1_3_FEATURES};
+  fillFeatures11(f11), fillFeatures12(f12), fillFeatures13(f13);
+  for (auto* s = static_cast<VkBaseOutStructure*>(chain); s; s = s->pNext) {
+    switch (s->sType) {
+      case VK_STRUCTURE_TYPE_PHYSICAL_DEVICE_VULKAN_1_1_FEATURES: {
+        auto* x = reinterpret_cast<VkPhysicalDeviceVulkan11Features*>(s);
+        void* n = x->pNext;
+        *x = f11, x->pNext = n;
+        break;
+      }
+      case VK_STRUCTURE_TYPE_PHYSICAL_DEVICE_VULKAN_1_2_FEATURES: {
+        auto* x = reinterpret_cast<VkPhysicalDeviceVulkan12Features*>(s);
+        void* n = x->pNext;
+        *x = f12, x->pNext = n;
+        break;
+      }
+      case VK_STRUCTURE_TYPE_PHYSICAL_DEVICE_VULKAN_1_3_FEATURES: {
+        auto* x = reinterpret_cast<VkPhysicalDeviceVulkan13Features*>(s);
+        void* n = x->pNext;
+        *x = f13, x->pNext = n;
+        break;
+      }
+      case VK_STRUCTURE_TYPE_PHYSICAL_DEVICE_MULTIVIEW_FEATURES: {
+        auto* m = reinterpret_cast<VkPhysicalDeviceMultiviewFeatures*>(s);
+        m->multiview = f11.multiview, m->multiviewGeometryShader = m->multiviewTessellationShader = VK_FALSE;
+        break;
+      }
+      case VK_STRUCTURE_TYPE_PHYSICAL_DEVICE_16BIT_STORAGE_FEATURES: {
+        auto* x = reinterpret_cast<VkPhysicalDevice16BitStorageFeatures*>(s);
+        x->storageBuffer16BitAccess = f11.storageBuffer16BitAccess;
+        x->uniformAndStorageBuffer16BitAccess = f11.uniformAndStorageBuffer16BitAccess;
+        x->storagePushConstant16 = f11.storagePushConstant16;
+        x->storageInputOutput16 = f11.storageInputOutput16;
+        break;
+      }
+      case VK_STRUCTURE_TYPE_PHYSICAL_DEVICE_SHADER_FLOAT16_INT8_FEATURES: {
+        auto* x = reinterpret_cast<VkPhysicalDeviceShaderFloat16Int8Features*>(s);
+        x->shaderFloat16 = f12.shaderFloat16, x->shaderInt8 = f12.shaderInt8;
+        break;
+      }
+      case VK_STRUCTURE_TYPE_PHYSICAL_DEVICE_FRAGMENT_DENSITY_MAP_FEATURES_EXT: {
+        auto* d = reinterpret_cast<VkPhysicalDeviceFragmentDensityMapFeaturesEXT*>(s);
+        d->fragmentDensityMap = VK_FALSE;  // not advertised: foveation is VPEngine's (vpvk/config.h)
+        d->fragmentDensityMapDynamic = VK_FALSE;
+        d->fragmentDensityMapNonSubsampledImages = VK_FALSE;
+        break;
+      }
+      case VK_STRUCTURE_TYPE_PHYSICAL_DEVICE_TIMELINE_SEMAPHORE_FEATURES:
+        reinterpret_cast<VkPhysicalDeviceTimelineSemaphoreFeatures*>(s)->timelineSemaphore = f12.timelineSemaphore;
+        break;
+      case VK_STRUCTURE_TYPE_PHYSICAL_DEVICE_SYNCHRONIZATION_2_FEATURES:
+        reinterpret_cast<VkPhysicalDeviceSynchronization2Features*>(s)->synchronization2 = f13.synchronization2;
+        break;
+      case VK_STRUCTURE_TYPE_PHYSICAL_DEVICE_DYNAMIC_RENDERING_FEATURES:
+        reinterpret_cast<VkPhysicalDeviceDynamicRenderingFeatures*>(s)->dynamicRendering = f13.dynamicRendering;
+        break;
+      case VK_STRUCTURE_TYPE_PHYSICAL_DEVICE_MAINTENANCE_4_FEATURES:
+        reinterpret_cast<VkPhysicalDeviceMaintenance4Features*>(s)->maintenance4 = f13.maintenance4;
+        break;
+      case VK_STRUCTURE_TYPE_PHYSICAL_DEVICE_IMAGELESS_FRAMEBUFFER_FEATURES:
+        reinterpret_cast<VkPhysicalDeviceImagelessFramebufferFeatures*>(s)->imagelessFramebuffer = f12.imagelessFramebuffer;
+        break;
+      case VK_STRUCTURE_TYPE_PHYSICAL_DEVICE_SEPARATE_DEPTH_STENCIL_LAYOUTS_FEATURES:
+        reinterpret_cast<VkPhysicalDeviceSeparateDepthStencilLayoutsFeatures*>(s)->separateDepthStencilLayouts =
+            f12.separateDepthStencilLayouts;
+        break;
+      case VK_STRUCTURE_TYPE_PHYSICAL_DEVICE_UNIFORM_BUFFER_STANDARD_LAYOUT_FEATURES:
+        reinterpret_cast<VkPhysicalDeviceUniformBufferStandardLayoutFeatures*>(s)->uniformBufferStandardLayout =
+            f12.uniformBufferStandardLayout;
+        break;
+      case VK_STRUCTURE_TYPE_PHYSICAL_DEVICE_SCALAR_BLOCK_LAYOUT_FEATURES:
+        reinterpret_cast<VkPhysicalDeviceScalarBlockLayoutFeatures*>(s)->scalarBlockLayout = f12.scalarBlockLayout;
+        break;
+      case VK_STRUCTURE_TYPE_PHYSICAL_DEVICE_HOST_QUERY_RESET_FEATURES:
+        reinterpret_cast<VkPhysicalDeviceHostQueryResetFeatures*>(s)->hostQueryReset = f12.hostQueryReset;
+        break;
+      case VK_STRUCTURE_TYPE_PHYSICAL_DEVICE_SHADER_TERMINATE_INVOCATION_FEATURES:
+        reinterpret_cast<VkPhysicalDeviceShaderTerminateInvocationFeatures*>(s)->shaderTerminateInvocation =
+            f13.shaderTerminateInvocation;
+        break;
+      case VK_STRUCTURE_TYPE_PHYSICAL_DEVICE_SHADER_DEMOTE_TO_HELPER_INVOCATION_FEATURES:
+        reinterpret_cast<VkPhysicalDeviceShaderDemoteToHelperInvocationFeatures*>(s)->shaderDemoteToHelperInvocation =
+            f13.shaderDemoteToHelperInvocation;
+        break;
+      case VK_STRUCTURE_TYPE_PHYSICAL_DEVICE_PIPELINE_CREATION_CACHE_CONTROL_FEATURES:
+        reinterpret_cast<VkPhysicalDevicePipelineCreationCacheControlFeatures*>(s)->pipelineCreationCacheControl =
+            f13.pipelineCreationCacheControl;
+        break;
+      case VK_STRUCTURE_TYPE_PHYSICAL_DEVICE_PRIVATE_DATA_FEATURES:
+        reinterpret_cast<VkPhysicalDevicePrivateDataFeatures*>(s)->privateData = f13.privateData;
+        break;
+      case VK_STRUCTURE_TYPE_PHYSICAL_DEVICE_SUBGROUP_SIZE_CONTROL_FEATURES: {
+        auto* x = reinterpret_cast<VkPhysicalDeviceSubgroupSizeControlFeatures*>(s);
+        x->subgroupSizeControl = f13.subgroupSizeControl, x->computeFullSubgroups = f13.computeFullSubgroups;
+        break;
+      }
+      case VK_STRUCTURE_TYPE_PHYSICAL_DEVICE_DYNAMIC_RENDERING_LOCAL_READ_FEATURES_KHR:
+        reinterpret_cast<VkPhysicalDeviceDynamicRenderingLocalReadFeaturesKHR*>(s)->dynamicRenderingLocalRead =
+            b(hasDeviceExtension(VK_KHR_DYNAMIC_RENDERING_LOCAL_READ_EXTENSION_NAME));
+        break;
+      case VK_STRUCTURE_TYPE_PHYSICAL_DEVICE_HOST_IMAGE_COPY_FEATURES_EXT:
+        reinterpret_cast<VkPhysicalDeviceHostImageCopyFeaturesEXT*>(s)->hostImageCopy =
+            b(hasDeviceExtension(VK_EXT_HOST_IMAGE_COPY_EXTENSION_NAME));
+        break;
+      default: break;
+    }
+  }
+}
