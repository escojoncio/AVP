From 5efd06cd69e2b592dc3513d0b4a6615139b9ab7a Mon Sep 17 00:00:00 2001
From: avp-bot <avp-bot@users.noreply.github.com>
Date: Mon, 26 Oct 2026 09:57:06 +0000
Subject: [PATCH] archive_save: tras un save bueno, un fallo va directo al
 split (sin probes ni biseccion)

---
 gpu/metal2/src/metal_backend.mm | 5 ++++-
 1 file changed, 4 insertions(+), 1 deletion(-)

diff --git a/gpu/metal2/src/metal_backend.mm b/gpu/metal2/src/metal_backend.mm
index 33e0c5f..279e3cb 100644
--- a/gpu/metal2/src/metal_backend.mm
+++ b/gpu/metal2/src/metal_backend.mm
@@ -5507,7 +5507,10 @@ bool MetalBackend::Impl::saveArchiveLocked() {
         archiveEntries.size(), token(error).c_str());
     logArchiveCulpritLocked(error);
     archive = nil;
-    if (drops >= kArchiveDrops || !dropCulpritLocked(error)) break;
+    // With an earlier good save the entries added since are saved by the split below (it isolates and drops a single bad one
+    // itself): the candidate probes and the bisection are ~8 more serializations on the compiler service, which stalled the game
+    // (one pipeline compile waited 849 ms), and found nothing when the entries failed only in combination.
+    if (archiveSavedEntries > 0 || drops >= kArchiveDrops || !dropCulpritLocked(error)) break;
   }
   // No single culprit (the entries only fail in combination) or too many drops. Seal the session
   // file (it holds the last good save) and write the entries not on disk yet into new files of
