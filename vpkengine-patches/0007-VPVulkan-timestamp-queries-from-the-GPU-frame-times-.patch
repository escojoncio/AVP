+bool Device::frameTimes(uint64_t frame, double& startNs, double& endNs) {
+  drainTimings();
+  std::lock_guard lock(timesMutex_);
+  for (const auto& [f, s, e] : times_)
+    if (f == frame) {
+      startNs = s, endNs = e;
+      return e > 0;
+    }
+  return false;
+}
+
+void Device::drainTimings() {
+  std::lock_guard lock(timesMutex_);
   uint64_t done;
   GpuTimings t;
   while (backend_.takeTimings(done, t)) {
+    times_.emplace_back(done, t.startNs, t.endNs);
+    while (times_.size() > 512) times_.pop_front();
     while (!passPending_.empty() && passPending_.front().first < done) passPending_.pop_front();
     if (!passPending_.empty() && passPending_.front().first == done) {
       const auto& desc = passPending_.front().second;
@@ -176,7 +195,6 @@ FrameReport Device::submit(const Frame& frame) {
