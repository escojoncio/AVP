diff --git a/gpu/vulkan/src/queries.cpp b/gpu/vulkan/src/queries.cpp
new file mode 100644
index 0000000..bc955ab
--- /dev/null
+++ b/gpu/vulkan/src/queries.cpp
@@ -0,0 +1,143 @@
+// VPVulkan queries. Timestamps are frame-granular: vkCmdWriteTimestamp at TOP_OF_PIPE reads as the
+// GPU start of the frame (vkQueueSubmit) it ran in, any later stage as that frame's GPU end, in
+// nanoseconds of the host clock (timestampPeriod 1). gpu/metal2 reports both from the command
+// buffer (GPUStartTime / GPUEndTime). Enough for engines that time whole frames or their halves
+// (Source 2's adaptive fidelity reads frame GPU time); per-pass timings would need Metal counter
+// sample buffers at encoder boundaries, which the backend already takes for its own diagnostics.
+// Occlusion queries report 1 sample passed (visible): no visibility buffer is bound yet.
+#include <cstring>
+
+#include "commands.h"
+#include "vpvk.h"
+
+#define VPVK_EXPORT extern "C" __attribute__((visibility("default")))
+
+using namespace vpvk;
+
+namespace {
+Recorder& rec(VkCommandBuffer cb) { return *from<CommandBuffer>(cb)->rec; }
+
+// Result of query `q`; false when not available yet.
+bool result(Device& d, const QueryPoolObj& p, uint32_t q, uint64_t& value) {
+  const QueryPoolObj::Query& x = p.queries[q];
+  if (!x.written || !d.frameDone(x.frame)) return false;
+  switch (p.type) {
+    case VK_QUERY_TYPE_TIMESTAMP: {
+      double s = 0, e = 0;
+      if (!d.gpu->frameTimes(x.frame, s, e)) {
+        value = 0;  // the backend gave no time (frame without GPU work): still available
+        return true;
+      }
+      value = uint64_t(x.top ? s : e);
+      return true;
+    }
+    case VK_QUERY_TYPE_OCCLUSION: value = 1; return true;
+    default: value = 0; return true;
+  }
+}
+}  // namespace
+
+VPVK_EXPORT VKAPI_ATTR VkResult VKAPI_CALL vkCreateQueryPool(VkDevice, const VkQueryPoolCreateInfo* ci,
+                                                             const VkAllocationCallbacks*, VkQueryPool* out) {
+  auto* q = new QueryPoolObj;
+  q->type = ci->queryType, q->count = ci->queryCount;
+  q->queries.reset(new QueryPoolObj::Query[std::max(1u, ci->queryCount)]);
+  *out = to<VkQueryPool>(q);
+  return VK_SUCCESS;
+}
+
+VPVK_EXPORT VKAPI_ATTR void VKAPI_CALL vkDestroyQueryPool(VkDevice, VkQueryPool q, const VkAllocationCallbacks*) {
+  delete from<QueryPoolObj>(q);
+}
+
+VPVK_EXPORT VKAPI_ATTR VkResult VKAPI_CALL vkGetQueryPoolResults(VkDevice dv, VkQueryPool pool, uint32_t first, uint32_t n,
+                                                                 size_t size, void* data, VkDeviceSize stride,
+                                                                 VkQueryResultFlags flags) {
+  Device& d = *from<Device>(dv);
+  const QueryPoolObj& p = *from<QueryPoolObj>(pool);
+  const bool wide = flags & VK_QUERY_RESULT_64_BIT, avail = flags & VK_QUERY_RESULT_WITH_AVAILABILITY_BIT;
+  VkResult res = VK_SUCCESS;
+  auto* out = static_cast<uint8_t*>(data);
+  for (uint32_t i = 0; i < n && first + i < p.count; ++i) {
+    uint8_t* slot = out + i * stride;
+    if (slot + (wide ? 8 : 4) * (avail ? 2 : 1) > out + size) break;
+    uint64_t v = 0;
+    bool ok = result(d, p, first + i, v);
+    if (!ok && (flags & VK_QUERY_RESULT_WAIT_BIT) && p.queries[first + i].written) {
+      d.waitFrame(p.queries[first + i].frame, UINT64_MAX);
+      ok = result(d, p, first + i, v);
+    }
+    if (!ok) res = VK_NOT_READY;
+    if (ok || (flags & VK_QUERY_RESULT_PARTIAL_BIT)) {
+      if (wide) std::memcpy(slot, &v, 8);
+      else {
+        const uint32_t v32 = uint32_t(v);
+        std::memcpy(slot, &v32, 4);
+      }
+    }
+    if (avail) {
+      const uint64_t a = ok ? 1 : 0;
+      if (wide) std::memcpy(slot + 8, &a, 8);
+      else {
+        const uint32_t a32 = uint32_t(a);
+        std::memcpy(slot + 4, &a32, 4);
+      }
+    }
+  }
+  return res;
+}
+
+VPVK_EXPORT VKAPI_ATTR void VKAPI_CALL vkResetQueryPool(VkDevice, VkQueryPool pool, uint32_t first, uint32_t n) {
+  QueryPoolObj& p = *from<QueryPoolObj>(pool);
+  for (uint32_t i = first; i < first + n && i < p.count; ++i) p.queries[i].written = false;
+}
+VPVK_EXPORT VKAPI_ATTR void VKAPI_CALL vkCmdResetQueryPool(VkCommandBuffer cb, VkQueryPool pool, uint32_t first, uint32_t n) {
+  rec(cb).queryResets.push_back({from<QueryPoolObj>(pool), first, n});
+}
+VPVK_EXPORT VKAPI_ATTR void VKAPI_CALL vkCmdBeginQuery(VkCommandBuffer, VkQueryPool, uint32_t, VkQueryControlFlags) {}
+VPVK_EXPORT VKAPI_ATTR void VKAPI_CALL vkCmdEndQuery(VkCommandBuffer cb, VkQueryPool pool, uint32_t q) {
+  QueryPoolObj* p = from<QueryPoolObj>(pool);
+  if (q < p->count) rec(cb).queryWrites.push_back({p, q, false});
+}
+VPVK_EXPORT VKAPI_ATTR void VKAPI_CALL vkCmdWriteTimestamp(VkCommandBuffer cb, VkPipelineStageFlagBits stage, VkQueryPool pool,
+                                                           uint32_t q) {
+  QueryPoolObj* p = from<QueryPoolObj>(pool);
+  if (q < p->count) rec(cb).queryWrites.push_back({p, q, stage == VK_PIPELINE_STAGE_TOP_OF_PIPE_BIT});
+}
+// Results written into a buffer when the copy executes: the frame it runs in is still on the GPU,
+// so only queries of earlier, finished frames have values; the others are written as unavailable.
+VPVK_EXPORT VKAPI_ATTR void VKAPI_CALL vkCmdCopyQueryPoolResults(VkCommandBuffer cb, VkQueryPool pool, uint32_t first,
+                                                                 uint32_t n, VkBuffer dst, VkDeviceSize off, VkDeviceSize stride,
+                                                                 VkQueryResultFlags flags) {
+  Recorder& r = rec(cb);
+  const QueryPoolObj& p = *from<QueryPoolObj>(pool);
+  const bool wide = flags & VK_QUERY_RESULT_64_BIT, avail = flags & VK_QUERY_RESULT_WITH_AVAILABILITY_BIT;
+  const size_t each = (wide ? 8 : 4) * (avail ? 2 : 1);
+  std::vector<uint8_t> bytes(size_t(stride) * (n ? n - 1 : 0) + each, 0);
+  vkGetQueryPoolResults(to<VkDevice>(r.device), pool, first, n, bytes.size(), bytes.data(), stride,
+                        flags & ~VkQueryResultFlags(VK_QUERY_RESULT_WAIT_BIT));
+  (void)p;
+  OpUpload u;
+  u.src = r.arena.put(r.device, bytes.data(), bytes.size(), u.srcOffset);
+  u.dst = from<Buffer>(dst), u.dstOffset = off, u.size = bytes.size();
+  r.ops.emplace_back(u);
+}
+
+namespace vpvk {
+PFN_vkVoidFunction lookupQueries(const char* name) {
+  struct E {
+    const char* name;
+    PFN_vkVoidFunction fn;
+  };
+#define F(f) {#f, reinterpret_cast<PFN_vkVoidFunction>(&f)}
+  static const E table[] = {
+      F(vkCreateQueryPool), F(vkDestroyQueryPool), F(vkGetQueryPoolResults), F(vkResetQueryPool), F(vkCmdResetQueryPool),
+      F(vkCmdBeginQuery), F(vkCmdEndQuery), F(vkCmdWriteTimestamp), F(vkCmdCopyQueryPoolResults),
+  };
+#undef F
+  if (!std::strcmp(name, "vkResetQueryPoolEXT")) name = "vkResetQueryPool";
+  for (const E& e : table)
+    if (!std::strcmp(e.name, name)) return e.fn;
+  return nullptr;
+}
+}  // namespace vpvk
