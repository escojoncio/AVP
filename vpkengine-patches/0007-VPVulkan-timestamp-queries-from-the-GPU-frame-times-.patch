+
 struct SemOp {
   Semaphore* sem = nullptr;
   uint64_t value = 0;
@@ -115,6 +118,20 @@ struct Batch {
   std::vector<const CommandBuffer*> cbs;
 };
 
+void stampQueries(const std::vector<Batch>& batches, uint64_t frame) {
+  for (const Batch& b : batches)
+    for (const CommandBuffer* c : b.cbs) {
+      for (const QueryReset& r : c->rec->queryResets)
+        for (uint32_t i = r.first; i < r.first + r.count && i < r.pool->count; ++i) r.pool->queries[i].written = false;
+      for (const QueryWrite& w : c->rec->queryWrites) {
+        QueryPoolObj::Query& q = w.pool->queries[w.index];
+        q.top = w.top;
+        q.frame = frame;
+        q.written = true;
+      }
+    }
+}
+
 // Submits batches in order. Timeline waits on values no earlier work promises block here until the
 // host signals them. Binary waits never block: on this in-order queue a binary semaphore is
 // signalled by an earlier submission or by the host layer's own swapchain acquire (Klepton
@@ -142,8 +159,13 @@ VkResult submit(Device& d, std::vector<Batch>& batches, Fence* fence) {
       barriers += c->rec->barriers;
       ++cbs;
     }
-  if (!frame.commands().empty()) d.lastFrame = d.gpu->submit(frame).frame;
+  // A submission with query writes runs as a frame even without GPU work, so they get a time.
+  bool queries = false;
+  for (Batch& b : batches)
+    for (const CommandBuffer* c : b.cbs) queries = queries || !c->rec->queryWrites.empty();
+  if (!frame.commands().empty() || queries) d.lastFrame = d.gpu->submit(frame).frame;
   ++d.submits;
+  stampQueries(batches, d.lastFrame);
