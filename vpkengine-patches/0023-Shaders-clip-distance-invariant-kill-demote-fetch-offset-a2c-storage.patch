+++ b/gpu/shader/spirv/tests/asm/spvasm.py
@@ -0,0 +1,56 @@
+# Minimal SPIR-V assembler for probes (subset). Usage: python3 -I spvasm.py in.spvasm out.spv
+import struct, sys, re
+OPS = {'OpCapability':17,'OpExtInstImport':11,'OpMemoryModel':14,'OpEntryPoint':15,'OpExecutionMode':16,
+'OpDecorate':71,'OpMemberDecorate':72,'OpTypeVoid':19,'OpTypeBool':20,'OpTypeInt':21,'OpTypeFloat':22,
+'OpTypeVector':23,'OpTypeMatrix':24,'OpTypeImage':25,'OpTypeSampler':26,'OpTypeSampledImage':27,'OpTypeArray':28,
+'OpTypeStruct':30,'OpTypePointer':32,'OpTypeFunction':33,'OpConstant':43,'OpConstantComposite':44,
+'OpVariable':59,'OpLoad':61,'OpStore':62,'OpAccessChain':65,'OpFunction':54,'OpFunctionEnd':56,'OpLabel':248,
+'OpReturn':253,'OpSampledImage':86,'OpImageSampleImplicitLod':87,'OpImageSampleExplicitLod':88,
+'OpImageSampleDrefExplicitLod':90,'OpImageFetch':95,'OpImage':100,'OpCompositeConstruct':80,'OpCompositeExtract':81,
+'OpFAdd':129,'OpFMul':133,'OpVectorTimesScalar':142,'OpMatrixTimesVector':145,'OpKill':252,'OpBranch':249,
+'OpBranchConditional':250,'OpSelectionMerge':247,'OpFOrdLessThan':184,'OpExtInst':12,'OpDPdx':207,'OpName':5,
+'OpConvertFToS':110,'OpImageWrite':99,'OpExecutionModeId':331,'OpBitcast':124,'OpIAdd':128,'OpLoopMerge':246,'OpSLessThan':177,'OpPhi':245}
+NAMES = {'Shader':1,'Logical':0,'GLSL450':1,'Vertex':0,'Fragment':4,'GLCompute':5,'OriginUpperLeft':7,
+'Input':1,'Output':3,'Uniform':2,'UniformConstant':0,'Function':7,'PushConstant':9,
+'Location':30,'BuiltIn':11,'Block':2,'Offset':35,'DescriptorSet':34,'Binding':33,'Invariant':18,'Flat':14,
+'Position':0,'ClipDistance':3,'FragCoord':15,'None':0,'2D':1,'ClipDistanceCap':32,'ArrayStride':6,'RowMajor':4,'ColMajor':5,'MatrixStride':7}
+def asm(text):
+    ids = {}; nxt = [1]
+    def idof(n):
+        if n not in ids: ids[n] = nxt[0]; nxt[0] += 1
+        return ids[n]
+    insts = []
+    for line in text.splitlines():
+        line = line.split(';')[0].strip()
+        if not line: continue
+        toks = re.findall(r'"[^"]*"|\S+', line)
+        res = None
+        if len(toks) > 2 and toks[1] == '=': res = toks[0]; toks = toks[2:]
+        op = toks[0]; args = toks[1:]
+        words = []
+        # result type comes first for value-producing ops in SPIR-V; we keep source order: [type] result args
+        operands = []
+        if res is not None:
+            if op.startswith('OpType') or op == 'OpExtInstImport' or op == 'OpLabel':
+                operands.append(('id', res))
+            else:
+                operands.append(('id', args[0])); operands.append(('id', res)); args = args[1:]
+        for a in args:
+            if a.startswith('%'): operands.append(('id', a))
+            elif a.startswith('"'): operands.append(('str', a[1:-1]))
+            elif re.fullmatch(r'-?\d+\.\d*(e-?\d+)?', a): operands.append(('f', float(a)))
+            elif re.fullmatch(r'-?(0x[0-9a-fA-F]+|\d+)', a): operands.append(('i', int(a, 0)))
+            else: operands.append(('i', NAMES[a]))
+        for k, v in operands:
+            if k == 'id': words.append(idof(v))
+            elif k == 'i': words.append(v & 0xFFFFFFFF)
+            elif k == 'f': words.append(struct.unpack('<I', struct.pack('<f', v))[0])
+            else:
+                b = v.encode() + b'\0'
+                b += b'\0' * ((4 - len(b) % 4) % 4)
+                words += list(struct.unpack('<%dI' % (len(b)//4), b))
+        insts.append([((len(words)+1) << 16) | OPS[op]] + words)
+    out = [0x07230203, 0x00010000, 0, nxt[0], 0]
+    for i in insts: out += i
+    return struct.pack('<%dI' % len(out), *out)
+open(sys.argv[2], 'wb').write(asm(open(sys.argv[1]).read()))
