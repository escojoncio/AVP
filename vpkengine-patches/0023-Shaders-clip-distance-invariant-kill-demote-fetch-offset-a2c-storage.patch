@@ -109,6 +109,7 @@ const char* builtinAttr(Builtin b) {
         case Builtin::LocalInvocationIndex: return "thread_index_in_threadgroup";
         case Builtin::SubgroupInvocation: return "thread_index_in_simdgroup";
         case Builtin::SubgroupSize: return "threads_per_simdgroup";
+        case Builtin::ClipDistance: return "clip_distance";
         case Builtin::None: break;
     }
     return "";
@@ -269,7 +270,14 @@ private:
         for (const IoVar& v : m_.outputs) {
             if (v.perPrimitive != perPrimitive) continue;
             std::string attr;
+            if (v.builtin == Builtin::ClipDistance) {
+                // One array of N distances; the VPIR output is its f32xN value (see StoreOutput).
+                out_ += "    float " + ident(v.name) + " [[clip_distance]] [" + std::to_string(v.type.width) + "];\n";
+                continue;
+            }
             if (v.builtin == Builtin::PointSize && m_.stage == Stage::Vertex) attr = "VP_PSZ";
+            else if (v.builtin == Builtin::Position && m_.invariantPosition && m_.stage != Stage::Fragment)
+                attr = "position, invariant";  // needs MTLCompileOptions.preserveInvariance (metal2)
             else if (v.builtin != Builtin::None) attr = builtinAttr(v.builtin);
             else if (m_.stage == Stage::Fragment)
                 attr = "color(" + std::to_string(v.location) + ")" + (v.blendIndex ? ", index(1)" : "");
@@ -283,6 +291,24 @@ private:
 
     const char* returnOut() const { return depthOnlyOutput() ? "VP_FRET;" : "return vp_out;"; }
 
+    // Fragment colour 0 as a float4 output (the alpha-to-coverage source), or null.
+    const IoVar* coverageColor() const {
+        if (m_.stage != Stage::Fragment) return nullptr;
+        for (const IoVar& v : m_.outputs)
+            if (v.builtin == Builtin::None && v.location == 0 && !v.blendIndex && v.type == Type(Scalar::F32, 4)) return &v;
+        return nullptr;
+    }
+    // VP_A2C1 (set by the backend for pipelines with alpha-to-coverage at one sample): Vulkan keeps
+    // the fragment iff its coverage bit is set, i.e. alpha >= 0.5; done here so it does not depend on
+    // what the GPU makes of a one-sample coverage mask.
+    void coverageTest() {
+        const IoVar* c = coverageColor();
+        if (!c || !entry_) return;
+        out_ += "#ifdef VP_A2C1\n";
+        line("if (vp_out.", ident(c->name), ".w < 0.5f) discard_fragment();");
+        out_ += "#endif\n";
+    }
+
     // ---- functions ----
     void helper(const Function& f) {
         std::string sig = "static " + typeName(f.returnType) + " " + helperName(uint32_t(&f - m_.functions.data())) + "(";
@@ -410,7 +436,10 @@ private:
         for (size_t i = 0; i < f.vars.size(); ++i) line(typeName(f.vars[i].type), " l", std::to_string(i), "{};");
         if (opt_.loopBudget && hasLoop(f.body)) line("uint vp_budget = 0u;");
         block(f.body);
-        if (vsfsOut && (f.body.empty() || f.body.back().kind != NodeKind::Return)) line(returnOut());
+        if (vsfsOut && (f.body.empty() || f.body.back().kind != NodeKind::Return)) {
+            coverageTest();
+            line(returnOut());
+        }
     }
 
     // ---- private slot scalarization ----
@@ -512,9 +541,12 @@ private:
         ++depth_;
         block(b);
         --depth_;
+        lastDiscard_ = false;
     }
 
     void node(const Node& n) {
+        const bool afterDiscard = lastDiscard_;  // a return right after discard_fragment() needs no coverage test
+        lastDiscard_ = false;
         switch (n.kind) {
             case NodeKind::Inst: inst(n.inst); break;
             case NodeKind::If:
@@ -553,11 +585,16 @@ private:
             }
             case NodeKind::Break: line("break;"); break;
             case NodeKind::Continue: line("continue;"); break;
-            case NodeKind::Discard: line("discard_fragment();"); break;
+            case NodeKind::Discard:
+                line("discard_fragment();");
+                lastDiscard_ = true;
+                break;
             case NodeKind::Return:
                 if (n.value != kNoValue) line("return ", ex(n.value), ";");
-                else if (entry_ && (m_.stage == Stage::Vertex || m_.stage == Stage::Fragment) && !m_.outputs.empty())
+                else if (entry_ && (m_.stage == Stage::Vertex || m_.stage == Stage::Fragment) && !m_.outputs.empty()) {
+                    if (!afterDiscard) coverageTest();
                     line(returnOut());
+                }
                 else line("return;");
                 break;
         }
@@ -787,6 +824,13 @@ private:
                     out_ += "#endif\n";
                     return;
                 }
+                if (m_.outputs[in.sym].builtin == Builtin::ClipDistance) {
+                    const IoVar& o = m_.outputs[in.sym];
+                    if (o.type.width == 1) return line("vp_out.", ident(o.name), "[0] = ", a(0), ";");
+                    for (unsigned k = 0; k < o.type.width; ++k)
+                        line("vp_out.", ident(o.name), "[", std::to_string(k), "] = ", a(0), ".", std::string(1, kSwizzle[k]), ";");
+                    return;
+                }
                 return line("vp_out.", ident(m_.outputs[in.sym].name), " = ", a(0), ";");
             case Op::Call: {
                 std::string c = helperName(in.sym) + "(" + args(in) + ")";
@@ -1014,6 +1058,7 @@ private:
     std::string out_;
     unsigned depth_ = 0;
     unsigned loops_ = 0;  // loop guard counters emitted so far (names vp_guardN)
+    bool lastDiscard_ = false;  // the previous node of this block was a Discard
     // EmitOptions::loopCap: iterations a loop may run per entry before the hang guard breaks it, far
     // above real game loops (lights, kernel taps, bones; a dispatch loop counts one per block run)
     // and low enough that a runaway loop over a full-screen pass finishes before the GPU watchdog.
