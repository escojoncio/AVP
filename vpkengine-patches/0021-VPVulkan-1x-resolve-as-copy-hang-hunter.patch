   if (!quarantineOn) {
@@ -1556,6 +1589,176 @@ void MetalBackend::Impl::dumpShaderSource(uint64_t shaderId) {
   info("gpu.hang.msl id=" + std::string(name, 16) + " file=" + token((dir / name).string()));
 }
 
+// ---- Hang hunter ---------------------------------------------------------------------------------
+
+std::string MetalBackend::Impl::huntKeyName(uint64_t k) {
+  char hex[24];
+  std::snprintf(hex, sizeof hex, "%016llx", (unsigned long long)k);
+  std::lock_guard lock(pipelineMutex);
+  auto it = pipelines.find(k);
+  return std::string(hex) + "(" + token(it != pipelines.end() ? it->second.label : std::string("?")) + ")";
+}
+
+uint64_t MetalBackend::Impl::huntSplit(uint64_t frameIndex) {
+  hunt.clean = 0;
+  hunt.appliedFrame = UINT64_MAX;
+  hunt.all = false;
+  if (hunt.cand.size() == 1 && hunt.step > 0) {
+    const uint64_t k = hunt.cand[0];
+    hunt.active = false;
+    hunt.test.clear();
+    hunt.cand.clear();
+    // The culprit stays skipped: quarantined (session at once, file too) before the test set is dropped.
+    if (quarantineOn) {
+      {
+        std::lock_guard lock(quarantineMutex);
+        quarantine.emplace(k, "hang_hunt");
+      }
+      ++quarantineSerial;
+    }
+    hunt.serial.fetch_add(1);
+    return k;  // reported (file, MSL) by the caller once hunt.m is released
+  }
+  // Step 0: everything (is it a pipeline at all?); then the first half of what is left.
+  const size_t n = hunt.step == 0 ? hunt.cand.size() : (hunt.cand.size() + 1) / 2;
+  hunt.all = hunt.step == 0;
+  hunt.test.assign(hunt.cand.begin(), hunt.cand.begin() + n);
+  std::string list;
+  for (size_t i = 0; i < hunt.test.size() && i < 12; ++i) list += (i ? "," : "") + huntKeyName(hunt.test[i]);
+  info("gpu.hunt step=" + std::to_string(hunt.step) + " f=" + std::to_string(frameIndex) + " candidates=" +
+       std::to_string(hunt.cand.size()) + " skipping=" + std::to_string(hunt.test.size()) + " [" + list +
+       (hunt.test.size() > 12 ? ",..." : "") + "]");
+  ++hunt.step;
+  hunt.serial.fetch_add(1);
+  return 0;
+}
+
+void MetalBackend::Impl::logShaderSource(uint64_t shaderId) {
+  if (!shaderId) return;
+  MslShader msl;
+  if (!shaders.find(shaderId, msl)) return;
+  char hex[24];
+  std::snprintf(hex, sizeof hex, "%016llx", (unsigned long long)shaderId);
+  info(std::string("gpu.hunt.msl begin id=") + hex + " entry=" + token(msl.entry) + " bytes=" + std::to_string(msl.source.size()));
+  size_t at = 0, lines = 0;
+  while (at < msl.source.size() && lines < 1500) {
+    size_t nl = msl.source.find('\n', at);
+    if (nl == std::string::npos) nl = msl.source.size();
+    info(std::string("gpu.hunt.msl ") + hex + " | " + msl.source.substr(at, std::min<size_t>(nl - at, 600)));
+    at = nl + 1;
+    ++lines;
+  }
+  info(std::string("gpu.hunt.msl end id=") + hex + (at < msl.source.size() ? " (truncated)" : ""));
+}
+
+void MetalBackend::Impl::huntCulprit(uint64_t key, uint64_t frameIndex) {
+  Pipeline pl;
+  bool found = false;
+  {
+    std::lock_guard lock(pipelineMutex);
+    auto it = pipelines.find(key);
+    if (it != pipelines.end()) pl.key = it->second.key, pl.vs = it->second.vs, pl.fs = it->second.fs, pl.cs = it->second.cs,
+                               pl.label = it->second.label, found = true;
+  }
+  char buf[256];
+  std::snprintf(buf, sizeof buf, "label=%s vs=%016llx fs=%016llx cs=%016llx why=hang_hunt f=%llu",
+                found ? token(pl.label).c_str() : "?", (unsigned long long)pl.vs, (unsigned long long)pl.fs,
+                (unsigned long long)pl.cs, (unsigned long long)frameIndex);
+  info(std::string("gpu.hunt culprit pipeline=") + huntKeyName(key) + " " + buf);
+  if (!quarantineOn) {
+    info("gpu.hunt culprit not quarantined (VP_QUARANTINE=0): its draws come back");
+  } else {
+    {
+      std::lock_guard lock(quarantineMutex);
+      suspects.insert(key);  // proven by bisection: straight to quarantine.txt
+      quarantine.erase(key);  // the placeholder huntSplit put in; quarantineAdd writes the real line
+    }
+    quarantineAdd(key, buf, frameIndex);
+  }
+  dumpShaderSource(pl.vs);
+  dumpShaderSource(pl.fs);
+  dumpShaderSource(pl.cs);
+  logShaderSource(pl.vs);
+  logShaderSource(pl.fs);
+  logShaderSource(pl.cs);
+}
+
+void MetalBackend::Impl::huntOnHang(uint64_t frameIndex, const std::vector<uint64_t>& keys) {
+  uint64_t culprit = 0;
+  {
+    std::lock_guard lock(hunt.m);
+    culprit = huntOnHangLocked(frameIndex, keys);
+  }
+  if (culprit) huntCulprit(culprit, frameIndex);
+}
+
+uint64_t MetalBackend::Impl::huntOnHangLocked(uint64_t frameIndex, const std::vector<uint64_t>& keys) {
+  if (!hunt.on || hunt.stopped) return 0;
+  if (!hunt.active) {
+    if (hunt.hunts >= kHuntMax) return 0;
+    std::vector<uint64_t> cand;
+    {
+      std::unordered_set<uint64_t> seen;
+      std::lock_guard q(quarantineMutex);
+      for (uint64_t k : keys)
+        if (k && !quarantine.count(k) && seen.insert(k).second) cand.push_back(k);
+    }
+    if (cand.empty()) {
+      info("gpu.hunt f=" + std::to_string(frameIndex) + " nothing to bisect (no pipelines in the hung frame)");
+      return 0;
+    }
+    ++hunt.hunts;
+    hunt.active = true;
+    hunt.step = 0;
+    hunt.cand = std::move(cand);
+    info("gpu.hunt start n=" + std::to_string(hunt.hunts) + " f=" + std::to_string(frameIndex) + " pipelines=" +
+         std::to_string(hunt.cand.size()));
+    return huntSplit(frameIndex);
+  }
+  if (hunt.appliedFrame == UINT64_MAX || frameIndex < hunt.appliedFrame) return 0;  // encoded before the test
+  if (hunt.test.size() == hunt.cand.size()) {
+    // Every pipeline of the hung frame skipped and it still hangs: the passes themselves (attachments,
+    // load/store/resolve, layered targets) or work outside draws.
+    info("gpu.hunt verdict=not_a_pipeline f=" + std::to_string(frameIndex) + " step=" + std::to_string(hunt.step) +
+         " (hangs with all " + std::to_string(hunt.cand.size()) + " pipelines skipped: see the gpu.hang.enc passes)");
+    hunt.active = false;
+    hunt.stopped = true;
+    hunt.test.clear();
+    hunt.cand.clear();
+    hunt.all = false;
+    hunt.serial.fetch_add(1);
+    return 0;
+  }
+  info("gpu.hunt verdict=hang f=" + std::to_string(frameIndex) + " step=" + std::to_string(hunt.step) +
+       ": not in the skipped " + std::to_string(hunt.test.size()));
+  std::vector<uint64_t> rest;
+  for (uint64_t k : hunt.cand)
+    if (std::find(hunt.test.begin(), hunt.test.end(), k) == hunt.test.end()) rest.push_back(k);
+  hunt.cand = std::move(rest);
+  if (hunt.cand.empty()) {
+    hunt.active = false;
+    hunt.test.clear();
+    hunt.all = false;
+    hunt.serial.fetch_add(1);
+    return 0;
+  }
+  return huntSplit(frameIndex);
+}
+
+void MetalBackend::Impl::huntOnClean(uint64_t frameIndex) {
+  uint64_t culprit = 0;
+  {
+    std::lock_guard lock(hunt.m);
+    if (!hunt.active || hunt.appliedFrame == UINT64_MAX || frameIndex < hunt.appliedFrame) return;
+    if (++hunt.clean < kHuntClean) return;
+    info("gpu.hunt verdict=clean f=" + std::to_string(frameIndex) + " step=" + std::to_string(hunt.step) + ": " +
+         std::to_string(kHuntClean) + " frames without a hang with " + std::to_string(hunt.test.size()) + " skipped");
+    hunt.cand = hunt.test;
+    culprit = huntSplit(frameIndex);
+  }
+  if (culprit) huntCulprit(culprit, frameIndex);
+}
