+  uint32_t resolves = 0;      // render: 1 = a colour attachment resolves, 2 = depth/stencil resolves
+  uint32_t hunted = 0;        // draws/dispatches the hang hunter skipped in this encoder
+  std::unordered_set<uint64_t> allKeys;  // every PipelineKey bound (hang hunter; capped at 8192)
   std::string label;
   std::vector<id> states;       // distinct pipeline states, first kMaxDiagStates
   std::vector<uint64_t> keys;   // distinct PipelineKeys, first kMaxDiagKeys (the quarantine's input)
@@ -1471,6 +1503,7 @@ std::string dumpWrite(const DumpItem& it, uint64_t frame, const std::string& dir
