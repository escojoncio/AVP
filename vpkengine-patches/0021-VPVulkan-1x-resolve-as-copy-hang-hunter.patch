+  // Hang hunter (VP_HANG_HUNT=0 turns it off). When the GPU hangs and nothing proves which encoder did
+  // it (Metal's per-encoder status names victims; timestamps of passes without draws are garbage), the
+  // pipelines of the hung frame are bisected at run time: step 0 skips ALL of them (still hanging =
+  // not a pipeline: an attachment/pass problem), then half of the remaining candidates at a time. A
+  // hang in a frame encoded with the test set skipped puts the culprit in the other half; kHuntClean
+  // frames that complete with draws put it in the skipped half. One candidate left: quarantined for good
+  // (quarantine.txt), its MSL printed into the log. Up to kHuntMax hunts per session (several culprits).
+  static constexpr uint32_t kHuntClean = 12, kHuntMax = 4;
+  struct Hunt {
+    std::mutex m;
+    bool on = true, active = false, stopped = false;
+    bool all = false;  // step 0: skip every draw and dispatch, not only the listed candidates
+    uint32_t hunts = 0, step = 0, clean = 0;
+    uint64_t appliedFrame = UINT64_MAX;  // first frame encoded with the current test set (submit thread)
+    std::vector<uint64_t> cand, test;
+    std::atomic<uint32_t> serial{0};
+  } hunt;
+  std::unordered_set<uint64_t> huntSnapshot;  // submit thread only: the test set being skipped
+  bool huntAll = false;                       // submit thread only: hunt.all at the snapshot
+  uint32_t huntSeen = 0;                      // submit thread only
+  uint64_t huntSkippedDraws = 0;              // submit thread only
+  uint64_t huntSplit(uint64_t frameIndex);    // hunt.m held; returns a culprit to report (after unlocking)
+  void huntCulprit(uint64_t key, uint64_t frameIndex);
+  void huntOnHang(uint64_t frameIndex, const std::vector<uint64_t>& keys);
+  uint64_t huntOnHangLocked(uint64_t frameIndex, const std::vector<uint64_t>& keys);  // hunt.m held
+  void huntOnClean(uint64_t frameIndex);
+  void logShaderSource(uint64_t shaderId);
+  std::string huntKeyName(uint64_t key);
 
   // pipelineMutex guards only the maps (the submit thread takes it every frame, so it is never
   // held across a Metal compile). archiveMutex guards the session's binary archive: adding to it
@@ -1206,6 +1235,9 @@ struct EncDiag {
