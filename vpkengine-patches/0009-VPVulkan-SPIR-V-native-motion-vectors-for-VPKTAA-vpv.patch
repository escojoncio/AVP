+#include <stdint.h>
+
+#ifdef __cplusplus
+extern "C" {
+#endif
+
+typedef struct vpvk_motion_info {
+  void* texture;            // id<MTLTexture> (unretained; valid while the device lives): 2D array, RG16Float
+  uint32_t width, height, layers;
+  float scale_x, scale_y;   // 0.5, 0.5: NDC difference -> uv difference
+  float invalid_threshold;  // 1000: the clear value is 60000
+  uint64_t serial;          // motion frame (one per eye frame: begins at an eye pass that clears depth)
+  int complete;             // 1: the GPU finished every pass of that frame
+  int includes_camera;      // 1: always (full motion: camera + objects)
+} vpvk_motion_info;
