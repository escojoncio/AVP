+// On/off; read at vkCreateDevice (pipelines created while off get no motion variant). Env
+// VPVK_MOTION=0/1 overrides.
+void vpvk_config_set_motion_vectors(int on);
+// The newest complete motion frame (serial = 0) or exactly `serial`. 1 = *out filled.
+// Frames rotate through 4 textures: a consumer must be done with one within 3 eye frames.
+int vpvk_motion_get(uint64_t serial, vpvk_motion_info* out);
+
+#ifdef __cplusplus
+}
+#endif
