diff --git a/gpu/vulkan/src/motion.cpp b/gpu/vulkan/src/motion.cpp
new file mode 100644
index 0000000..834dfe0
--- /dev/null
+++ b/gpu/vulkan/src/motion.cpp
@@ -0,0 +1,291 @@
+// VPKTAA motion vectors (vpvk/motion.h). VPEngine generates them because Source 2 (and most PC VR
+// titles) never render any.
+//
+// Per eye frame (it begins at an eye pass whose depth attachment is cleared):
+//  * every multiview pass with a depth attachment and a free colour slot gets the motion target
+//    (an RG16Float 2D array of the pass's size, one of kRing rotating textures) as one more colour
+//    attachment, cleared to "invalid" by the frame's first pass and loaded by the rest;
+//  * draws in those passes switch to their pipeline's variants (pipelines.cpp buildMotionVariants):
+//    opaque draws to the motion variant, the others to the format-only one;
+//  * a motion draw binds, next to its current constant / storage buffers, the copies those same
+//    bytes had the previous time this draw (same geometry, same occurrence in the frame) was
+//    submitted; the bytes of this frame become the copies for the next. A draw with no history
+//    binds its current data as previous (zero motion for that one frame).
+// Copies live in device-wide upload buffers (unified memory, written by the CPU at vkQueueSubmit),
+// two frames' worth, swapped per eye frame.
+#include <algorithm>
+#include <atomic>
+#include <cstdlib>
+#include <cstring>
+#include <mutex>
+#include <unordered_map>
+
+#include "commands.h"
+#include "vpvk.h"
+#include "vpvk/motion.h"
+
+namespace vpvk {
+namespace {
+std::atomic<int> gMotionOn{-1};  // -1: env / default (off)
+constexpr int kRing = 4;
+constexpr float kInvalid = 60000.0f;
+}  // namespace
+
+bool motionVectorsEnabled() {
+  if (const char* e = std::getenv("VPVK_MOTION"); e && (*e == '0' || *e == '1')) return *e == '1';
+  return gMotionOn.load() == 1;
+}
+
+struct MotionState {
+  std::mutex m;
+  // Rotating motion targets, recreated when the eye size changes.
+  struct Target {
+    vpgpu::TextureId tex;
+    uint32_t w = 0, h = 0, layers = 0;
+    uint64_t serial = 0, frame = kNoFrame;  // eye frame drawn into it, and the last core frame that did
+  };
+  Target ring[kRing];
+  int cur = -1;            // ring index of the eye frame being recorded
+  uint64_t serial = 0;     // eye frames begun
+  bool clearedThisFrame = false;
+
+  // Previous-frame data: per draw (geometry hash + occurrence), the byte ranges it read.
+  struct Copy {
+    uint32_t offset = 0, size = 0;  // in the generation's arena
+  };
+  struct Arena {
+    uint8_t* host = nullptr;
+    vpgpu::BufferId id;
+    uint32_t size = 0, used = 0;
+  };
+  Arena arenas[2];
+  int gen = 0;  // arena being written this eye frame; the other holds the previous one
+  std::unordered_map<uint64_t, std::vector<Copy>> prev, next;
+  std::unordered_map<uint64_t, uint32_t> occurrences;
+  uint64_t motionDraws = 0, firstSeen = 0, formatDraws = 0, frames = 0;
+
+  vpgpu::TextureId target(Device& d, uint32_t w, uint32_t h, uint32_t layers) {
+    Target& t = ring[cur];
+    if (t.tex && t.w == w && t.h == h && t.layers == layers) return t.tex;
+    if (t.tex) {
+      std::lock_guard<std::mutex> l(d.resourceMutex);
+      d.gpu->destroy(t.tex);
+    }
+    vpgpu::TextureDesc td;
+    td.type = vpgpu::TextureType::Tex2D;
+    td.format = vpgpu::Format::RG16Float;
+    td.width = w, td.height = h, td.layers = uint16_t(layers);
+    td.usage = vpgpu::usage::colorTarget | vpgpu::usage::sampled;
+    td.persistent = true;  // read by VPKTAA after the frame
+    td.label = "vk.motion";
+    {
+      std::lock_guard<std::mutex> l(d.resourceMutex);
+      t.tex = d.gpu->createTexture(td);
+    }
+    t.w = w, t.h = h, t.layers = layers;
+    return t.tex;
+  }
+
+  // Bytes for the next generation's copy; offset in its arena (UINT32_MAX = full).
+  uint32_t store(Device& d, const uint8_t* src, uint32_t size) {
+    Arena& a = arenas[gen];
+    const uint32_t need = (size + 255) & ~255u;
+    if (a.used + need > a.size) {
+      if (a.size >= (64u << 20)) return UINT32_MAX;  // 64 MiB per frame is plenty; beyond, no motion
+      // Grow: a fresh buffer (the old one may still be read by the GPU; it is released with the
+      // generation two eye frames later, see beginFrame).
+      Arena n;
+      n.size = std::max<uint32_t>(a.size * 2, 4u << 20);
+      n.host = static_cast<uint8_t*>(std::aligned_alloc(16384, n.size));
+      vpgpu::BufferDesc bd;
+      bd.size = n.size, bd.guestMemory = n.host, bd.label = "vk.motion_prev";
+      {
+        std::lock_guard<std::mutex> l(d.resourceMutex);
+        n.id = d.gpu->createBuffer(bd);
+      }
+      // Copies made into the old arena this frame stay readable through `retired` until reuse.
+      retired.push_back(a);
+      std::memcpy(n.host, a.host, a.used);
+      n.used = a.used;
+      for (auto& [k, v] : next) (void)k, (void)v;  // offsets are unchanged: same layout
+      a = n;
+    }
+    const uint32_t off = a.used;
+    std::memcpy(a.host + off, src, size);
+    a.used += need;
+    return off;
+  }
+  std::vector<Arena> retired;
+
+  void beginFrame(Device& d, uint64_t lastSubmitted) {
+    ++serial;
+    ++frames;
+    cur = (cur + 1) % kRing;
+    ring[cur].serial = serial;
+    ring[cur].frame = kNoFrame;
+    clearedThisFrame = false;
+    // The arena written last frame becomes "previous"; the one before is overwritten. It was read
+    // by draws of two eye frames ago: wait for them (normally long finished).
+    prev.swap(next);
+    next.clear();
+    occurrences.clear();
+    gen ^= 1;
+    d.waitFrame(lastSubmitted == kNoFrame ? kNoFrame : lastSubmitted, UINT64_MAX);
+    arenas[gen].used = 0;
+    for (Arena& a : retired) {
+      std::lock_guard<std::mutex> l(d.resourceMutex);
+      if (a.id) d.gpu->destroy(a.id);
+      std::free(a.host);
+    }
+    retired.clear();
+    if (frames <= 3 || frames % 600 == 0)
+      logf("vk.motion frame=%llu draws motion=%llu first_seen=%llu format_only=%llu prev_mb=%.1f",
+           (unsigned long long)serial, (unsigned long long)motionDraws, (unsigned long long)firstSeen,
+           (unsigned long long)formatDraws, arenas[gen ^ 1].used / 1048576.0);
+  }
+
+  ~MotionState() {
+    for (Arena& a : arenas) std::free(a.host);
+    for (Arena& a : retired) std::free(a.host);
+  }
+};
+
+void MotionStateDelete::operator()(MotionState* m) const { delete m; }
+
+void motionDeviceCreated(Device& d) {
+  if (!motionVectorsEnabled()) return;
+  d.motion.reset(new MotionState);
+  logf("vk.motion enabled (eye passes get an RG16F motion target; VPKTAA reads it with vpvk_motion_get)");
+}
+void motionDeviceDestroyed(Device& d) {
+  if (!d.motion) return;
+  for (auto& t : d.motion->ring)
+    if (t.tex) d.gpu->destroy(t.tex);
+  for (auto& a : d.motion->arenas)
+    if (a.id) d.gpu->destroy(a.id);
+  d.motion.reset();
+}
+
+// ---- translation hooks (commands.cpp) -------------------------------------------------------------
+// A pass about to open: if it is an eye pass the motion target joins it. Returns the slot used, -1 none.
+int motionPassBegin(Device* d, vpgpu::RenderPassDesc& desc, uint64_t lastSubmitted) {
+  if (!d || !d->motion || desc.layerCount < 2 || !desc.depth.texture) return -1;
+  const vpgpu::TextureDesc* td = d->gpu->resources().get(desc.depth.texture);
+  if (!td || td->samples != 1) return -1;
+  int slot = -1;
+  for (int c = 0; c < vpgpu::kMaxColorAttachments; ++c)
+    if (!desc.colors[c].texture) {
+      slot = c;
+      break;
+    }
+  for (int c = slot + 1; slot >= 0 && c < vpgpu::kMaxColorAttachments; ++c)
+    if (desc.colors[c].texture) slot = -1;
+  if (slot < 0) return -1;
+  MotionState& m = *d->motion;
+  std::lock_guard<std::mutex> lock(m.m);
+  const bool newFrame = desc.depth.load == vpgpu::LoadAction::Clear || m.cur < 0;
+  if (newFrame) m.beginFrame(*d, lastSubmitted);
+  const uint32_t w = std::max(1u, td->width >> desc.depth.mip), h = std::max(1u, td->height >> desc.depth.mip);
+  vpgpu::Attachment& a = desc.colors[slot];
+  a.texture = m.target(*d, w, h, desc.layerCount);
+  a.layer = desc.depth.layer;
+  a.load = m.clearedThisFrame ? vpgpu::LoadAction::Load : vpgpu::LoadAction::Clear;
+  a.clear.color = {kInvalid, kInvalid, 0, 0};
+  a.store = vpgpu::StoreAction::Store;
+  m.clearedThisFrame = true;
+  return slot;
+}
+
+// A draw in a pass that has the motion target at `slot`: switch it to its variant and, for motion
+// draws, bind the previous-frame copies. Returns false when the pipeline has no variant for this
+// slot (the draw is skipped: its pipeline would not match the pass).
+bool motionDraw(Device* d, OpDraw& op, int slot) {
+  const PipelineObj* p = op.pipe;
+  if (!p || !p->mv || p->mv->slot != slot) return false;
+  MotionState& m = *d->motion;
+  const MotionVariants& mv = *p->mv;
+  const std::array<uint8_t, 8>* masks = op.dynMasks ? &op.masks : nullptr;
+  if (!mv.hasMotion || op.motionSrc.empty()) {
+    op.draw.pipeline = p->derived(1, masks);
+    ++m.formatDraws;
+    return true;
+  }
+  std::lock_guard<std::mutex> lock(m.m);
+  const uint64_t key = op.geometry ^ (uint64_t(m.occurrences[op.geometry]++) * 0x9E3779B97F4A7C15ull);
+  auto prevIt = m.prev.find(key);
+  const bool have = prevIt != m.prev.end() && prevIt->second.size() == op.motionSrc.size();
+  std::vector<MotionState::Copy> copies;
+  copies.reserve(op.motionSrc.size());
+  bool stored = true;
+  for (size_t i = 0; i < op.motionSrc.size(); ++i) {
+    const MotionSrc& s = op.motionSrc[i];
+    const uint32_t off = m.store(*d, s.host, s.size);
