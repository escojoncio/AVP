+
+extern "C" __attribute__((visibility("default"))) int vpvk_motion_get(uint64_t serial, vpvk_motion_info* out) {
+  if (!out) return 0;
+  std::lock_guard<std::mutex> l(gDevMutex);
+  vpvk::Device* d = gDevice;
+  if (!d || !d->motion) return 0;
+  vpvk::MotionState& m = *d->motion;
+  std::lock_guard<std::mutex> lock(m.m);
+  const vpvk::MotionState::Target* best = nullptr;
+  for (const auto& t : m.ring) {
+    if (!t.tex || t.frame == vpvk::kNoFrame) continue;
+    const bool done = d->frameDone(t.frame);
+    if (serial ? t.serial == serial : (done && (!best || t.serial > best->serial))) best = &t;
+  }
+  if (!best) return 0;
+  *out = {};
+  out->texture = d->platform->nativeTexture(best->tex);
+  out->width = best->w, out->height = best->h, out->layers = best->layers;
+  out->scale_x = 0.5f, out->scale_y = 0.5f;
+  out->invalid_threshold = 1000.0f;
+  out->serial = best->serial;
+  out->complete = d->frameDone(best->frame) ? 1 : 0;
+  out->includes_camera = 1;
