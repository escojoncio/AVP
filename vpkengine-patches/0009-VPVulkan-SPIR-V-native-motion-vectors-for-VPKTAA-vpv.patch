+// Motion variant (VPKTAA): the vertex shader runs twice, the first run with every constant
+// buffer (uniform blocks and push constants) redirected to its previous-frame slot; both clip
+// positions leave at locations 30/31. The fragment shader adds the motion output.
+void motion(const std::string& dir, const std::string& v) {
+    spirv::SpirvLowerOptions o;
+    o.entry = "main";
+    o.stage = vpir::Stage::Vertex;
+    o.viewCount = 2;
+    o.layout = {bind(0, 0, vpgpu::BindKind::ConstantBuffer, 0), bind(1, 0, vpgpu::BindKind::ConstantBuffer, 1)};
+    o.pushConstantSlot = 2;
+    o.vertexBuffers = {{0, 32, false, 3}, {1, 16, true, 4}};
+    o.vertexAttributes = {{0, 0, 0, vpgpu::Format::RGBA32Float}, {1, 0, 12, vpgpu::Format::RGBA8Snorm},
+                          {2, 0, 16, vpgpu::Format::RG16Float}, {3, 1, 0, vpgpu::Format::RGBA32Float}};
+    o.motion.vertex = true;
+    o.motion.prevSlotBase = 16;
+    Result r = run(dir + "/mesh_multiview.vert" + (v.empty() ? "" : ".opt") + ".spv", o);
+    CHECK(r.ok);
+    if (!r.ok) return;
+    // Every constant buffer the shader reads, once more at slot + 16.
+    std::set<uint32_t> cb;
+    for (auto& res : r.module.resources)
+        if (res.kind == vpir::ResourceKind::ConstantBuffer) cb.insert(res.index);
+    CHECK(cb == (std::set<uint32_t>{0, 1, 2, 16, 17, 18}));
+    CHECK(r.iface.motionPrevSlots.size() == 3);
+    int mv = 0;
+    for (auto& out : r.module.outputs) mv += out.location >= 30 && out.builtin == vpir::Builtin::None;
+    CHECK(mv == 2);
+    CHECK(r.msl.source.find("user(loc30)") != std::string::npos && r.msl.source.find("user(loc31)") != std::string::npos);
+    // No motion without a constant buffer to read the previous frame from is still a valid shader.
+    spirv::SpirvLowerOptions f;
+    f.entry = "main";
+    f.stage = vpir::Stage::Fragment;
+    f.viewCount = 2;
+    f.layout = {bind(0, 1, vpgpu::BindKind::Texture, 0, 0), bind(0, 2, vpgpu::BindKind::Texture, 1),
+                bind(0, 3, vpgpu::BindKind::Sampler, 1), bind(0, 4, vpgpu::BindKind::Texture, 2, 2),
+                bind(0, 5, vpgpu::BindKind::Buffer, 0), bind(0, 6, vpgpu::BindKind::ConstantBuffer, 1)};
+    f.motion.fragment = true;
+    f.motion.colorSlot = 1;
+    Result rf = run(dir + "/lit.frag" + (v.empty() ? "" : ".opt") + ".spv", f);
+    CHECK(rf.ok);
+    if (!rf.ok) return;
+    CHECK(rf.iface.colorOutputs == 3 && rf.msl.colorOutputs == 3);
+    CHECK(rf.msl.source.find("[[color(1)]]") != std::string::npos && rf.msl.source.find("user(loc31)") != std::string::npos);
+    // Colour slot taken by the shader itself: refused.
+    f.motion.colorSlot = 0;
+    std::vector<uint32_t> words = readWords(dir + "/lit.frag.spv");
+    std::string error;
+    spirv::SpirvModule* m = spirv::parse(words.data(), words.size(), error);
+    vpir::Module out;
+    spirv::SpirvInterface iface;
+    CHECK(m && !spirv::lower(*m, f, out, iface, error) && error.find("motion") != std::string::npos);
+    spirv::release(m);
+}
