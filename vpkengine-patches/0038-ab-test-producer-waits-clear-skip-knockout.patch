From f83b720a0cf468c72ba3a6d62c1b33b2be553620 Mon Sep 17 00:00:00 2001
From: Claude <claude@users.invalid>
Date: Wed, 14 Oct 2026 23:17:28 +0000
Subject: [PATCH] VPKEngine 0038: producer-only fence waits, redundant
 depth-clear skip, pipeline knockout/census, indirect-count counters (runtime
 switches for AVP's A/B test)

---
 gpu/core/include/vpgpu/core/frame_compiler.h |  18 +
 gpu/core/src/device.cpp                      |   4 +-
 gpu/core/src/frame_compiler.cpp              |  23 +-
 gpu/core/tests/core_tests.cpp                | 122 ++++++-
 gpu/metal2/src/metal_backend.mm              | 333 ++++++++++++++++++-
 5 files changed, 479 insertions(+), 21 deletions(-)

diff --git a/gpu/core/include/vpgpu/core/frame_compiler.h b/gpu/core/include/vpgpu/core/frame_compiler.h
index c7a8c89..f5ea53f 100644
--- a/gpu/core/include/vpgpu/core/frame_compiler.h
+++ b/gpu/core/include/vpgpu/core/frame_compiler.h
@@ -15,6 +15,7 @@
 #pragma once
 
 #include <array>
+#include <atomic>
 #include <cstdint>
 #include <vector>
 
@@ -51,8 +52,20 @@ struct Barrier {
   uint32_t encoder = 0, item = 0;
   StageMask after = 0, before = 0;
   uint8_t hazards = 0;  // bit per HazardKind
+  // CompileOptions::producerWaits: the earlier encoders (indices into CompiledFrame::encoders, this one included
+  // for an item barrier inside a compute encoder) whose accesses conflict with what the barrier orders. Sorted,
+  // unique. Empty without that option.
+  std::vector<uint32_t> producers;
 };
 
+// Runtime optimisation switches (AVP's automatic A/B test flips them while the game runs; 0 = the behaviour
+// before patch 0038). Read once per submit. The host sets them through vpgpu_metal2_set_opts.
+enum RuntimeOpt : uint32_t {
+  kOptProducerWaits = 1u << 0,  // a barrier waits only on the encoders that produced what it orders
+  kOptClearSkip = 1u << 1,      // a draw-less clear of a depth texture already cleared to that value is skipped
+};
+extern std::atomic<uint32_t> gRuntimeOpts;
+
 // Why an attachment did or did not stay on tile. Candidates are only attachments the client lets
 // go of: store DontCare/Resolve, or TextureDesc::transient. Tile-local then requires every access of
 // the texture in the frame to be inside one render encoder (as attachment or pixel-local read),
@@ -141,6 +154,7 @@ struct CompiledFrame {
   std::vector<DrawRef> badDraws;
   CompileStats stats;
   bool skipped(uint32_t command, uint32_t draw) const;
+  bool producerWaits = false;  // compiled with CompileOptions::producerWaits (Barrier::producers filled)
 };
 
 struct CompileOptions {
@@ -159,6 +173,10 @@ struct CompileOptions {
   // custom resolve) keeps the store. A read in a LATER submit would see undefined samples:
   // CompiledFrame::stats.msaaStaleReads counts such reads (msaa_stale in the frame report).
   bool msaaResolveOnTile = true;
+  // Fill Barrier::producers so a backend can wait on those encoders only instead of on everything unordered so
+  // far. Hazards a later barrier "covers" are NOT dropped in this mode: that barrier waited on its own producers
+  // only, so it orders nothing else (no transitivity through it), and every hazard names its producer.
+  bool producerWaits = false;
 };
 
 class ResourceTable;
