     Barrier& b = list.back();
     b.after |= after;
     b.before |= before;
     for (int k = 0; k < kHazardKinds; ++k)
       if ((kinds >> k & 1) && !(b.hazards >> k & 1)) ++out_.stats.hazards[k];
     b.hazards |= kinds;
+    if (producers_)
+      for (uint32_t e : prod_)
+        if (auto it = std::lower_bound(b.producers.begin(), b.producers.end(), e); it == b.producers.end() || *it != e)
+          b.producers.insert(it, e);
