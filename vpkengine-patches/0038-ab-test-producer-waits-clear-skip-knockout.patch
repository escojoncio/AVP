+// CompileOptions::producerWaits (patch 0038): with waits only on Barrier::producers, every conflicting pair of
+// accesses in different encoders must still be ordered, directly or through a chain of producer waits, and two
+// conflicting items of one compute encoder must have a barrier between them.
+void testProducerWaits() {
+  std::mt19937 rng(4321);
+  auto R = [&](int n) { return int(rng() % unsigned(n)); };
+  uint32_t violations = 0, pairs = 0, barriersLegacy = 0, barriersProd = 0;
+  for (int it = 0; it < 3000; ++it) {
+    Scene s;
+    std::vector<BufferId> bufs = {s.buf(), s.buf(), s.buf()};
+    std::vector<TextureId> tex = {s.rt(), s.rt(), s.rt(), s.depthRt()};
+    auto bufAcc = [&](bool w, StageMask st) {
+      const uint64_t off = uint64_t(R(4)) * 1024;
+      Access a{ResourceRange::bytes(bufs[R(3)], off, 1024), st, w};
+      return a;
+    };
+    auto texAcc = [&](bool w, StageMask st) {
+      Access a{ResourceRange::subresource(tex[R(3)], 0, 1, 0, 1), st, w};
+      return a;
+    };
+    Frame f;
+    for (int c = 3 + R(10); c > 0; --c) {
+      const int k = R(6);
+      if (k <= 1) {
+        std::vector<Access> b;
+        for (int n = 1 + R(3); n > 0; --n) b.push_back(R(2) ? bufAcc(R(2), stage::compute) : texAcc(R(3) == 0, stage::compute));
+        f.dispatch(Scene::compute(b));
+      } else if (k == 2) {
+        f.copyBuffer(Scene::span(bufs[R(3)], uint64_t(R(4)) * 1024, 1024), Scene::span(bufs[R(3)], uint64_t(R(4)) * 1024, 1024));
+      } else if (k == 3) {
+        f.fillBuffer(Scene::span(bufs[R(3)], uint64_t(R(4)) * 1024, 1024), 0);
+      } else {
+        RenderPassDesc pd;
+        pd.colors[0].texture = tex[R(3)];
+        pd.colors[0].load = LoadAction(R(3));
+        if (R(2)) pd.depth = {tex[3], 0, 0, LoadAction(R(3)), StoreAction::Store, {}, {}, 0, 0};
+        std::vector<Access> b;
+        for (int n = R(3); n > 0; --n) {
+          if (R(2)) b.push_back(bufAcc(false, R(2) ? stage::vertex : stage::fragment));
+          else {
+            const TextureId t = tex[R(3)];
+            if (t == pd.colors[0].texture) continue;
+            b.push_back(Scene::sample(t));
+          }
+        }
+        Scene::passWithDraw(f, pd, b);
+      }
+    }
+    CompileOptions po;
+    po.producerWaits = true;
+    const CompiledFrame cf = compileFrame(f, &s.res, po);
+    barriersLegacy += uint32_t(compileFrame(f, &s.res).barriers.size());
+    barriersProd += uint32_t(cf.barriers.size());
+    CHECK(cf.producerWaits);
+    const auto& cmds = f.commands();
+    // Position of every command.
+    std::vector<std::pair<uint32_t, uint32_t>> pos(cmds.size(), {UINT32_MAX, 0});
+    for (uint32_t e = 0; e < cf.encoders.size(); ++e)
+      for (uint32_t k = 0; k < cf.encoders[e].commands.size(); ++k)
+        pos[cf.encoders[e].commands[k]] = {e, cf.encoders[e].kind == Encoder::Kind::Render ? 0 : k};
+    // Producers each encoder waits on (any item), and the item barriers.
+    std::vector<std::set<uint32_t>> waits(cf.encoders.size());
+    for (const Barrier& b : cf.barriers)
+      for (uint32_t x : b.producers)
+        if (x != b.encoder) waits[b.encoder].insert(x);
+    auto reaches = [&](uint32_t from, uint32_t to) {  // `from` ordered after `to` through producer waits
+      std::vector<uint32_t> st = {from};
+      std::set<uint32_t> seen;
+      while (!st.empty()) {
+        const uint32_t x = st.back();
+        st.pop_back();
+        if (x == to) return true;
+        if (!seen.insert(x).second) continue;
+        for (uint32_t y : waits[x]) st.push_back(y);
+      }
+      return false;
+    };
+    auto accessesFor = [&](uint32_t ci) {
+      std::vector<Access> v;
+      if (const auto* rp = std::get_if<RenderPass>(&cmds[ci])) {
+        v = attachmentAccesses(rp->desc);
+        for (const Draw& d : rp->draws)
+          for (const Access& a : drawAccesses(d)) v.push_back(a);
+      } else if (const auto* d = std::get_if<Dispatch>(&cmds[ci])) {
+        v = d->bindings;
+      } else {
+        v = copyAccesses(std::get<Copy>(cmds[ci]));
+      }
+      return v;
+    };
+    for (uint32_t i = 0; i < cmds.size(); ++i) {
+      if (pos[i].first == UINT32_MAX) continue;
+      for (uint32_t j = 0; j < cmds.size(); ++j) {
+        if (pos[j].first == UINT32_MAX || !(pos[i] < pos[j])) continue;
+        bool conflict = false;
+        for (const Access& a : accessesFor(i))
+          for (const Access& b : accessesFor(j))
+            if (a.range.kind != ResourceRange::Kind::Sampler && a.range.overlaps(b.range) && (a.write || b.write) &&
+                !(a.pixelLocal || b.pixelLocal))
+              conflict = true;
+        if (!conflict) continue;
+        // Only pairs in submission order matter (the compiler may reorder independent work).
+        if (i > j) continue;
+        ++pairs;
+        if (pos[i].first != pos[j].first) {
+          violations += !reaches(pos[j].first, pos[i].first);
+        } else {
+          bool sep = false;
+          for (const Barrier& b : cf.barriers)
+            sep = sep || (b.encoder == pos[j].first && b.item > pos[i].second && b.item <= pos[j].second);
+          violations += !sep;
+        }
+      }
+    }
+  }
+  std::printf("  producers: 3000 frames, %u conflicting pairs, barriers legacy %u / producer mode %u, %u violations\n",
+              pairs, barriersLegacy, barriersProd, violations);
+  CHECK_EQ(violations, 0u);
+}
