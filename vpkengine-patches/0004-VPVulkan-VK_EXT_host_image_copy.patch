+}  // namespace vpvk
+
+// =================================================================================================
+// VK_EXT_host_image_copy. Images live in Metal private storage, so a host copy is a staged GPU copy
+// submitted on its own and waited for (that frame only): memory -> page-aligned staging buffer ->
+// texture, texture -> staging -> memory, texture -> texture. Layout transitions are no-ops (layouts
+// are not tracked). Row pitches follow memoryRowLength / memoryImageHeight like buffer copies.
+// =================================================================================================
+namespace vpvk {
+namespace {
+
+struct Staging {
+  uint8_t* host = nullptr;
+  vpgpu::BufferId id;
+  Device* d = nullptr;
+  Staging(Device& dev, uint64_t bytes) : d(&dev) {
+    const uint64_t size = (std::max<uint64_t>(bytes, 1) + 16383) & ~uint64_t(16383);
+    host = static_cast<uint8_t*>(std::aligned_alloc(16384, size));
+    vpgpu::BufferDesc bd;
+    bd.size = size, bd.guestMemory = host, bd.label = "vk.host_image_copy";
+    std::lock_guard<std::mutex> lock(d->submitMutex);
+    id = d->gpu->createBuffer(bd);
+  }
+  ~Staging() {
+    {
+      std::lock_guard<std::mutex> lock(d->submitMutex);
+      if (id) d->gpu->destroy(id);
+    }
+    std::free(host);
+  }
+};
+
+// Bytes of one layer of a region and its row pitch, in the image's block units.
+void regionPitch(const Image& im, uint32_t rowLength, uint32_t imageHeight, const VkExtent3D& e, uint32_t& row,
+                 uint32_t& rows, uint64_t& layerBytes) {
+  const vpgpu::FormatInfo& fi = vpgpu::formatInfo(im.desc.format);
+  const uint32_t w = rowLength ? rowLength : e.width, h = imageHeight ? imageHeight : e.height;
+  row = (w + fi.blockSize - 1) / fi.blockSize * fi.bytesPerBlock;
+  rows = (h + fi.blockSize - 1) / fi.blockSize;
+  layerBytes = uint64_t(row) * rows * std::max(1u, e.depth);
+}
+
+vpgpu::TextureSpan span(const Image& im, const VkImageSubresourceLayers& s, const VkOffset3D& o, const VkExtent3D& e) {
+  const uint16_t layers = s.layerCount == VK_REMAINING_ARRAY_LAYERS ? uint16_t(im.desc.layers - s.baseArrayLayer)
+                                                                     : uint16_t(s.layerCount);
+  return {im.id, uint16_t(s.mipLevel), uint16_t(s.baseArrayLayer), layers, uint32_t(o.x), uint32_t(o.y), uint32_t(o.z),
+          e.width, e.height, std::max(1u, e.depth)};
+}
+
+// Submits `frame` and waits for it.
+VkResult runNow(Device& d, const vpgpu::Frame& frame) {
+  uint64_t f;
+  {
+    std::lock_guard<std::mutex> lock(d.submitMutex);
+    f = d.gpu->submit(frame).frame;
+    d.lastFrame = f;
+  }
+  return d.waitFrame(f, UINT64_MAX) ? VK_SUCCESS : VK_ERROR_DEVICE_LOST;
+}
+
+}  // namespace
+}  // namespace vpvk
+
+VPVK_EXPORT VKAPI_ATTR VkResult VKAPI_CALL vkCopyMemoryToImageEXT(VkDevice dv, const VkCopyMemoryToImageInfoEXT* ci) {
+  Device& d = *from<Device>(dv);
+  const Image& im = *from<Image>(ci->dstImage);
+  if (!im.id) return VK_ERROR_MEMORY_MAP_FAILED;
+  for (uint32_t i = 0; i < ci->regionCount; ++i) {
+    const VkMemoryToImageCopyEXT& r = ci->pRegions[i];
+    uint32_t row, rows;
+    uint64_t layerBytes;
+    regionPitch(im, r.memoryRowLength, r.memoryImageHeight, r.imageExtent, row, rows, layerBytes);
+    vpgpu::Copy c;
+    c.kind = vpgpu::CopyKind::BufferToTexture;
+    c.dstTexture = span(im, r.imageSubresource, r.imageOffset, r.imageExtent);
+    const uint64_t bytes = layerBytes * c.dstTexture.layerCount;
+    Staging st(d, bytes);
+    if (!st.id) return VK_ERROR_OUT_OF_HOST_MEMORY;
+    std::memcpy(st.host, r.pHostPointer, bytes);
+    c.srcBuffer = {st.id, 0, bytes, row, rows};
+    c.label = "vk.host_upload";
+    vpgpu::Frame frame;
+    frame.copy(std::move(c));
+    if (VkResult res = runNow(d, frame)) return res;
+  }
+  return VK_SUCCESS;
+}
+
+VPVK_EXPORT VKAPI_ATTR VkResult VKAPI_CALL vkCopyImageToMemoryEXT(VkDevice dv, const VkCopyImageToMemoryInfoEXT* ci) {
+  Device& d = *from<Device>(dv);
+  const Image& im = *from<Image>(ci->srcImage);
+  if (!im.id) return VK_ERROR_MEMORY_MAP_FAILED;
+  for (uint32_t i = 0; i < ci->regionCount; ++i) {
+    const VkImageToMemoryCopyEXT& r = ci->pRegions[i];
+    uint32_t row, rows;
+    uint64_t layerBytes;
+    regionPitch(im, r.memoryRowLength, r.memoryImageHeight, r.imageExtent, row, rows, layerBytes);
+    vpgpu::Copy c;
+    c.kind = vpgpu::CopyKind::TextureToBuffer;
+    c.srcTexture = span(im, r.imageSubresource, r.imageOffset, r.imageExtent);
+    const uint64_t bytes = layerBytes * c.srcTexture.layerCount;
+    Staging st(d, bytes);
+    if (!st.id) return VK_ERROR_OUT_OF_HOST_MEMORY;
+    c.dstBuffer = {st.id, 0, bytes, row, rows};
+    c.label = "vk.host_readback";
+    vpgpu::Frame frame;
+    frame.copy(std::move(c));
+    if (VkResult res = runNow(d, frame)) return res;
+    std::memcpy(r.pHostPointer, st.host, bytes);
+  }
+  return VK_SUCCESS;
+}
+
+VPVK_EXPORT VKAPI_ATTR VkResult VKAPI_CALL vkCopyImageToImageEXT(VkDevice dv, const VkCopyImageToImageInfoEXT* ci) {
+  Device& d = *from<Device>(dv);
+  const Image &src = *from<Image>(ci->srcImage), &dst = *from<Image>(ci->dstImage);
+  if (!src.id || !dst.id) return VK_ERROR_MEMORY_MAP_FAILED;
+  vpgpu::Frame frame;
+  for (uint32_t i = 0; i < ci->regionCount; ++i) {
+    const VkImageCopy2& r = ci->pRegions[i];
+    vpgpu::Copy c;
+    c.kind = vpgpu::CopyKind::TextureToTexture;
+    c.srcTexture = span(src, r.srcSubresource, r.srcOffset, r.extent);
+    c.dstTexture = span(dst, r.dstSubresource, r.dstOffset, r.extent);
+    c.label = "vk.host_image_copy";
+    frame.copy(std::move(c));
+  }
+  return frame.commands().empty() ? VK_SUCCESS : runNow(d, frame);
+}
+
+VPVK_EXPORT VKAPI_ATTR VkResult VKAPI_CALL vkTransitionImageLayoutEXT(VkDevice, uint32_t, const VkHostImageLayoutTransitionInfoEXT*) {
+  return VK_SUCCESS;
+}
+
+extern "C" void vkGetImageSubresourceLayout(VkDevice, VkImage, const VkImageSubresource*, VkSubresourceLayout*);
+VPVK_EXPORT VKAPI_ATTR void VKAPI_CALL vkGetImageSubresourceLayout2KHR(VkDevice dv, VkImage im, const VkImageSubresource2KHR* s,
+                                                                       VkSubresourceLayout2KHR* out) {
+  vkGetImageSubresourceLayout(dv, im, &s->imageSubresource, &out->subresourceLayout);
+}
+
+namespace vpvk {
+PFN_vkVoidFunction lookupHostImageCopy(const char* name) {
+  struct E {
+    const char* name;
+    PFN_vkVoidFunction fn;
+  };
+#define F(f) {#f, reinterpret_cast<PFN_vkVoidFunction>(&f)}
+  static const E table[] = {
+      F(vkCopyMemoryToImageEXT), F(vkCopyImageToMemoryEXT), F(vkCopyImageToImageEXT), F(vkTransitionImageLayoutEXT),
+      F(vkGetImageSubresourceLayout2KHR),
+  };
+#undef F
+  if (!std::strcmp(name, "vkGetImageSubresourceLayout2EXT")) name = "vkGetImageSubresourceLayout2KHR";
   for (const E& e : table)
     if (!std::strcmp(e.name, name)) return e.fn;
   return nullptr;
