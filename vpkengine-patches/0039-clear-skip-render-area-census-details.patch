From ef45c421b7a921d615fc38621fe09c43bc894823 Mon Sep 17 00:00:00 2001
From: Claude <claude@users.invalid>
Date: Thu, 15 Oct 2026 10:10:24 +0000
Subject: [PATCH] VPKEngine 0039: clear skip accepts a full render area,
 pipeline census details and MSL dump, runtime switches from VPVK_RUNTIME_OPTS

---
 gpu/metal2/src/metal_backend.mm | 115 +++++++++++++++++++++++++++++---
 1 file changed, 106 insertions(+), 9 deletions(-)

diff --git a/gpu/metal2/src/metal_backend.mm b/gpu/metal2/src/metal_backend.mm
index efe0ea9..234adcd 100644
--- a/gpu/metal2/src/metal_backend.mm
+++ b/gpu/metal2/src/metal_backend.mm
@@ -84,10 +84,18 @@ struct CensusEntry {
   uint64_t frames = 0, draws = 0;
   uint64_t lastFrame = UINT64_MAX;
   bool compute = false;
+  // 0039: what it is (shader ids, the first encoder it was seen in) and how much it draws (vertices x instances of
+  // its direct draws; indirect ones are counted apart, their sizes live on the GPU).
+  uint64_t vs = 0, fs = 0, cs = 0, work = 0, indirect = 0;
+  std::string target;
 };
 std::mutex gCensusMutex;
 std::unordered_map<uint64_t, CensusEntry> gCensus;
 std::atomic<bool> gCensusOn{false};
+// 0039: writes a pipeline's shader sources (set by the live MetalBackend, which owns the shader provider).
+std::mutex gDumpMslMutex;
+std::function<int(uint64_t, const uint64_t*, const char*)> gDumpMsl;
+const void* gDumpMslOwner = nullptr;  // the backend that set gDumpMsl (a replaced queue's old backend must not clear it)
 uint64_t gCensusFrames = 0;  // under gCensusMutex
 // Exclusive GPU time of each completed command buffer (vpgpu_metal2_cb_busy_ms, for the host's pace governor):
 // its encoders' stage-boundary timestamps placed on one timeline, each counted only for how far it moves the
@@ -878,6 +886,11 @@ void MetalBackend::Impl::init() {
   if (dumpFrame >= 0) info("gpu.dump armed frame=" + std::to_string(dumpFrame) + " dir=" + token(dumpDir));
   if (const char* o = std::getenv("VP_CB_ORDER"); o && *o == '0') cbOrder = false;
   if (const char* o = std::getenv("VP_CB_ORDER"); o && *o == '2') cbTracked = true;
+  // 0039: patch 0038's runtime switches at start (vpgpu::RuntimeOpt bits; the host's A/B test may change them live).
+  if (const char* o = std::getenv("VPVK_RUNTIME_OPTS"); o && *o) {
+    gRuntimeOpts.store(uint32_t(std::strtoul(o, nullptr, 0)));
+    info("gpu.opts runtime=" + std::to_string(gRuntimeOpts.load()) + " (VPVK_RUNTIME_OPTS)");
+  }
   info("gpu.order armed cb_order=" + std::to_string(cbOrder ? (cbTracked ? 2 : 1) : 0) + " slots=" + std::to_string(n));
   if (const char* x = std::getenv("VP_EXCL_TIMING"); x && *x == '0') exclOn = false;
   if (const char* x = std::getenv("VP_EXCL_SECONDS"); x && *x) exclWindowS = std::max(1.0, std::strtod(x, nullptr));
@@ -2384,7 +2397,12 @@ void MetalBackend::Impl::submit(uint64_t frameIndex, const Frame& frame, const C
   }
   const uint64_t knockKey = gKnockKey.load(std::memory_order_relaxed);
   const bool censusNow = gCensusOn.load(std::memory_order_relaxed) && realFrame;
-  std::unordered_map<uint64_t, std::pair<uint64_t, bool>> censusFrame;  // key -> draws, compute
+  struct CensusFrame {
+    uint64_t draws = 0, work = 0, indirect = 0, vs = 0, fs = 0, cs = 0;
+    bool compute = false;
+    uint32_t enc = 0;  // the first encoder it was seen in (its target, from diag, once the frame is encoded)
+  };
+  std::unordered_map<uint64_t, CensusFrame> censusFrame;
   gOptCbs.fetch_add(1, std::memory_order_relaxed);
   if (prodMode) gProdCbs.fetch_add(1, std::memory_order_relaxed);
   // prodMode: the Metal fences each core encoder updated so far (a core encoder may end up as several Metal ones).
@@ -2920,13 +2938,21 @@ void MetalBackend::Impl::submit(uint64_t frameIndex, const Frame& frame, const C
       if (c.texture) return false;
     for (uint32_t ci : en.commands) {
       const auto* rpc = std::get_if<RenderPass>(&cmds[ci]);
-      if (!rpc || !rpc->draws.empty() || rpc->desc.renderWidth || rpc->desc.renderHeight) return false;
+      if (!rpc || !rpc->draws.empty()) return false;
       for (const Attachment& c : rpc->desc.colors)
         if (c.texture) return false;
       if (!rpc->desc.depth.texture || !rpc->desc.depth.sameTarget(d)) return false;
     }
     id<MTLTexture> t = texture(d.texture);
     if (!t || t.sampleCount != 1 || t.storageMode == MTLStorageModeMemoryless) return false;
+    // Vulkan always gives a render area: it must cover the whole mip (then Metal renders, and clears, the whole
+    // target, as the encoder does: renderTargetWidth is only set for a smaller area). Logs_Alyx_35: the 4096x4096
+    // shadow atlas clear has render area 4096x4096, which "no render area" alone never matched.
+    const NSUInteger mw = std::max<NSUInteger>(1, t.width >> d.mip), mh = std::max<NSUInteger>(1, t.height >> d.mip);
+    for (uint32_t ci : en.commands) {
+      const RenderPassDesc& pd = std::get<RenderPass>(cmds[ci]).desc;
+      if ((pd.renderWidth || pd.renderHeight) && (pd.renderWidth < mw || pd.renderHeight < mh)) return false;
+    }
     const MTLPixelFormat pf = t.pixelFormat;
     if (pf != MTLPixelFormatDepth32Float && pf != MTLPixelFormatDepth16Unorm && pf != MTLPixelFormatDepth32Float_Stencil8)
       return false;
@@ -3198,8 +3224,12 @@ void MetalBackend::Impl::submit(uint64_t frameIndex, const Frame& frame, const C
           }
           const Pipeline* p = pipeline(d.pipeline);
           if (p && censusNow) {
-            auto& cf = censusFrame[p->key];
-            cf.first++;
+            auto [it, fresh] = censusFrame.try_emplace(p->key);
+            CensusFrame& cf = it->second;
+            if (fresh) cf.enc = e, cf.vs = p->vs, cf.fs = p->fs;
+            cf.draws++;
+            if (d.indirect) cf.indirect++;
+            else cf.work += uint64_t{d.count} * std::max(1u, d.instances);
             if (!pipelineLabels.count(p->key)) pipelineLabels[p->key] = p->label;
           }
           if (p && knockKey && p->key == knockKey) {  // A/B "one shader out" probe
@@ -3451,9 +3481,11 @@ void MetalBackend::Impl::submit(uint64_t frameIndex, const Frame& frame, const C
         const Dispatch& d = std::get<Dispatch>(cmd);
         const Pipeline* p = pipeline(d.pipeline);
         if (p && censusNow) {
-          auto& cf = censusFrame[p->key];
-          cf.first++;
-          cf.second = true;
+          auto [it, fresh] = censusFrame.try_emplace(p->key);
+          CensusFrame& cf = it->second;
+          if (fresh) cf.enc = e, cf.cs = p->cs;
+          cf.draws++;
+          cf.compute = true;
           if (!pipelineLabels.count(p->key)) pipelineLabels[p->key] = p->label;
         }
         if (p && knockKey && p->key == knockKey) {
@@ -3612,8 +3644,22 @@ void MetalBackend::Impl::submit(uint64_t frameIndex, const Frame& frame, const C
     for (const auto& [k, v] : censusFrame) {
       CensusEntry& c = gCensus[k];
       c.frames++;
-      c.draws += v.first;
-      c.compute = v.second;
+      c.draws += v.draws;
+      c.work += v.work;
+      c.indirect += v.indirect;
+      c.compute = v.compute;
+      c.vs = v.vs, c.fs = v.fs, c.cs = v.cs;
+      if (c.target.empty() && v.enc < diag->size()) {
+        const EncDiag& g = (*diag)[v.enc];
+        char t[160];
+        if (g.kind == 'r')
+          std::snprintf(t, sizeof t, "enc %u render %ux%u layers %u samples %u c0 %s depth %s", v.enc, g.width, g.height,
+                        g.layers, g.samples, g.color0 ? dumpFormatToken(MTLPixelFormat(g.color0)).c_str() : "-",
+                        g.depth ? dumpFormatToken(MTLPixelFormat(g.depth)).c_str() : "-");
+        else
+          std::snprintf(t, sizeof t, "enc %u compute", v.enc);
+        c.target = t;
+      }
       if (c.label.empty())
         if (auto it = pipelineLabels.find(k); it != pipelineLabels.end()) c.label = it->second;
     }
@@ -4066,9 +4112,32 @@ MetalBackend::MetalBackend(const ShaderProvider& shaders, LogSink log, MetalOpti
   @autoreleasepool {
     impl_->init();
   }
+  Impl* impl = impl_.get();
+  std::lock_guard lock(gDumpMslMutex);
+  gDumpMslOwner = impl;
+  gDumpMsl = [impl](uint64_t key, const uint64_t* ids, const char* dir) -> int {
+    static const char* const kSuffix[3] = {"vs", "fs", "cs"};
+    int written = 0;
+    for (int i = 0; i < 3; ++i) {
+      if (!ids[i]) continue;
+      MslShader msl;
+      if (!impl->shaders.find(ids[i], msl)) continue;
+      char name[64];
+      std::snprintf(name, sizeof name, "shader-%016llx-%s.metal", (unsigned long long)key, kSuffix[i]);
+      std::ofstream out(std::filesystem::path(dir) / name);
+      if (!out) continue;
+      out << "// pipeline " << std::hex << key << " shader " << ids[i] << std::dec << " entry: " << msl.entry << "\n" << msl.source;
+      ++written;
+    }
+    return written;
+  };
 }
 
 MetalBackend::~MetalBackend() {
+  {
+    std::lock_guard lock(gDumpMslMutex);
+    if (gDumpMslOwner == impl_.get()) gDumpMsl = nullptr, gDumpMslOwner = nullptr;
+  }
   impl_->closing = true;
   for (dispatch_queue_t q : impl_->prewarmQueues)
     if (q) dispatch_sync(q, ^{});  // queued prewarms see `closing`; the running one finishes
@@ -4921,6 +4990,34 @@ extern "C" __attribute__((visibility("default"))) void vpgpu_metal2_opt_counters
   out[3] = gClearCandidates.load(), out[4] = gClearSkipped.load(), out[5] = gKnocked.load();
   out[6] = gIndirectCountDraws.load(), out[7] = gIndirectEncoded.load(), out[8] = gIndirectReal.load();
 }
+// 0039: one census pipeline described (shader ids, target, work per frame); 0 when unknown.
+extern "C" __attribute__((visibility("default"))) int vpgpu_metal2_census_detail(uint64_t key, char* out, int n) {
+  using namespace vpgpu::metal2;
+  std::lock_guard lock(gCensusMutex);
+  auto it = gCensus.find(key);
+  if (it == gCensus.end() || !out || n <= 0) return 0;
+  const CensusEntry& c = it->second;
+  const double f = c.frames ? double(c.frames) : 1.0;
+  std::snprintf(out, size_t(n), "vs=%016llx fs=%016llx cs=%016llx | %s | draws/frame %.1f (indirect %.1f) verts*inst/frame %.0f",
+                (unsigned long long)c.vs, (unsigned long long)c.fs, (unsigned long long)c.cs, c.target.c_str(),
+                double(c.draws) / f, double(c.indirect) / f, double(c.work) / f);
+  return 1;
+}
+// 0039: writes the MSL of one census pipeline's shaders into `dir` (<pipeline key>-vs.metal / -fs / -cs).
+// Returns the files written.
+extern "C" __attribute__((visibility("default"))) int vpgpu_metal2_dump_pipeline_msl(uint64_t key, const char* dir) {
+  using namespace vpgpu::metal2;
+  uint64_t ids[3] = {0, 0, 0};
+  {
+    std::lock_guard lock(gCensusMutex);
+    auto it = gCensus.find(key);
+    if (it == gCensus.end()) return 0;
+    ids[0] = it->second.vs, ids[1] = it->second.fs, ids[2] = it->second.cs;
+  }
+  if (!dir || !*dir) return 0;
+  std::lock_guard lock(gDumpMslMutex);
+  return gDumpMsl ? gDumpMsl(key, ids, dir) : 0;
+}
 // Encoders of the latest real frame (8+ encoders, a layered pass): Alyx's Valve logo has ~28, the menu ~80. 0 when
 // no real frame was encoded in the last 500 ms (a loading screen): a stale value is never reported.
 extern "C" __attribute__((visibility("default"))) uint32_t vpgpu_metal2_last_real_encoders(void) {
-- 
2.43.0

