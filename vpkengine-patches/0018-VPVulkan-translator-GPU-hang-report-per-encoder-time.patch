+// ---- Hang quarantine ---------------------------------------------------------------------------
+
+void MetalBackend::Impl::loadQuarantine() {
+  const char* off = std::getenv("VP_QUARANTINE");
+  quarantineOn = !(off && *off == '0');
+  const char* dir = std::getenv("VP_PIPELINE_CACHE_DIR");
+  if (dir && *dir) quarantineDir = dir;
+  if (!quarantineOn) {
+    info("gpu.quarantine off (VP_QUARANTINE=0)");
+    return;
+  }
+  if (quarantineDir.empty()) return;
+  std::ifstream in(std::filesystem::path(quarantineDir) / "quarantine.txt");
+  std::string line;
+  uint32_t n = 0;
+  std::lock_guard lock(quarantineMutex);
+  {  // keys blamed once in an earlier session (suspects.txt): a second hang on one persists it
+    std::ifstream sin(std::filesystem::path(quarantineDir) / "suspects.txt");
+    std::string sl;
+    while (std::getline(sin, sl)) {
+      const unsigned long long k = std::strtoull(sl.c_str(), nullptr, 16);
+      if (k) suspects.insert(k);
+    }
+  }
+  while (std::getline(in, line)) {
+    if (line.empty() || line[0] == '#') continue;
+    char* end = nullptr;
+    const unsigned long long key = std::strtoull(line.c_str(), &end, 16);
+    if (!key || end == line.c_str()) continue;
+    if (quarantine.emplace(key, line).second) {
+      ++n;
+      info("gpu.quarantine loaded " + line);
+    }
+  }
+  if (n) {
+    ++quarantineSerial;
+    info("gpu.quarantine loaded_total=" + std::to_string(n) + " file=" + token(quarantineDir + "/quarantine.txt") +
+         " (delete it to retry them)");
+  }
+}
+
+// Any thread (the completion handler). Logs, adds and appends the line to the file once per key.
+void MetalBackend::Impl::quarantineAdd(uint64_t key, const std::string& desc, uint64_t frameIndex) {
+  if (!quarantineOn || !key) return;
+  bool persisted = false;
+  char hex[24];
+  std::snprintf(hex, sizeof hex, "%016llx", (unsigned long long)key);
+  const std::string line = std::string(hex) + " " + desc;
+  {
+    std::lock_guard lock(quarantineMutex);
+    if (!quarantine.emplace(key, line).second) return;
+    // This session skips it at once; the file (every later session) only after a second hang on the same
+    // key, in this or an earlier session: one hang is not proof (another encoder may have caused it).
+    persisted = suspects.count(key) != 0;
+    if (!quarantineDir.empty()) {
+      std::error_code ec;
+      std::filesystem::create_directories(quarantineDir, ec);
+      std::ofstream out(std::filesystem::path(quarantineDir) / (persisted ? "quarantine.txt" : "suspects.txt"),
+                        std::ios::app);
+      out << line << "\n";
+    }
+    suspects.insert(key);
+  }
+  ++quarantineSerial;
+  info("gpu.quarantine f=" + std::to_string(frameIndex) + (persisted ? " persisted=1" : " persisted=0(suspect)") +
+       " pipeline=" + line);
+}
+
+// The MSL of a shader named in a hang report, next to the quarantine file (hang/<id>.metal), so
+// the report's ids can be read without VPVK_DUMP_DIR. Once per id.
+void MetalBackend::Impl::dumpShaderSource(uint64_t shaderId) {
+  if (!shaderId || quarantineDir.empty()) return;
+  static std::mutex m;
+  static std::unordered_set<uint64_t> done;
+  {
+    std::lock_guard lock(m);
+    if (!done.insert(shaderId).second) return;
+  }
+  MslShader msl;
+  if (!shaders.find(shaderId, msl)) return;
+  char name[40];
+  std::snprintf(name, sizeof name, "%016llx.metal", (unsigned long long)shaderId);
+  std::error_code ec;
+  const std::filesystem::path dir = std::filesystem::path(quarantineDir) / "hang";
+  std::filesystem::create_directories(dir, ec);
+  std::ofstream out(dir / name);
+  out << "// entry: " << msl.entry << "\n" << msl.source;
+  info("gpu.hang.msl id=" + std::string(name, 16) + " file=" + token((dir / name).string()));
+}
