From 16c3d5696a460a37cbaeb064edded622db3b24f7 Mon Sep 17 00:00:00 2001
From: Claude <claude@users.invalid>
Date: Tue, 13 Oct 2026 13:21:50 +0000
Subject: [PATCH] VPVulkan: every BC format (textureCompressionBC promises
 them; Source 2 checks at init), 3-component vertex formats, vk.format
 unsupported log, feature/property structs filled, IFP sample counts and 3D
 extent, host memcpy size

---
 gpu/vulkan/src/entry.cpp           | 28 +++++++++++---
 gpu/vulkan/src/physical_device.cpp | 61 ++++++++++++++++++++++++++++++
 gpu/vulkan/src/sync.cpp            |  4 ++
 3 files changed, 88 insertions(+), 5 deletions(-)

diff --git a/gpu/vulkan/src/entry.cpp b/gpu/vulkan/src/entry.cpp
index 517bf3a..edd8498 100644
--- a/gpu/vulkan/src/entry.cpp
+++ b/gpu/vulkan/src/entry.cpp
@@ -375,6 +375,14 @@ VPVK_EXPORT VKAPI_ATTR void VKAPI_CALL vkGetPhysicalDeviceFormatProperties(VkPhy
                             (VK_FORMAT_FEATURE_TRANSFER_SRC_BIT | VK_FORMAT_FEATURE_TRANSFER_DST_BIT |
                              VK_FORMAT_FEATURE_SAMPLED_IMAGE_BIT);
   p->bufferFeatures = formatFeatures(f, true);
+  // A format the game asks about and gets nothing for: the first 64 are named (an engine that
+  // refuses to start over a missing format then says which one in the log).
+  if (!p->optimalTilingFeatures && !p->bufferFeatures) {
+    static std::mutex m;
+    static std::set<int> seen;
+    std::lock_guard<std::mutex> lock(m);
+    if (seen.size() < 64 && seen.insert(int(f)).second) logf("vk.format unsupported=%d", int(f));
+  }
 }
 
 VPVK_EXPORT VKAPI_ATTR void VKAPI_CALL vkGetPhysicalDeviceFormatProperties2(VkPhysicalDevice pd,
@@ -399,7 +407,7 @@ VPVK_EXPORT VKAPI_ATTR void VKAPI_CALL vkGetPhysicalDeviceFormatProperties2(VkPh
 
 VPVK_EXPORT VKAPI_ATTR VkResult VKAPI_CALL vkGetPhysicalDeviceImageFormatProperties(
     VkPhysicalDevice, VkFormat f, VkImageType type, VkImageTiling tiling, VkImageUsageFlags usage,
-    VkImageCreateFlags, VkImageFormatProperties* out) {
+    VkImageCreateFlags flags, VkImageFormatProperties* out) {
   const VkFormatFeatureFlags ff = formatFeatures(f, false);
   if (!ff) return VK_ERROR_FORMAT_NOT_SUPPORTED;
   if ((usage & VK_IMAGE_USAGE_STORAGE_BIT) && !(ff & VK_FORMAT_FEATURE_STORAGE_IMAGE_BIT))
@@ -414,12 +422,18 @@ VPVK_EXPORT VKAPI_ATTR VkResult VKAPI_CALL vkGetPhysicalDeviceImageFormatPropert
     return VK_ERROR_FORMAT_NOT_SUPPORTED;
   const auto& l = deviceProperties().limits;
   *out = {};
-  out->maxExtent = {l.maxImageDimension2D, type == VK_IMAGE_TYPE_1D ? 1u : l.maxImageDimension2D,
-                    type == VK_IMAGE_TYPE_3D ? l.maxImageDimension3D : 1u};
+  if (type == VK_IMAGE_TYPE_3D)
+    out->maxExtent = {l.maxImageDimension3D, l.maxImageDimension3D, l.maxImageDimension3D};
+  else
+    out->maxExtent = {l.maxImageDimension2D, type == VK_IMAGE_TYPE_1D ? 1u : l.maxImageDimension2D, 1u};
   out->maxMipLevels = 15;
   out->maxArrayLayers = type == VK_IMAGE_TYPE_3D ? 1 : l.maxImageArrayLayers;
-  out->sampleCounts = tiling == VK_IMAGE_TILING_OPTIMAL && type == VK_IMAGE_TYPE_2D
-                          ? l.framebufferColorSampleCounts : VkSampleCountFlags{VK_SAMPLE_COUNT_1_BIT};
+  // Multisampling only for 2D optimal non-cube images of a renderable format (Vulkan spec,
+  // vkGetPhysicalDeviceImageFormatProperties: sampleCounts); compressed formats are 1x only.
+  const bool msaa = tiling == VK_IMAGE_TILING_OPTIMAL && type == VK_IMAGE_TYPE_2D &&
+                    !(flags & VK_IMAGE_CREATE_CUBE_COMPATIBLE_BIT) &&
+                    (ff & (VK_FORMAT_FEATURE_COLOR_ATTACHMENT_BIT | VK_FORMAT_FEATURE_DEPTH_STENCIL_ATTACHMENT_BIT));
+  out->sampleCounts = msaa ? l.framebufferColorSampleCounts : VkSampleCountFlags{VK_SAMPLE_COUNT_1_BIT};
   out->maxResourceSize = 1ull << 32;
   return VK_SUCCESS;
 }
@@ -829,6 +843,10 @@ VPVK_EXPORT VKAPI_ATTR VkResult VKAPI_CALL vkCreateImageView(VkDevice dv, const
           case VK_COMPONENT_SWIZZLE_A: s = 5; break;
           default: break;  // IDENTITY
         }
+        // BC1_RGB lives in Metal's BC1_RGBA: alpha reads one (a 3-colour block's index 3 is black,
+        // not transparent black).
+        if (s == 5 && (im->info.format == VK_FORMAT_BC1_RGB_UNORM_BLOCK || im->info.format == VK_FORMAT_BC1_RGB_SRGB_BLOCK))
+          s = 1;
         info.swizzle[c] = s;
         if (s != 2 + c) swizzled = true;
       }
diff --git a/gpu/vulkan/src/physical_device.cpp b/gpu/vulkan/src/physical_device.cpp
index 61ed8ee..da5edea 100644
--- a/gpu/vulkan/src/physical_device.cpp
+++ b/gpu/vulkan/src/physical_device.cpp
@@ -178,8 +178,16 @@ constexpr FormatRow kFormats[] = {
     {VK_FORMAT_D16_UNORM, vpgpu::Format::D16Unorm}, {VK_FORMAT_D32_SFLOAT, vpgpu::Format::D32Float},
     {VK_FORMAT_D24_UNORM_S8_UINT, vpgpu::Format::D24UnormS8},
     {VK_FORMAT_D32_SFLOAT_S8_UINT, vpgpu::Format::D32FloatS8}, {VK_FORMAT_S8_UINT, vpgpu::Format::S8Uint},
+    // textureCompressionBC = VK_TRUE promises EVERY BC format (spec, "Required Format Support"), and
+    // desktop engines check them before creating anything (Source 2: DXT1 = BC1_RGB, ATI1N = BC4,
+    // ATI2N = BC5, BC6H). BC1_RGB is BC1_RGBA with alpha forced to one (vkCreateImageView swizzle).
+    {VK_FORMAT_BC1_RGB_UNORM_BLOCK, vpgpu::Format::BC1}, {VK_FORMAT_BC1_RGB_SRGB_BLOCK, vpgpu::Format::BC1Srgb},
     {VK_FORMAT_BC1_RGBA_UNORM_BLOCK, vpgpu::Format::BC1}, {VK_FORMAT_BC1_RGBA_SRGB_BLOCK, vpgpu::Format::BC1Srgb},
+    {VK_FORMAT_BC2_UNORM_BLOCK, vpgpu::Format::BC2}, {VK_FORMAT_BC2_SRGB_BLOCK, vpgpu::Format::BC2Srgb},
     {VK_FORMAT_BC3_UNORM_BLOCK, vpgpu::Format::BC3}, {VK_FORMAT_BC3_SRGB_BLOCK, vpgpu::Format::BC3Srgb},
+    {VK_FORMAT_BC4_UNORM_BLOCK, vpgpu::Format::BC4Unorm}, {VK_FORMAT_BC4_SNORM_BLOCK, vpgpu::Format::BC4Snorm},
+    {VK_FORMAT_BC5_UNORM_BLOCK, vpgpu::Format::BC5Unorm}, {VK_FORMAT_BC5_SNORM_BLOCK, vpgpu::Format::BC5Snorm},
+    {VK_FORMAT_BC6H_UFLOAT_BLOCK, vpgpu::Format::BC6HUfloat}, {VK_FORMAT_BC6H_SFLOAT_BLOCK, vpgpu::Format::BC6HSfloat},
     {VK_FORMAT_BC7_UNORM_BLOCK, vpgpu::Format::BC7}, {VK_FORMAT_BC7_SRGB_BLOCK, vpgpu::Format::BC7Srgb},
     {VK_FORMAT_ETC2_R8G8B8_UNORM_BLOCK, vpgpu::Format::Etc2Rgb8}, {VK_FORMAT_ETC2_R8G8B8_SRGB_BLOCK, vpgpu::Format::Etc2Rgb8Srgb},
     {VK_FORMAT_ETC2_R8G8B8A1_UNORM_BLOCK, vpgpu::Format::Etc2Rgb8A1}, {VK_FORMAT_ETC2_R8G8B8A1_SRGB_BLOCK, vpgpu::Format::Etc2Rgb8A1Srgb},
@@ -212,6 +220,16 @@ vpgpu::Format toCoreFormat(VkFormat f) {
 }
 
 VkFormatFeatureFlags formatFeatures(VkFormat f, bool buffer) {
+  // Three-component vertex formats: no texture twin, but pipelines.cpp (vertexAttribute) reads them
+  // as their four-component format with the fourth left out. Engines check VERTEX_BUFFER_BIT
+  // before using them (Alyx's meshes use R32G32B32_SFLOAT positions).
+  if (buffer) switch (f) {
+      case VK_FORMAT_R32G32B32_SFLOAT: case VK_FORMAT_R32G32B32_UINT: case VK_FORMAT_R32G32B32_SINT:
+      case VK_FORMAT_R16G16B16_SFLOAT: case VK_FORMAT_R16G16B16_UNORM: case VK_FORMAT_R16G16B16_SNORM:
+      case VK_FORMAT_R8G8B8_UNORM: case VK_FORMAT_R8G8B8_SNORM:
+        return VK_FORMAT_FEATURE_VERTEX_BUFFER_BIT;
+      default: break;
+    }
   const vpgpu::Format core = toCoreFormat(f);
   if (core == vpgpu::Format::Undefined) return 0;
   const vpgpu::FormatInfo& info = vpgpu::formatInfo(core);
@@ -513,6 +531,23 @@ void fillFeatures2(void* chain) {
         reinterpret_cast<VkPhysicalDeviceHostImageCopyFeaturesEXT*>(s)->hostImageCopy =
             b(hasDeviceExtension(VK_EXT_HOST_IMAGE_COPY_EXTENSION_NAME));
         break;
+      // Structures of features this driver does not have: written as "not supported" instead of
+      // being left as the caller's bytes (an engine that does not zero them reads garbage).
+      case VK_STRUCTURE_TYPE_PHYSICAL_DEVICE_MEMORY_PRIORITY_FEATURES_EXT:
+        reinterpret_cast<VkPhysicalDeviceMemoryPriorityFeaturesEXT*>(s)->memoryPriority = VK_FALSE;
+        break;
+      case VK_STRUCTURE_TYPE_PHYSICAL_DEVICE_BUFFER_DEVICE_ADDRESS_FEATURES: {
+        auto* x = reinterpret_cast<VkPhysicalDeviceBufferDeviceAddressFeatures*>(s);
+        x->bufferDeviceAddress = x->bufferDeviceAddressCaptureReplay = x->bufferDeviceAddressMultiDevice = VK_FALSE;
+        break;
+      }
+      case VK_STRUCTURE_TYPE_PHYSICAL_DEVICE_DESCRIPTOR_INDEXING_FEATURES: {
+        auto* x = reinterpret_cast<VkPhysicalDeviceDescriptorIndexingFeatures*>(s);
+        void* n = x->pNext;
+        *x = {VK_STRUCTURE_TYPE_PHYSICAL_DEVICE_DESCRIPTOR_INDEXING_FEATURES};
+        x->pNext = n;
+        break;
+      }
       default: break;
     }
   }
@@ -613,6 +648,32 @@ void fillProperties2(void* chain) {
         x->requiredSubgroupSizeStages = p13.requiredSubgroupSizeStages;
         break;
       }
+      case VK_STRUCTURE_TYPE_PHYSICAL_DEVICE_DESCRIPTOR_INDEXING_PROPERTIES: {
+        // descriptorIndexing is VK_FALSE, but an engine that chains the struct reads its limits;
+        // leave none of it uninitialised.
+        auto* x = reinterpret_cast<VkPhysicalDeviceDescriptorIndexingProperties*>(s);
+        void* n = x->pNext;
+        const VkStructureType t = x->sType;
+        *x = {};
+        x->sType = t, x->pNext = n;
+        x->maxUpdateAfterBindDescriptorsInAllPools = p12.maxUpdateAfterBindDescriptorsInAllPools;
+        x->maxPerStageDescriptorUpdateAfterBindSamplers = p12.maxPerStageDescriptorUpdateAfterBindSamplers;
+        x->maxPerStageDescriptorUpdateAfterBindUniformBuffers = p12.maxPerStageDescriptorUpdateAfterBindUniformBuffers;
+        x->maxPerStageDescriptorUpdateAfterBindStorageBuffers = p12.maxPerStageDescriptorUpdateAfterBindStorageBuffers;
+        x->maxPerStageDescriptorUpdateAfterBindSampledImages = p12.maxPerStageDescriptorUpdateAfterBindSampledImages;
+        x->maxPerStageDescriptorUpdateAfterBindStorageImages = p12.maxPerStageDescriptorUpdateAfterBindStorageImages;
+        x->maxPerStageDescriptorUpdateAfterBindInputAttachments = p12.maxPerStageDescriptorUpdateAfterBindInputAttachments;
+        x->maxPerStageUpdateAfterBindResources = p12.maxPerStageUpdateAfterBindResources;
+        x->maxDescriptorSetUpdateAfterBindSamplers = p12.maxDescriptorSetUpdateAfterBindSamplers;
+        x->maxDescriptorSetUpdateAfterBindUniformBuffers = p12.maxDescriptorSetUpdateAfterBindUniformBuffers;
+        x->maxDescriptorSetUpdateAfterBindUniformBuffersDynamic = p12.maxDescriptorSetUpdateAfterBindUniformBuffersDynamic;
+        x->maxDescriptorSetUpdateAfterBindStorageBuffers = p12.maxDescriptorSetUpdateAfterBindStorageBuffers;
+        x->maxDescriptorSetUpdateAfterBindStorageBuffersDynamic = p12.maxDescriptorSetUpdateAfterBindStorageBuffersDynamic;
+        x->maxDescriptorSetUpdateAfterBindSampledImages = p12.maxDescriptorSetUpdateAfterBindSampledImages;
+        x->maxDescriptorSetUpdateAfterBindStorageImages = p12.maxDescriptorSetUpdateAfterBindStorageImages;
+        x->maxDescriptorSetUpdateAfterBindInputAttachments = p12.maxDescriptorSetUpdateAfterBindInputAttachments;
+        break;
+      }
       case VK_STRUCTURE_TYPE_PHYSICAL_DEVICE_FLOAT_CONTROLS_PROPERTIES: {
         auto* x = reinterpret_cast<VkPhysicalDeviceFloatControlsProperties*>(s);
         x->denormBehaviorIndependence = p12.denormBehaviorIndependence;
diff --git a/gpu/vulkan/src/sync.cpp b/gpu/vulkan/src/sync.cpp
index d93c6d7..6f2c1af 100644
--- a/gpu/vulkan/src/sync.cpp
+++ b/gpu/vulkan/src/sync.cpp
@@ -565,6 +565,10 @@ extern "C" void vkGetImageSubresourceLayout(VkDevice, VkImage, const VkImageSubr
 VPVK_EXPORT VKAPI_ATTR void VKAPI_CALL vkGetImageSubresourceLayout2KHR(VkDevice dv, VkImage im, const VkImageSubresource2KHR* s,
                                                                        VkSubresourceLayout2KHR* out) {
   vkGetImageSubresourceLayout(dv, im, &s->imageSubresource, &out->subresourceLayout);
+  // VK_EXT_host_image_copy: VK_HOST_IMAGE_COPY_MEMCPY_EXT data is the tightly packed layout above.
+  for (auto* n = static_cast<VkBaseOutStructure*>(out->pNext); n; n = n->pNext)
+    if (n->sType == VK_STRUCTURE_TYPE_SUBRESOURCE_HOST_MEMCPY_SIZE_EXT)
+      reinterpret_cast<VkSubresourceHostMemcpySizeEXT*>(n)->size = out->subresourceLayout.size;
 }
 
 namespace vpvk {
-- 
