   std::vector<Access> out = d.bindings;
-  if (d.index) {
+  if (d.index && d.indirect) {
+    // The GPU picks the index range: the whole buffer is read.
+    out.push_back(read(ResourceRange::wholeBuffer(d.index->buffer), stage::vertex));
+  } else if (d.index) {
     const uint64_t stride = d.index->wide ? 4 : 2;
     out.push_back(read(ResourceRange::bytes(d.index->buffer, d.index->offset + uint64_t{d.first} * stride,
                                             uint64_t{d.count} * stride),
                        stage::vertex));
   }
-  if (d.indirect) out.push_back(read(ResourceRange::bytes(d.indirect->buffer, d.indirect->offset, d.index ? 20 : 16), stage::vertex));
+  if (d.indirect) {
+    const uint64_t one = d.index ? 20 : 16;
+    const uint64_t n = d.indirect->drawCount ? d.indirect->drawCount : 1;
+    const uint64_t span = (n - 1) * uint64_t{d.indirect->stride} + one;
+    out.push_back(read(ResourceRange::bytes(d.indirect->buffer, d.indirect->offset, span), stage::vertex));
+    if (d.indirect->countBuffer)
+      out.push_back(read(ResourceRange::bytes(d.indirect->countBuffer, d.indirect->countOffset, 4), stage::vertex));
+  }
   return out;
 }
 
