 namespace {
+// Indirect fix-up: one thread per Vulkan draw command of one indirect batch. Reads the arguments
+// (and the optional draw count) where the GPU wrote them, applies the count, the multiview instance
+// multiplication and the garbage limits, and writes Metal's indirect arguments (same field order as
+// Vulkan's: count, instances, first, [baseVertex,] baseInstance). Buffers are bound at a 256-byte
+// aligned offset and indexed in words from there (srcWord/countWord), so no binding is misaligned.
+constexpr const char* kIndirectFixMsl = R"(#include <metal_stdlib>
+using namespace metal;
+struct VpFix {
+    uint srcWord, strideWords, maxCount, indexed;
+    uint viewCount, hasCount, countWord, dstWord;
+    uint maxIndices, maxInstances, pad0, pad1;
+};
+kernel void vp_indirect_fix(device const uint* src [[buffer(0)]], device const uint* cnt [[buffer(1)]],
+                            device uint* dst [[buffer(2)]], device atomic_uint* diag [[buffer(3)]],
+                            constant VpFix& p [[buffer(4)]], uint i [[thread_position_in_grid]]) {
+    if (i >= p.maxCount) return;
+    const uint words = p.indexed ? 5u : 4u;
+    device uint* o = dst + p.dstWord + i * words;
+    uint n = p.maxCount;
+    if (p.hasCount) n = min(n, cnt[p.countWord]);
+    if (i >= n) {
+        for (uint k = 0; k < words; ++k) o[k] = 0u;
+        return;
+    }
+    device const uint* a = src + p.srcWord + i * p.strideWords;
+    uint count = a[0], inst = a[1];
+    if (count > p.maxIndices || inst > p.maxInstances) {
+        atomic_fetch_add_explicit(&diag[0], 1u, memory_order_relaxed);
+        atomic_fetch_max_explicit(&diag[1], count, memory_order_relaxed);
+        atomic_fetch_max_explicit(&diag[2], inst, memory_order_relaxed);
+        count = 0u, inst = 0u;
+    }
+    o[0] = count;
+    o[1] = inst * p.viewCount;
+    o[2] = a[2];
+    if (p.indexed) {
+        o[3] = a[3];
+        o[4] = a[4] * p.viewCount;
+    } else {
+        o[3] = a[3] * p.viewCount;
+    }
+}
+)";
+
 // Sampled blit: a triangle covering the viewport (the destination rect); `rect` maps the
 // viewport's unit square to source UVs (origin, size; a negative size mirrors).
 constexpr const char* kBlitMsl = R"(#include <metal_stdlib>
@@ -861,6 +931,26 @@ fragment float4 vp_blit_fs(VpBlitV in [[stage_in]], texture2d<float> src [[textu
 )";
 }  // namespace
 
+id<MTLComputePipelineState> MetalBackend::Impl::indirectFixPipeline(std::string& error) {
+  if (indirectFix || indirectFixFailed) {
+    if (!indirectFix) error = "failed_before";
+    return indirectFix;
+  }
+  MTLCompileOptions* o = [MTLCompileOptions new];
+  o.languageVersion = MTLLanguageVersion3_0;
+  NSError* e = nil;
+  id<MTLLibrary> lib = [device newLibraryWithSource:@(kIndirectFixMsl) options:o error:&e];
+  id<MTLFunction> f = lib ? [lib newFunctionWithName:@"vp_indirect_fix"] : nil;
+  indirectFix = f ? [device newComputePipelineStateWithFunction:f error:&e] : nil;
+  if (!indirectFix) {
+    indirectFixFailed = true;  // logged once by the caller; those draws are then skipped
+    error = str(e);
+  } else {
+    info("gpu.indirect fix_kernel=ready");
+  }
+  return indirectFix;
+}
