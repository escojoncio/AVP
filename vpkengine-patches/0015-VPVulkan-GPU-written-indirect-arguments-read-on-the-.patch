 struct Indirect {
   BufferId buffer;
   uint64_t offset = 0;
+  // Draws (gpu/metal2): `drawCount` commands `stride` bytes apart (Vulkan multiDrawIndirect),
+  // optionally capped by the 32-bit count at `countBuffer`+`countOffset` (vkCmdDraw*IndirectCount).
+  // `viewCount` > 1: multiview by instancing, so instanceCount and firstInstance are multiplied by
+  // it on the GPU before Metal reads them (gpu/metal2 runs a fix-up kernel into its own scratch).
+  uint32_t drawCount = 1, stride = 0, viewCount = 1;
+  BufferId countBuffer;  // null: drawCount draws
+  uint64_t countOffset = 0;
 };
 
 // Depth/stencil state set per draw (Vulkan dynamic state) instead of the pipeline's. Same
@@ -179,8 +186,8 @@ struct Draw {
