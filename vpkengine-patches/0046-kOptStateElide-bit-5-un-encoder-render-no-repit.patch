+// kOptStateElide: what the open render encoder already holds. Metal keeps an encoder's state until it ends, so a
+// set that repeats it can be skipped. One per render encoder and never carried to the next (a new encoder starts
+// blank). Pointers are compared by identity: the pipelines, depth-stencil states and the argument ring they point
+// at outlive the encoder.
+struct RenderState {
+  bool psoSet = false, dsSet = false, cullSet = false, refSet = false, windingSet = false, biasSet = false,
+       clipSet = false, vpSet = false, scSet = false, blendSet = false, dynSet = false;
+  const void* pso = nullptr;
+  const void* ds = nullptr;
+  MTLCullMode cull = MTLCullModeNone;
+  uint8_t stencilRef = 0;
+  MTLWinding winding = MTLWindingClockwise;
+  float bias[3] = {0, 0, 0};
+  MTLDepthClipMode clip = MTLDepthClipModeClip;
+  MTLViewport vps[kMaxPassViews] = {};
+  NSUInteger vpCount = 0;
+  MTLScissorRect scs[kMaxPassViews] = {};
+  NSUInteger scCount = 0;
+  float blend[4] = {0, 0, 0, 0};
+  // The last dynamic depth-stencil value and the state it mapped to (a pure function: the backend's cache never
+  // evicts), so a repeated value skips the hash and the lookup. Compared by bytes (as the cache hashes it; the
+  // struct is all one-byte members, and a byte difference only costs the lookup).
+  DepthStencilDynamic dyn;
+  id<MTLDepthStencilState> dynDs = nil;
+  // Buffer indices holding the argument ring (vertex / fragment): only their offset changes between draws.
+  uint32_t vArgs = 0, fArgs = 0;
+};
+
+// kOptStateElide, MetalBackend::Impl::submit's argument tables: where each declared argument was found in the
+// bindings of the last draw that used this stage table, valid while the bindings keep the same lookup keys.
+struct TableHint {
+  const void* table = nullptr;  // the Table (null: invalid)
+  uint8_t forStage = 0;
+  std::vector<uint64_t> sig;  // per binding: what the lookup reads
+  std::vector<int32_t> pos;   // per declared argument: index of the first matching binding
+};
+
