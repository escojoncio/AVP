@@ -2294,8 +2339,30 @@ void MetalBackend::Impl::submit(uint64_t frameIndex, const Frame& frame, const C
     }
     uint8_t* t = argBase + argUsed;
     std::memset(t, 0, bytes);
+    // The lookup below reads, per binding, only (pixelLocal, kind, slot, stages): when those match the last draw
+    // that used this table, each argument is at the same position as then (the first match is the same).
+    TableHint* hint = nullptr;
+    bool fast = false;
+    if (elideNow) {
+      hint = &tableHints[size_t(((reinterpret_cast<uintptr_t>(&stage) >> 4) * 11400714819323198485ull) >> 57)];
+      sigNow.clear();
+      for (const Access& x : bindings)
+        sigNow.push_back(uint64_t(x.slot) | uint64_t(bindKind(x)) << 16 | uint64_t(x.pixelLocal) << 24 | uint64_t(x.stages) << 32);
+      fast = hint->table == &stage && hint->forStage == forStage && hint->sig == sigNow;
+      if (fast) ++nTableFast;
+      else {
+        ++nTableSlow;
+        hint->table = nullptr;  // valid again only if every argument is found
+        posNow.assign(stage.args.size(), 0);
+      }
+    } else {
+      ++nTableSlow;
+    }
