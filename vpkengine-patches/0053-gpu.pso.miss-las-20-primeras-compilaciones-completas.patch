From 86a43a60d6db7cc0f79d125857deebeb61f1a1ba Mon Sep 17 00:00:00 2001
From: avp-bot <avp-bot@users.noreply.github.com>
Date: Mon, 26 Oct 2026 09:55:37 +0000
Subject: [PATCH] gpu.pso.miss: las 20 primeras compilaciones completas por
 sesion (label, key, ms)

---
 gpu/metal2/src/metal_backend.mm | 15 +++++++++++++++
 1 file changed, 15 insertions(+)

diff --git a/gpu/metal2/src/metal_backend.mm b/gpu/metal2/src/metal_backend.mm
index 27d50a8..33e0c5f 100644
--- a/gpu/metal2/src/metal_backend.mm
+++ b/gpu/metal2/src/metal_backend.mm
@@ -1743,11 +1743,19 @@ bool MetalBackend::Impl::buildRender(const PipelineState& s, Pipeline& p, std::s
     e = nil;
     d.binaryArchives = nil;  // the full compile below and the archived copy never reference them
   }
+  const auto missT0 = std::chrono::steady_clock::now();
   if (!p.render) p.render = [device newRenderPipelineStateWithDescriptor:d error:&e];
   if (!p.render) {
     error = "render pipeline: " + str(e);
     return false;
   }
+  // The first 20 pipelines of the session the binary archives did not have (a full compile): which ones, for the next prewarm.
+  static std::atomic<unsigned> renderMisses{0};
+  const unsigned renderMissesN = hit ? 20 : renderMisses.fetch_add(1);
+  if (renderMissesN < 20)
+    info("gpu.pso.miss n=" + std::to_string(renderMissesN + 1) + " kind=render label=" + token(s.label) + " key=" +
+         std::to_string(s.key().value) + " ms=" +
+         std::to_string(int(std::chrono::duration<double, std::milli>(std::chrono::steady_clock::now() - missT0).count())));
   if (archiveOn && !hit) queueArchive([d copy], false, s.label);
   MTLDepthStencilDescriptor* ds = [MTLDepthStencilDescriptor new];
   ds.depthCompareFunction = s.depthTest ? compareFn(s.depthCompare) : MTLCompareFunctionAlways;
@@ -1782,12 +1790,19 @@ bool MetalBackend::Impl::buildCompute(const PipelineState& s, Pipeline& p, std::
     e = nil;
     d.binaryArchives = nil;
   }
+  const auto missT0 = std::chrono::steady_clock::now();
   if (!p.compute)
     p.compute = [device newComputePipelineStateWithDescriptor:d options:MTLPipelineOptionNone reflection:nil error:&e];
   if (!p.compute) {
     error = "compute pipeline: " + str(e);
     return false;
   }
+  static std::atomic<unsigned> computeMisses{0};  // same as buildRender: the first 20 full compiles of the session
+  const unsigned computeMissesN = hit ? 20 : computeMisses.fetch_add(1);
+  if (computeMissesN < 20)
+    info("gpu.pso.miss n=" + std::to_string(computeMissesN + 1) + " kind=compute label=" + token(s.label) + " key=" +
+         std::to_string(s.key().value) + " ms=" +
+         std::to_string(int(std::chrono::duration<double, std::milli>(std::chrono::steady_clock::now() - missT0).count())));
   if (archiveOn && !hit) queueArchive([d copy], true, s.label);
   p.threads = MTLSizeMake(cs.threadsPerGroup[0], cs.threadsPerGroup[1], cs.threadsPerGroup[2]);
   p.stage[0] = {cs.arguments, cs.argumentBufferIndex};
-- 
