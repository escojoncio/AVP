diff --git a/gpu/shader/spirv/tests/spirv_tests.cpp b/gpu/shader/spirv/tests/spirv_tests.cpp
index 971976e..8c6315f 100644
--- a/gpu/shader/spirv/tests/spirv_tests.cpp
+++ b/gpu/shader/spirv/tests/spirv_tests.cpp
@@ -72,8 +72,11 @@ Result run(const std::string& path, const spirv::SpirvLowerOptions& o, bool fetc
         return r;
     }
     if (fetch) {
-        // The driver's step for input attachments: texture slot -> colour attachment.
-        std::map<uint32_t, uint32_t> att{{0, 0}, {1, 1}};
+        // The driver's step for input attachments: texture slot -> colour attachment, only where the
+        // render pass makes the input attachment the SAME view as that colour attachment. In subpass.frag
+        // input 0 (gAlbedo) is colour 0; input 1 (gNormal) is another image (location 1 is a uvec4 `ids`
+        // target), so it stays a texture read.
+        std::map<uint32_t, uint32_t> att{{0, 0}};
         auto rej = vpir::toFramebufferFetch(r.module, att, {});
         for (auto& x : rej) std::fprintf(stderr, "  fbfetch rejected: %s\n", x.reason.c_str());
         CHECK(rej.empty());
