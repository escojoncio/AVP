+// Fences and timeline semaphores complete with their own frame, not a device-wide idle: the null
+// backend holds frames unfinished until the test moves completedBelow.
+void testSync() {
+  Ctx c;
+  auto& nb = dynamic_cast<vpgpu::NullBackend&>(from<Device>(c.dev)->platform->backend());
+  VkDeviceMemory m = alloc(c, 1 << 20, 1);
+  VkBuffer a = buffer(c, 4096, m, 0), b = buffer(c, 4096, m, 65536);
+  VkCommandPoolCreateInfo pi{VK_STRUCTURE_TYPE_COMMAND_POOL_CREATE_INFO};
+  VkCommandPool pool;
+  vkCreateCommandPool(c.dev, &pi, nullptr, &pool);
+  VkCommandBufferAllocateInfo ai{VK_STRUCTURE_TYPE_COMMAND_BUFFER_ALLOCATE_INFO};
+  ai.commandPool = pool, ai.commandBufferCount = 1;
+  VkCommandBuffer cb;
+  vkAllocateCommandBuffers(c.dev, &ai, &cb);
+  VkCommandBufferBeginInfo bi{VK_STRUCTURE_TYPE_COMMAND_BUFFER_BEGIN_INFO};
+  vkBeginCommandBuffer(cb, &bi);
+  VkBufferCopy bc{0, 0, 256};
+  vkCmdCopyBuffer(cb, a, b, 1, &bc);
+  VkDependencyInfo dep{VK_STRUCTURE_TYPE_DEPENDENCY_INFO};
+  vkCmdPipelineBarrier2(cb, &dep);
+  vkEndCommandBuffer(cb);
+
+  VkSemaphoreTypeCreateInfo tci{VK_STRUCTURE_TYPE_SEMAPHORE_TYPE_CREATE_INFO};
+  tci.semaphoreType = VK_SEMAPHORE_TYPE_TIMELINE, tci.initialValue = 5;
+  VkSemaphoreCreateInfo sci{VK_STRUCTURE_TYPE_SEMAPHORE_CREATE_INFO, &tci};
+  VkSemaphore tl;
+  vkCreateSemaphore(c.dev, &sci, nullptr, &tl);
+  uint64_t v = 0;
+  vkGetSemaphoreCounterValue(c.dev, tl, &v);
+  CHECK(v == 5);
+  VkFenceCreateInfo fci{VK_STRUCTURE_TYPE_FENCE_CREATE_INFO};
+  VkFence f1, f2;
+  vkCreateFence(c.dev, &fci, nullptr, &f1);
+  vkCreateFence(c.dev, &fci, nullptr, &f2);
+
+  nb.completedBelow = 0;  // nothing finishes from now on
+  // Submit 1 (vkQueueSubmit2): signals timeline 10 and fence f1.
+  VkCommandBufferSubmitInfo cbi{VK_STRUCTURE_TYPE_COMMAND_BUFFER_SUBMIT_INFO};
+  cbi.commandBuffer = cb;
+  VkSemaphoreSubmitInfo sig{VK_STRUCTURE_TYPE_SEMAPHORE_SUBMIT_INFO};
+  sig.semaphore = tl, sig.value = 10;
+  VkSubmitInfo2 s2{VK_STRUCTURE_TYPE_SUBMIT_INFO_2};
+  s2.commandBufferInfoCount = 1, s2.pCommandBufferInfos = &cbi, s2.signalSemaphoreInfoCount = 1, s2.pSignalSemaphoreInfos = &sig;
+  CHECK(vkQueueSubmit2(c.queue, 1, &s2, f1) == VK_SUCCESS);
+  const uint64_t frame1 = from<Fence>(f1)->frame;
+  // Submit 2 (vkQueueSubmit + timeline values): waits 10 (promised by submit 1: no block), signals 20.
+  uint64_t wv = 10, sv = 20;
+  VkTimelineSemaphoreSubmitInfo tsi{VK_STRUCTURE_TYPE_TIMELINE_SEMAPHORE_SUBMIT_INFO};
+  tsi.waitSemaphoreValueCount = 1, tsi.pWaitSemaphoreValues = &wv, tsi.signalSemaphoreValueCount = 1, tsi.pSignalSemaphoreValues = &sv;
+  VkPipelineStageFlags ws = VK_PIPELINE_STAGE_ALL_COMMANDS_BIT;
+  VkSubmitInfo si{VK_STRUCTURE_TYPE_SUBMIT_INFO, &tsi};
+  si.waitSemaphoreCount = 1, si.pWaitSemaphores = &tl, si.pWaitDstStageMask = &ws;
+  si.signalSemaphoreCount = 1, si.pSignalSemaphores = &tl;
+  si.commandBufferCount = 1, si.pCommandBuffers = &cb;
+  CHECK(vkQueueSubmit(c.queue, 1, &si, f2) == VK_SUCCESS);
+  const uint64_t frame2 = from<Fence>(f2)->frame;
+  CHECK(frame1 != kNoFrame && frame2 == frame1 + 1);
+
+  CHECK(vkGetFenceStatus(c.dev, f1) == VK_NOT_READY);
+  CHECK(vkWaitForFences(c.dev, 1, &f1, VK_TRUE, 1000000) == VK_TIMEOUT);  // 1 ms, honoured
+  vkGetSemaphoreCounterValue(c.dev, tl, &v);
+  CHECK(v == 5);
+  nb.completedBelow = frame1 + 1;  // the first frame finished; the second has not
+  CHECK(vkGetFenceStatus(c.dev, f1) == VK_SUCCESS);
+  CHECK(vkGetFenceStatus(c.dev, f2) == VK_NOT_READY);
+  VkFence both[2] = {f1, f2};
+  CHECK(vkWaitForFences(c.dev, 2, both, VK_FALSE, 0) == VK_SUCCESS);  // any
+  CHECK(vkWaitForFences(c.dev, 2, both, VK_TRUE, 0) == VK_TIMEOUT);   // all
+  vkGetSemaphoreCounterValue(c.dev, tl, &v);
+  CHECK(v == 10);
+  VkSemaphoreWaitInfo wi{VK_STRUCTURE_TYPE_SEMAPHORE_WAIT_INFO};
+  wi.semaphoreCount = 1, wi.pSemaphores = &tl, wi.pValues = &sv;
+  CHECK(vkWaitSemaphores(c.dev, &wi, 0) == VK_TIMEOUT);
+  nb.completedBelow = frame2 + 1;
+  CHECK(vkWaitSemaphores(c.dev, &wi, UINT64_MAX) == VK_SUCCESS);
+  CHECK(vkWaitForFences(c.dev, 2, both, VK_TRUE, UINT64_MAX) == VK_SUCCESS);
+  // Host signal releases a wait nobody promised.
+  uint64_t far = 30;
+  wi.pValues = &far;
+  std::thread t([&] {
+    std::this_thread::sleep_for(std::chrono::milliseconds(5));
+    VkSemaphoreSignalInfo hs{VK_STRUCTURE_TYPE_SEMAPHORE_SIGNAL_INFO};
+    hs.semaphore = tl, hs.value = 30;
+    vkSignalSemaphore(c.dev, &hs);
+  });
+  CHECK(vkWaitSemaphores(c.dev, &wi, 2000000000ull) == VK_SUCCESS);
+  t.join();
+  vkResetFences(c.dev, 1, &f1);
+  CHECK(vkGetFenceStatus(c.dev, f1) == VK_NOT_READY);
+  CHECK(vkQueueWaitIdle(c.queue) == VK_SUCCESS && vkDeviceWaitIdle(c.dev) == VK_SUCCESS);
+  // Binary semaphores: a signal then a wait between submissions needs nothing from the host.
+  VkSemaphore bin;
+  VkSemaphoreCreateInfo bci{VK_STRUCTURE_TYPE_SEMAPHORE_CREATE_INFO};
+  vkCreateSemaphore(c.dev, &bci, nullptr, &bin);
