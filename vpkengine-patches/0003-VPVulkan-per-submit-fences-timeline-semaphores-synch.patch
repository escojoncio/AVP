diff --git a/gpu/vulkan/src/sync.cpp b/gpu/vulkan/src/sync.cpp
new file mode 100644
index 0000000..87d7a8f
--- /dev/null
+++ b/gpu/vulkan/src/sync.cpp
@@ -0,0 +1,403 @@
+// VPVulkan synchronisation: fences, binary and timeline semaphores (VK_KHR_timeline_semaphore),
+// vkQueueSubmit / vkQueueSubmit2 (VK_KHR_synchronization2) and the sync2 command forms, idle waits.
+//
+// One queue whose submissions execute in order. Each vkQueueSubmit becomes one core frame; fences and
+// semaphore signals attached to it complete when the backend reports that frame finished
+// (vpgpu::Device::completedFrames: gpu/metal2's command buffer completion handlers), so a wait
+// covers exactly the work it names and never idles the whole device. Semaphore waits between
+// submissions of this queue are satisfied by submission order and need no GPU work; a wait on a
+// timeline value no submission has signalled yet blocks the submitting thread until the host
+// signals it (vkSignalSemaphore), as the spec allows for wait-before-signal.
+#include <algorithm>
+#include <chrono>
+#include <cstring>
+#include <thread>
+
+#include "commands.h"
+#include "vpvk.h"
+
+#define VPVK_EXPORT extern "C" __attribute__((visibility("default")))
+
+namespace vpvk {
+
+bool Device::frameDone(uint64_t frame) { return frame == kNoFrame || gpu->completedFrames() > frame; }
+
+// The backend reports completion by polling (gpu/metal2 completion handlers set it): a short spin,
+// then sleeps growing to 1 ms. Fine for frame-rate waits; nothing here holds a lock while waiting.
+bool Device::waitFrame(uint64_t frame, uint64_t timeoutNs) {
+  if (frameDone(frame)) return true;
+  if (!timeoutNs) return false;
+  const auto start = std::chrono::steady_clock::now();
+  auto sleep = std::chrono::microseconds(20);
+  while (!frameDone(frame)) {
+    if (timeoutNs != UINT64_MAX &&
+        uint64_t(std::chrono::duration_cast<std::chrono::nanoseconds>(std::chrono::steady_clock::now() - start).count()) >=
+            timeoutNs)
+      return false;
+    std::this_thread::sleep_for(sleep);
+    sleep = std::min(sleep * 2, std::chrono::microseconds(1000));
+  }
+  return true;
+}
+
+namespace {
+
+// Applies the signals of `s` whose frames completed. Caller holds s.m.
+void settle(Device& d, Semaphore& s) {
+  bool changed = false;
+  auto it = s.pending.begin();
+  while (it != s.pending.end()) {
+    if (!d.frameDone(it->second)) {
+      ++it;
+      continue;
+    }
+    s.value = s.timeline ? std::max(s.value, it->first) : 1;
+    it = s.pending.erase(it);
+    changed = true;
+  }
+  if (changed) s.cv.notify_all();
+}
+
+uint64_t semaphoreValue(Device& d, Semaphore& s) {
+  std::lock_guard<std::mutex> lock(s.m);
+  settle(d, s);
+  return s.value;
+}
+
+// Highest value `s` will reach once everything submitted so far completes. Caller holds s.m.
+uint64_t promised(const Semaphore& s) {
+  uint64_t v = s.value;
+  for (const auto& [value, frame] : s.pending) v = std::max(v, s.timeline ? value : 1);
+  return v;
+}
+
+// Waits until `s` reaches `value` (timeline) or is signaled (binary, value 1). A value already
+// promised by a submitted frame waits for that frame; one nobody promised yet waits for a host
+// signal. Returns false on timeout.
+bool waitSemaphore(Device& d, Semaphore& s, uint64_t value, uint64_t timeoutNs) {
+  const auto deadline = timeoutNs == UINT64_MAX ? std::chrono::steady_clock::time_point::max()
+                                                : std::chrono::steady_clock::now() + std::chrono::nanoseconds(timeoutNs);
+  std::unique_lock<std::mutex> lock(s.m);
+  for (;;) {
+    settle(d, s);
+    if (s.value >= value) return true;
+    // The earliest pending frame that gets it there.
+    uint64_t frame = kNoFrame;
+    for (const auto& [v, f] : s.pending)
+      if ((s.timeline ? v : 1) >= value) frame = std::min(frame, f);
+    const auto now = std::chrono::steady_clock::now();
+    if (now >= deadline) return false;
+    if (frame != kNoFrame) {
+      lock.unlock();
+      const uint64_t left = deadline == std::chrono::steady_clock::time_point::max()
+                                ? UINT64_MAX
+                                : uint64_t(std::chrono::duration_cast<std::chrono::nanoseconds>(deadline - now).count());
+      const bool ok = d.waitFrame(frame, left);
+      lock.lock();
+      if (!ok) return false;
+      continue;
+    }
+    // Not promised by any submission: a host signal (vkSignalSemaphore) or a later submit.
+    if (deadline == std::chrono::steady_clock::time_point::max()) s.cv.wait_for(lock, std::chrono::milliseconds(2));
+    else s.cv.wait_until(lock, std::min(deadline, now + std::chrono::milliseconds(2)));
+  }
+}
+
+struct SemOp {
+  Semaphore* sem = nullptr;
+  uint64_t value = 0;
+};
+
+// One submission batch, independent of the VkSubmitInfo version.
+struct Batch {
+  std::vector<SemOp> waits, signals;
+  std::vector<const CommandBuffer*> cbs;
+};
+
+// Submits batches in order. Timeline waits on values no earlier work promises block here until the
+// host signals them. Binary waits never block: on this in-order queue a binary semaphore is
+// signalled by an earlier submission or by the host layer's own swapchain acquire (Klepton
+// synthesizes vkAcquireNextImageKHR and never signals this driver's semaphores).
+VkResult submit(Device& d, std::vector<Batch>& batches, Fence* fence) {
+  for (Batch& b : batches)
+    for (const SemOp& w : b.waits) {
+      if (!w.sem->timeline) continue;
+      bool promisedNow;
+      {
+        std::lock_guard<std::mutex> lock(w.sem->m);
+        settle(d, *w.sem);
+        promisedNow = promised(*w.sem) >= w.value;
+      }
+      // Promised by an earlier submission of this queue: ordered by submission already.
+      if (!promisedNow && !waitSemaphore(d, *w.sem, w.value, UINT64_MAX)) return VK_TIMEOUT;
+    }
+  std::lock_guard<std::mutex> lock(d.submitMutex);
+  vpgpu::Frame frame;
+  TranslateStats st;
+  uint32_t barriers = 0, cbs = 0;
+  for (Batch& b : batches)
+    for (const CommandBuffer* c : b.cbs) {
+      translate(*c->rec, frame, st, &d);
+      barriers += c->rec->barriers;
+      ++cbs;
+    }
+  if (!frame.commands().empty()) d.lastFrame = d.gpu->submit(frame).frame;
+  ++d.submits;
+  if (st.dropped || st.skippedDraws || st.skippedDispatches || d.submits <= 3 || d.submits % 600 == 0)
+    logf("vk.submit n=%llu cbs=%u passes=%u draws=%u dispatches=%u copies=%u clears=%u vk_barriers=%u "
+         "draws_skipped=%u dispatch_skipped=%u dropped=%u local_reads=%u",
+         static_cast<unsigned long long>(d.submits), cbs, st.passes, st.draws, st.dispatches, st.copies, st.clears,
+         barriers, st.skippedDraws, st.skippedDispatches, st.dropped, st.localReads);
+  // Everything submitted so far completes with the last frame (in-order queue).
+  const uint64_t doneWith = d.lastFrame;
+  for (Batch& b : batches)
+    for (const SemOp& s : b.signals) {
+      std::lock_guard<std::mutex> sl(s.sem->m);
+      if (s.sem->timeline && s.value <= promised(*s.sem)) continue;  // must increase: ignore a stale one
+      if (!s.sem->timeline) s.sem->value = 0;
+      s.sem->pending.push_back({s.sem->timeline ? s.value : 1, doneWith});
+      settle(d, *s.sem);
+      s.sem->cv.notify_all();
+    }
+  for (Batch& b : batches)
+    for (const SemOp& w : b.waits)
+      if (!w.sem->timeline) {  // a binary wait consumes the signal
+        std::lock_guard<std::mutex> sl(w.sem->m);
+        settle(d, *w.sem);
+        w.sem->value = 0;
+        w.sem->pending.clear();
+      }
+  if (fence) {
+    fence->frame = doneWith;
+    fence->signaled = true;
+  }
+  return VK_SUCCESS;
+}
+
+}  // namespace
+}  // namespace vpvk
+
+using namespace vpvk;
+
+// ---------------------------------------------------------------------------------------------
+// Fences
+// ---------------------------------------------------------------------------------------------
+VPVK_EXPORT VKAPI_ATTR VkResult VKAPI_CALL vkCreateFence(VkDevice, const VkFenceCreateInfo* ci,
+                                                         const VkAllocationCallbacks*, VkFence* out) {
+  auto* f = new Fence;
+  f->signaled = (ci->flags & VK_FENCE_CREATE_SIGNALED_BIT) != 0;
+  *out = to<VkFence>(f);
+  return VK_SUCCESS;
+}
+
+VPVK_EXPORT VKAPI_ATTR void VKAPI_CALL vkDestroyFence(VkDevice, VkFence f, const VkAllocationCallbacks*) {
+  delete from<Fence>(f);
+}
+
+VPVK_EXPORT VKAPI_ATTR VkResult VKAPI_CALL vkResetFences(VkDevice, uint32_t n, const VkFence* fs) {
+  for (uint32_t i = 0; i < n; ++i) {
+    from<Fence>(fs[i])->signaled = false;
+    from<Fence>(fs[i])->frame = kNoFrame;
+  }
+  return VK_SUCCESS;
+}
+
+// Signaled by a submission: done when its frame completed (the client then reuses the command
+// buffers, upload memory and descriptors of that submission).
+VPVK_EXPORT VKAPI_ATTR VkResult VKAPI_CALL vkGetFenceStatus(VkDevice dv, VkFence f) {
+  Fence* fe = from<Fence>(f);
+  if (!fe->signaled) return VK_NOT_READY;
+  return from<Device>(dv)->frameDone(fe->frame) ? VK_SUCCESS : VK_NOT_READY;
+}
+
+VPVK_EXPORT VKAPI_ATTR VkResult VKAPI_CALL vkWaitForFences(VkDevice dv, uint32_t n, const VkFence* fs, VkBool32 all,
+                                                           uint64_t timeout) {
+  Device* d = from<Device>(dv);
+  const auto start = std::chrono::steady_clock::now();
+  auto left = [&]() -> uint64_t {
+    if (timeout == UINT64_MAX) return UINT64_MAX;
+    const uint64_t spent =
+        uint64_t(std::chrono::duration_cast<std::chrono::nanoseconds>(std::chrono::steady_clock::now() - start).count());
+    return spent >= timeout ? 0 : timeout - spent;
+  };
+  if (all || n == 1) {
+    for (uint32_t i = 0; i < n; ++i) {
+      Fence* f = from<Fence>(fs[i]);
+      if (!f->signaled) return VK_TIMEOUT;  // never submitted: no host signal exists for fences here
+      if (!d->waitFrame(f->frame, left())) return VK_TIMEOUT;
+    }
+    return VK_SUCCESS;
+  }
+  // Any: the earliest frame among the submitted ones completes first (in-order queue).
+  uint64_t earliest = kNoFrame;
+  for (uint32_t i = 0; i < n; ++i) {
+    Fence* f = from<Fence>(fs[i]);
+    if (f->signaled) earliest = std::min(earliest, f->frame.load());
+    if (f->signaled && f->frame == kNoFrame) return VK_SUCCESS;
+  }
+  if (earliest == kNoFrame) return VK_TIMEOUT;
+  return d->waitFrame(earliest, left()) ? VK_SUCCESS : VK_TIMEOUT;
+}
+
+// ---------------------------------------------------------------------------------------------
+// Semaphores
+// ---------------------------------------------------------------------------------------------
+VPVK_EXPORT VKAPI_ATTR VkResult VKAPI_CALL vkCreateSemaphore(VkDevice, const VkSemaphoreCreateInfo* ci,
+                                                             const VkAllocationCallbacks*, VkSemaphore* out) {
+  auto* s = new Semaphore;
+  for (auto* x = static_cast<const VkBaseInStructure*>(ci ? ci->pNext : nullptr); x; x = x->pNext)
+    if (x->sType == VK_STRUCTURE_TYPE_SEMAPHORE_TYPE_CREATE_INFO) {
+      const auto* t = reinterpret_cast<const VkSemaphoreTypeCreateInfo*>(x);
+      s->timeline = t->semaphoreType == VK_SEMAPHORE_TYPE_TIMELINE;
+      s->value = s->timeline ? t->initialValue : 0;
+    }
+  *out = to<VkSemaphore>(s);
+  return VK_SUCCESS;
+}
+
+VPVK_EXPORT VKAPI_ATTR void VKAPI_CALL vkDestroySemaphore(VkDevice, VkSemaphore s, const VkAllocationCallbacks*) {
+  delete from<Semaphore>(s);
+}
+
+VPVK_EXPORT VKAPI_ATTR VkResult VKAPI_CALL vkGetSemaphoreCounterValue(VkDevice dv, VkSemaphore s, uint64_t* value) {
+  *value = semaphoreValue(*from<Device>(dv), *from<Semaphore>(s));
+  return VK_SUCCESS;
+}
+
+VPVK_EXPORT VKAPI_ATTR VkResult VKAPI_CALL vkWaitSemaphores(VkDevice dv, const VkSemaphoreWaitInfo* wi, uint64_t timeout) {
+  Device* d = from<Device>(dv);
+  const bool any = wi->flags & VK_SEMAPHORE_WAIT_ANY_BIT;
+  const auto start = std::chrono::steady_clock::now();
+  auto left = [&]() -> uint64_t {
+    if (timeout == UINT64_MAX) return UINT64_MAX;
+    const uint64_t spent =
+        uint64_t(std::chrono::duration_cast<std::chrono::nanoseconds>(std::chrono::steady_clock::now() - start).count());
+    return spent >= timeout ? 0 : timeout - spent;
+  };
+  if (!any) {
+    for (uint32_t i = 0; i < wi->semaphoreCount; ++i)
+      if (!waitSemaphore(*d, *from<Semaphore>(wi->pSemaphores[i]), wi->pValues[i], left())) return VK_TIMEOUT;
+    return VK_SUCCESS;
+  }
+  for (;;) {
+    for (uint32_t i = 0; i < wi->semaphoreCount; ++i)
+      if (semaphoreValue(*d, *from<Semaphore>(wi->pSemaphores[i])) >= wi->pValues[i]) return VK_SUCCESS;
+    if (!left()) return VK_TIMEOUT;
+    std::this_thread::sleep_for(std::chrono::microseconds(200));
+  }
+}
+
+VPVK_EXPORT VKAPI_ATTR VkResult VKAPI_CALL vkSignalSemaphore(VkDevice dv, const VkSemaphoreSignalInfo* si) {
+  Semaphore* s = from<Semaphore>(si->semaphore);
+  std::lock_guard<std::mutex> lock(s->m);
+  settle(*from<Device>(dv), *s);
+  s->value = std::max(s->value, si->value);
+  s->cv.notify_all();
+  return VK_SUCCESS;
+}
+
+// ---------------------------------------------------------------------------------------------
+// Submission
+// ---------------------------------------------------------------------------------------------
+VPVK_EXPORT VKAPI_ATTR VkResult VKAPI_CALL vkQueueSubmit(VkQueue q, uint32_t n, const VkSubmitInfo* si, VkFence fence) {
+  std::vector<Batch> batches(n);
+  for (uint32_t i = 0; i < n; ++i) {
+    const VkTimelineSemaphoreSubmitInfo* tv = nullptr;
+    for (auto* x = static_cast<const VkBaseInStructure*>(si[i].pNext); x; x = x->pNext)
+      if (x->sType == VK_STRUCTURE_TYPE_TIMELINE_SEMAPHORE_SUBMIT_INFO)
+        tv = reinterpret_cast<const VkTimelineSemaphoreSubmitInfo*>(x);
+    for (uint32_t k = 0; k < si[i].waitSemaphoreCount; ++k)
+      batches[i].waits.push_back({from<Semaphore>(si[i].pWaitSemaphores[k]),
+                                  tv && k < tv->waitSemaphoreValueCount && tv->pWaitSemaphoreValues ? tv->pWaitSemaphoreValues[k] : 1});
+    for (uint32_t k = 0; k < si[i].signalSemaphoreCount; ++k)
+      batches[i].signals.push_back({from<Semaphore>(si[i].pSignalSemaphores[k]),
+                                    tv && k < tv->signalSemaphoreValueCount && tv->pSignalSemaphoreValues ? tv->pSignalSemaphoreValues[k] : 1});
+    for (uint32_t k = 0; k < si[i].commandBufferCount; ++k)
+      batches[i].cbs.push_back(from<CommandBuffer>(si[i].pCommandBuffers[k]));
+  }
+  return submit(*from<Queue>(q)->device, batches, fence ? from<Fence>(fence) : nullptr);
+}
+
+VPVK_EXPORT VKAPI_ATTR VkResult VKAPI_CALL vkQueueSubmit2(VkQueue q, uint32_t n, const VkSubmitInfo2* si, VkFence fence) {
+  std::vector<Batch> batches(n);
+  for (uint32_t i = 0; i < n; ++i) {
+    for (uint32_t k = 0; k < si[i].waitSemaphoreInfoCount; ++k)
+      batches[i].waits.push_back({from<Semaphore>(si[i].pWaitSemaphoreInfos[k].semaphore), si[i].pWaitSemaphoreInfos[k].value});
+    for (uint32_t k = 0; k < si[i].signalSemaphoreInfoCount; ++k)
+      batches[i].signals.push_back({from<Semaphore>(si[i].pSignalSemaphoreInfos[k].semaphore), si[i].pSignalSemaphoreInfos[k].value});
+    for (uint32_t k = 0; k < si[i].commandBufferInfoCount; ++k)
+      batches[i].cbs.push_back(from<CommandBuffer>(si[i].pCommandBufferInfos[k].commandBuffer));
+  }
+  return submit(*from<Queue>(q)->device, batches, fence ? from<Fence>(fence) : nullptr);
+}
+
+// Idle: the last submitted frame completed (in-order queue: everything before it too).
+VPVK_EXPORT VKAPI_ATTR VkResult VKAPI_CALL vkQueueWaitIdle(VkQueue q) {
+  Device* d = from<Queue>(q)->device;
+  uint64_t last;
+  {
+    std::lock_guard<std::mutex> lock(d->submitMutex);
+    last = d->lastFrame;
+  }
+  d->waitFrame(last, UINT64_MAX);
+  return VK_SUCCESS;
+}
+
+VPVK_EXPORT VKAPI_ATTR VkResult VKAPI_CALL vkDeviceWaitIdle(VkDevice dv) {
+  return vkQueueWaitIdle(to<VkQueue>(&from<Device>(dv)->queue));
+}
+
+// ---------------------------------------------------------------------------------------------
+// Synchronization2 command forms. Barriers are hazards the core already derives; only an in-pass
+// barrier matters (local read). Events stay host-visible flags (in-order queue).
+// ---------------------------------------------------------------------------------------------
+VPVK_EXPORT VKAPI_ATTR void VKAPI_CALL vkCmdPipelineBarrier2(VkCommandBuffer cb, const VkDependencyInfo*) {
+  Recorder& r = *from<CommandBuffer>(cb)->rec;
+  ++r.barriers;
+  recordInPassBarrier(r);
+}
+VPVK_EXPORT VKAPI_ATTR void VKAPI_CALL vkCmdSetEvent2(VkCommandBuffer, VkEvent e, const VkDependencyInfo*) {
+  from<Event>(e)->set = true;
+}
+VPVK_EXPORT VKAPI_ATTR void VKAPI_CALL vkCmdResetEvent2(VkCommandBuffer, VkEvent e, VkPipelineStageFlags2) {
+  from<Event>(e)->set = false;
+}
+VPVK_EXPORT VKAPI_ATTR void VKAPI_CALL vkCmdWaitEvents2(VkCommandBuffer cb, uint32_t, const VkEvent*, const VkDependencyInfo*) {
+  ++from<CommandBuffer>(cb)->rec->barriers;
+}
+extern "C" void vkCmdWriteTimestamp(VkCommandBuffer, VkPipelineStageFlagBits, VkQueryPool, uint32_t);
+VPVK_EXPORT VKAPI_ATTR void VKAPI_CALL vkCmdWriteTimestamp2(VkCommandBuffer cb, VkPipelineStageFlags2 stage, VkQueryPool p,
+                                                            uint32_t q) {
+  vkCmdWriteTimestamp(cb, stage == VK_PIPELINE_STAGE_2_TOP_OF_PIPE_BIT ? VK_PIPELINE_STAGE_TOP_OF_PIPE_BIT
+                                                                       : VK_PIPELINE_STAGE_BOTTOM_OF_PIPE_BIT,
+                      p, q);
+}
+
+namespace vpvk {
+PFN_vkVoidFunction lookupSync(const char* name) {
+  struct E {
+    const char* name;
+    PFN_vkVoidFunction fn;
+  };
+#define F(f) {#f, reinterpret_cast<PFN_vkVoidFunction>(&f)}
+  static const E table[] = {
+      F(vkCreateFence), F(vkDestroyFence), F(vkResetFences), F(vkGetFenceStatus), F(vkWaitForFences),
+      F(vkCreateSemaphore), F(vkDestroySemaphore), F(vkGetSemaphoreCounterValue), F(vkWaitSemaphores),
+      F(vkSignalSemaphore), F(vkQueueSubmit), F(vkQueueSubmit2), F(vkQueueWaitIdle), F(vkDeviceWaitIdle),
+      F(vkCmdPipelineBarrier2), F(vkCmdSetEvent2), F(vkCmdResetEvent2), F(vkCmdWaitEvents2), F(vkCmdWriteTimestamp2),
+  };
+#undef F
+  static const std::pair<const char*, const char*> aliases[] = {
+      {"vkGetSemaphoreCounterValueKHR", "vkGetSemaphoreCounterValue"}, {"vkWaitSemaphoresKHR", "vkWaitSemaphores"},
+      {"vkSignalSemaphoreKHR", "vkSignalSemaphore"}, {"vkQueueSubmit2KHR", "vkQueueSubmit2"},
+      {"vkCmdPipelineBarrier2KHR", "vkCmdPipelineBarrier2"}, {"vkCmdSetEvent2KHR", "vkCmdSetEvent2"},
+      {"vkCmdResetEvent2KHR", "vkCmdResetEvent2"}, {"vkCmdWaitEvents2KHR", "vkCmdWaitEvents2"},
+      {"vkCmdWriteTimestamp2KHR", "vkCmdWriteTimestamp2"},
+  };
+  for (const auto& [alias, real] : aliases)
+    if (!std::strcmp(name, alias)) name = real;
+  for (const E& e : table)
+    if (!std::strcmp(e.name, name)) return e.fn;
+  return nullptr;
+}
+}  // namespace vpvk
