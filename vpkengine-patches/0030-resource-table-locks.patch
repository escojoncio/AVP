 // Pipeline binary archives
diff --git a/gpu/vulkan/src/motion.cpp b/gpu/vulkan/src/motion.cpp
index 166ab24..860926c 100644
--- a/gpu/vulkan/src/motion.cpp
+++ b/gpu/vulkan/src/motion.cpp
@@ -190,8 +190,10 @@ void motionDeviceDestroyed(Device& d) {
 // A pass about to open: if it is an eye pass the motion target joins it. Returns the slot used, -1 none.
 int motionPassBegin(Device* d, vpgpu::RenderPassDesc& desc, uint64_t lastSubmitted) {
   if (!d || !d->motion || desc.layerCount < 2 || !desc.depth.texture) return -1;
-  const vpgpu::TextureDesc* td = d->gpu->resources().get(desc.depth.texture);
-  if (!td || td->samples != 1) return -1;
+  vpgpu::TextureDesc depthDesc;  // a copy: the table may grow under a pointer into it
+  if (!d->gpu->textureDesc(desc.depth.texture, depthDesc)) return -1;
+  const vpgpu::TextureDesc* td = &depthDesc;
+  if (td->samples != 1) return -1;
   int slot = -1;
   for (int c = 0; c < vpgpu::kMaxColorAttachments; ++c)
     if (!desc.colors[c].texture) {
