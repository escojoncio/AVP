From 23311309e31c3f259879dc2624510b5cd457c37e Mon Sep 17 00:00:00 2001
From: avp-bot <avp-bot@users.noreply.github.com>
Date: Mon, 26 Oct 2026 00:51:58 +0000
Subject: [PATCH] gpu.time: t=<ms> desde arranque

---
 gpu/core/src/device.cpp       | 7 +++++++
 gpu/core/tests/core_tests.cpp | 2 +-
 2 files changed, 8 insertions(+), 1 deletion(-)

diff --git a/gpu/core/src/device.cpp b/gpu/core/src/device.cpp
index 9075d3a..2d38fda 100644
--- a/gpu/core/src/device.cpp
+++ b/gpu/core/src/device.cpp
@@ -9,6 +9,10 @@
 
 namespace vpgpu {
 
+namespace {
+const auto kProcessStart = std::chrono::steady_clock::now();  // gpu.time t= counts from here
+}
+
 Device::Device(Backend& backend, unsigned pipelineWorkers, LogSink log)
     : backend_(backend), pipelines_(backend, pipelineWorkers), log_(std::move(log)) {
   if (const char* e = std::getenv("VP_PASS_TIMING"); e && *e && *e != '0') {
@@ -285,6 +289,9 @@ void Device::drainTimings() {
         line += e;
       }
     }
+    std::snprintf(buf, sizeof buf, " t=%.1f",
+                  std::chrono::duration<double, std::milli>(std::chrono::steady_clock::now() - kProcessStart).count());
+    line += buf;
     log_(line);
   }
 }
diff --git a/gpu/core/tests/core_tests.cpp b/gpu/core/tests/core_tests.cpp
index ecb082d..f381da4 100644
--- a/gpu/core/tests/core_tests.cpp
+++ b/gpu/core/tests/core_tests.cpp
@@ -668,7 +668,7 @@ void testDevice() {
         log[0].find(" wait_ms=") != std::string::npos);
   CHECK(log[1].find("reorderable=") != std::string::npos);  // frame 0 is a sampled one
   CHECK(log.size() == 4 && log[0].starts_with("gpu.frame f=0") && log[2].starts_with("gpu.enc") &&
-        log[3].starts_with("gpu.time f=0"));
+        log[3].starts_with("gpu.time f=0") && log[3].find(" t=") != std::string::npos);  // monotonic ms
   dev.destroy(b);
   dev.destroy(b);  // double destroy is ignored
   CHECK(be.calls[0] == "createTexture 0 RGBA8Unorm 1x1");
-- 
2.43.0

