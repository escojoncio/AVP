+++ b/gpu/vulkan/src/pipelines.cpp
@@ -798,6 +798,22 @@ void buildMotionVariants(Device* d, const VkGraphicsPipelineCreateInfo& ci, Pipe
   p.mv = std::move(mv);
   d->gpu->pipelines().request(p.mv->formatOnly, p.mv->formatOnly.key(), vpgpu::Priority::Prefetch);
   if (p.mv->hasMotion) d->gpu->pipelines().request(p.mv->motion, p.mv->motion.key(), vpgpu::Priority::Prefetch);
+  // Recipes too (were only recorded once drawn): a prewarm then compiles them before the game's first frame.
+  if (d->recipes) {
+    d->recipes->addPipeline(p.mv->formatOnly, p.recipeInputs);
+    if (p.mv->hasMotion) d->recipes->addPipeline(p.mv->motion, p.mv->motionInputs);
+  }
+}
+
+// Did this device's recipe prewarm already produce this key? Checked before the game's request.
+// The boot log's last "gpu.pso.recipe game" line is what AVP reads to trust (or drop) warm.stamp.
+void noteRecipeKey(Device* d, vpgpu::PipelineKey key, const std::string& label) {
+  if (!d->prewarmedRecipes) return;
+  const bool hit = d->gpu->pipelines().status(key) != vpgpu::PipelineCache::Status::Missing;
+  const uint32_t h = hit ? ++d->recipeHits : d->recipeHits.load(), m = hit ? d->recipeMisses.load() : ++d->recipeMisses;
+  if (!hit && m <= 8) logf("gpu.pso.recipe game miss key=%016llx pipeline=%s", (unsigned long long)key.value, label.c_str());
+  if (h + m <= 4 || (h + m) % 64 == 0)
+    logf("gpu.pso.recipe game hits=%u misses=%u prewarmed=%u", h, m, d->prewarmedRecipes);
 }
 
 PipelineObj* createGraphics(Device* d, const VkGraphicsPipelineCreateInfo& ci) {
@@ -921,6 +937,7 @@ PipelineObj* createGraphics(Device* d, const VkGraphicsPipelineCreateInfo& ci) {
   p->recipeInputs = inputs;
   if (ok && d->motion && p->viewCount > 1) buildMotionVariants(d, ci, *p, attrs);
   if (ok) {
+    noteRecipeKey(d, p->key, st.label);
     d->gpu->pipelines().request(st, p->key, vpgpu::Priority::Blocking);
     if (d->recipes) d->recipes->addPipeline(st, inputs);
   }
@@ -940,6 +957,7 @@ PipelineObj* createCompute(Device* d, const VkComputePipelineCreateInfo& ci) {
     collectUsed(*p, o, vpgpu::stage::compute);
