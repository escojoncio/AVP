+void MetalBackend::drainShaderPrewarm() {
+  Impl* m = impl_.get();
+  dispatch_queue_t qs[Impl::kMaxPrewarmQueues] = {};
+  unsigned n = 0;
+  {
+    std::lock_guard lock(m->pipelineMutex);
+    n = m->prewarmQueueCount;
+    for (unsigned i = 0; i < n; ++i) qs[i] = m->prewarmQueues[i];
+  }
+  for (unsigned i = 0; i < n; ++i)
+    if (qs[i]) dispatch_sync(qs[i], ^{});  // serial: returns once everything queued before it ran
+}
