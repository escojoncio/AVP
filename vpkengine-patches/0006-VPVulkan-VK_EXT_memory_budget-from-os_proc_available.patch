diff --git a/gpu/vulkan/src/vpvk.h b/gpu/vulkan/src/vpvk.h
index 0d0ef11..66c3ee2 100644
--- a/gpu/vulkan/src/vpvk.h
+++ b/gpu/vulkan/src/vpvk.h
@@ -50,6 +50,7 @@ struct Instance : Dispatchable {
   uint32_t apiVersion = VK_API_VERSION_1_0;
   PhysicalDevice physical;
   std::string appName, engineName;
+  Device* device = nullptr;  // the last device created (memory budget queries go through its platform)
 };
 
 struct Queue : Dispatchable {
@@ -57,6 +58,9 @@ struct Queue : Dispatchable {
   uint32_t family = 0, index = 0;
 };
 
+// Bytes of VkDeviceMemory currently allocated (all devices): VK_EXT_memory_budget heapUsage.
+std::atomic<uint64_t>& allocatedBytes();
+
 struct DeviceMemory {
   VkDeviceSize size = 0;
   uint32_t typeIndex = 0;
diff --git a/gpu/vulkan/tests/vk_tests.cpp b/gpu/vulkan/tests/vk_tests.cpp
index d7a7507..1c98949 100644
--- a/gpu/vulkan/tests/vk_tests.cpp
+++ b/gpu/vulkan/tests/vk_tests.cpp
@@ -984,6 +984,15 @@ void testAlyxSurface() {
   CHECK(vkCreateImage(c.dev, &ii, nullptr, &im) == VK_SUCCESS);
   CHECK(from<Image>(im)->desc.usage & vpgpu::usage::sampled);
   vkDestroyImage(c.dev, im, nullptr);
+  // VK_EXT_memory_budget: usage follows allocations; the budget covers it.
+  VkPhysicalDeviceMemoryBudgetPropertiesEXT mb{VK_STRUCTURE_TYPE_PHYSICAL_DEVICE_MEMORY_BUDGET_PROPERTIES_EXT};
+  VkPhysicalDeviceMemoryProperties2 mp{VK_STRUCTURE_TYPE_PHYSICAL_DEVICE_MEMORY_PROPERTIES_2, &mb};
+  vkGetPhysicalDeviceMemoryProperties2(c.pd, &mp);
+  const uint64_t used0 = mb.heapUsage[0];
+  VkDeviceMemory big = alloc(c, 64 << 20, 0);
+  vkGetPhysicalDeviceMemoryProperties2(c.pd, &mp);
+  CHECK(mb.heapUsage[0] == used0 + (64 << 20) && mb.heapBudget[0] >= mb.heapUsage[0] && mb.heapBudget[1] == 0);
+  vkFreeMemory(c.dev, big, nullptr);
   VkFormatProperties3 fp3{VK_STRUCTURE_TYPE_FORMAT_PROPERTIES_3};
   VkFormatProperties2 fp2{VK_STRUCTURE_TYPE_FORMAT_PROPERTIES_2, &fp3};
   vkGetPhysicalDeviceFormatProperties2(c.pd, VK_FORMAT_D32_SFLOAT_S8_UINT, &fp2);
