From 281cc4849be028a4b2cba9fd53139cd4748d9e91 Mon Sep 17 00:00:00 2001
From: Claude <claude@users.invalid>
Date: Tue, 13 Oct 2026 04:46:28 +0000
Subject: [PATCH 06/10] VPVulkan: VK_EXT_memory_budget from
 os_proc_available_memory

heapUsage = VkDeviceMemory currently allocated (all devices); heapBudget = usage + what visionOS
still lets the process allocate (os_proc_available_memory, the jetsam limit), capped by the heap
size; 80 % of the heap before a device exists or on hosts without the call (Linux tests). Source 2
sizes its texture streaming pool from this.

Test: gpu_vulkan.alyx (usage follows an allocation, budget covers it).

---
 gpu/vulkan/include/vpvk/platform.h |  3 +++
 gpu/vulkan/src/entry.cpp           | 23 +++++++++++++++++++++++
 gpu/vulkan/src/physical_device.cpp |  1 +
 gpu/vulkan/src/platform_metal.mm   |  2 ++
 gpu/vulkan/src/vpvk.h              |  4 ++++
 gpu/vulkan/tests/vk_tests.cpp      |  9 +++++++++
 6 files changed, 42 insertions(+)

diff --git a/gpu/vulkan/include/vpvk/platform.h b/gpu/vulkan/include/vpvk/platform.h
index 375a976..9e74cc2 100644
--- a/gpu/vulkan/include/vpvk/platform.h
+++ b/gpu/vulkan/include/vpvk/platform.h
@@ -55,6 +55,9 @@ class Platform {
   virtual void destroyTextureView(vpgpu::TextureId) {}
   // Blocks until all submitted GPU work finished (vkQueueWaitIdle / vkDeviceWaitIdle / fences).
   virtual void waitIdle() {}
+  // Bytes the process may still allocate before the OS kills it (visionOS: os_proc_available_memory),
+  // 0 = unknown. VK_EXT_memory_budget reports usage + this as the heap budget.
+  virtual uint64_t availableMemory() { return 0; }
 };
 
 // Defined by exactly one platform source linked into the dylib.
diff --git a/gpu/vulkan/src/entry.cpp b/gpu/vulkan/src/entry.cpp
index d89a413..93e806a 100644
--- a/gpu/vulkan/src/entry.cpp
+++ b/gpu/vulkan/src/entry.cpp
@@ -46,6 +46,11 @@ void logf(const char* fmt, ...) {
 
 CommandBuffer::~CommandBuffer() = default;
 
+std::atomic<uint64_t>& allocatedBytes() {
+  static std::atomic<uint64_t> n{0};
+  return n;
+}
+
 namespace {
 
 uint64_t alignUp(uint64_t v, uint64_t a) { return (v + a - 1) / a * a; }
@@ -340,9 +345,23 @@ VPVK_EXPORT VKAPI_ATTR void VKAPI_CALL vkGetPhysicalDeviceMemoryProperties(
   *m = memoryProperties();
 }
 
+// VK_EXT_memory_budget: usage = VkDeviceMemory allocated (textures are accounted by their image
+// memory too: Metal owns their storage, the allocation is its size); budget = usage + what the OS
+// still lets the process allocate (visionOS jetsam limit), capped by the heap. Without a device yet
+// (or on hosts that cannot tell) the budget is 80 % of the heap.
 VPVK_EXPORT VKAPI_ATTR void VKAPI_CALL vkGetPhysicalDeviceMemoryProperties2(
     VkPhysicalDevice pd, VkPhysicalDeviceMemoryProperties2* m) {
   vkGetPhysicalDeviceMemoryProperties(pd, &m->memoryProperties);
+  if (auto* b = static_cast<VkPhysicalDeviceMemoryBudgetPropertiesEXT*>(
+          findNextOut(m->pNext, VK_STRUCTURE_TYPE_PHYSICAL_DEVICE_MEMORY_BUDGET_PROPERTIES_EXT))) {
+    std::memset(b->heapBudget, 0, sizeof b->heapBudget);
+    std::memset(b->heapUsage, 0, sizeof b->heapUsage);
+    const uint64_t heap = memoryProperties().memoryHeaps[0].size, used = allocatedBytes().load();
+    const Device* d = from<PhysicalDevice>(pd)->instance ? from<PhysicalDevice>(pd)->instance->device : nullptr;
+    const uint64_t avail = d && d->platform ? d->platform->availableMemory() : 0;
+    b->heapUsage[0] = used;
+    b->heapBudget[0] = avail ? std::min(heap, used + avail) : heap / 10 * 8;
+  }
 }
 
 VPVK_EXPORT VKAPI_ATTR void VKAPI_CALL vkGetPhysicalDeviceFormatProperties(VkPhysicalDevice,
@@ -468,6 +487,7 @@ VPVK_EXPORT VKAPI_ATTR VkResult VKAPI_CALL vkCreateDevice(VkPhysicalDevice pd,
   }
   logUnsupportedFeatures(*ci);
   d->platform = createPlatform();
+  if (d->physical->instance) d->physical->instance->device = d;
   // Pipeline compiles run on background workers (never the submit thread); leave the game's
   // render/main threads two cores.
   const unsigned workers = std::clamp(std::thread::hardware_concurrency(), 4u, 8u) - 2u;
@@ -488,6 +508,7 @@ VPVK_EXPORT VKAPI_ATTR VkResult VKAPI_CALL vkCreateDevice(VkPhysicalDevice pd,
 VPVK_EXPORT VKAPI_ATTR void VKAPI_CALL vkDestroyDevice(VkDevice dv, const VkAllocationCallbacks*) {
   if (!dv) return;
   Device* d = from<Device>(dv);
+  if (d->physical && d->physical->instance && d->physical->instance->device == d) d->physical->instance->device = nullptr;
   d->platform->waitIdle();
   d->gpu.reset();
   delete d;
@@ -524,6 +545,7 @@ VPVK_EXPORT VKAPI_ATTR VkResult VKAPI_CALL vkAllocateMemory(VkDevice, const VkMe
     logf("vk.err what=alloc size=%llu", static_cast<unsigned long long>(ai->allocationSize));
     return VK_ERROR_OUT_OF_DEVICE_MEMORY;
   }
+  allocatedBytes() += m->size;
   *out = to<VkDeviceMemory>(m);
   return VK_SUCCESS;
 }
@@ -532,6 +554,7 @@ VPVK_EXPORT VKAPI_ATTR void VKAPI_CALL vkFreeMemory(VkDevice, VkDeviceMemory mem
                                                     const VkAllocationCallbacks*) {
   if (!mem) return;
   DeviceMemory* m = from<DeviceMemory>(mem);
+  allocatedBytes() -= m->size;
   std::free(m->host);
   delete m;
 }
