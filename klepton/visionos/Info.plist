<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  AVP's Info.plist base. Xcode generates the ordinary keys (bundle id, version) and merges the
  INFOPLIST_KEY_* build settings from project.yml on top of this file.

  On visionOS a missing usage description is not a refused permission but a PROCESS KILL (TCC),
  and the trigger is REQUESTING the authorization: the accessory tracking provider is built even
  with no controllers paired. So every provider the app constructs has its string here.
-->
<plist version="1.0">
<dict>
	<!-- Only touched when the in-game voice/microphone option is turned on. -->
	<key>NSMicrophoneUsageDescription</key>
	<string>AVP uses the microphone only when you turn it on in the settings, so the game can hear you.</string>

	<!-- The immersive-space role. Without it openImmersiveSpace "succeeds" but nothing composites. -->
	<key>UIApplicationSceneManifest</key>
	<dict>
		<key>UIApplicationPreferredDefaultSceneSessionRole</key>
		<string>UIWindowSceneSessionRoleApplication</string>
		<key>UIApplicationSupportsMultipleScenes</key>
		<true/>
		<key>UISceneConfigurations</key>
		<dict>
			<key>UISceneSessionRoleImmersiveSpaceApplication</key>
			<array>
				<dict>
					<key>UISceneInitialImmersionStyle</key>
					<string>UIImmersionStyleMixed</string>
				</dict>
			</array>
		</dict>
	</dict>

	<!-- ARKit providers: world tracking (head pose), plane detection (the real floor, build 58), hand tracking,
	     accessory tracking (Sense). Plane detection is what actually needs world sensing. -->
	<key>NSWorldSensingUsageDescription</key>
	<string>AVP finds your room's floor so Half-Life: Alyx places you at your real height, seated or standing.</string>
	<key>NSHandsTrackingUsageDescription</key>
	<string>AVP moves the player’s fingers with your real hands and can use them as controllers.</string>
	<key>NSAccessoryTrackingUsageDescription</key>
	<string>AVP tracks your PlayStation VR2 Sense controllers and maps them onto the game's controllers.</string>
	<key>NSBluetoothAlwaysUsageDescription</key>
	<string>AVP connects to spatial controllers that the system does not show as standard game controllers.</string>
	<key>NSLocalNetworkUsageDescription</key>
	<string>AVP uses the local network for the game's own in-process networking.</string>

	<!-- Array-valued, so it cannot be an INFOPLIST_KEY_ build setting. -->
	<key>GCSupportedGameControllers</key>
	<array>
		<dict>
			<key>ProfileName</key>
			<string>SpatialGamepad</string>
		</dict>
		<dict>
			<key>ProfileName</key>
			<string>ExtendedGamepad</string>
		</dict>
	</array>
	<key>GCSupportsControllerUserInteraction</key>
	<true/>

	<!-- Steam's content servers are reached over plain HTTP as well as HTTPS (every chunk is
	     verified by hash after decryption, so transport security adds nothing there). -->
	<key>NSAppTransportSecurity</key>
	<dict>
		<key>NSAllowsArbitraryLoads</key>
		<true/>
	</dict>

	<!-- The AVP folder (game, cache, logs) is visible in the Files app. -->
	<key>LSSupportsOpeningDocumentsInPlace</key>
	<true/>
	<key>UIFileSharingEnabled</key>
	<true/>
</dict>
</plist>
