+// A barrier inside a pass orders earlier attachment writes before later reads of them (subpass
+// self-dependency, dynamic_rendering_local_read): commands.cpp splits the pass there if a later
+// draw reads an attachment.
+void vpvk::recordInPassBarrier(Recorder& r) {
+  if (!r.inPass) return;
+  r.bound.localRead = true;
+  r.ops.emplace_back(OpLocalRead{});
+}
