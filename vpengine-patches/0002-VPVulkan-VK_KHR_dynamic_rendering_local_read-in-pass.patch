@@ -383,15 +390,88 @@ struct Translator {
     }
   }
 
-  // Does the pass that starts at `begin` contain a vkCmdClearAttachments?
+  // Does the pass that starts at `begin` contain a vkCmdClearAttachments, or an in-pass barrier
+  // followed by a draw that reads an attachment (both split it, so every attachment must be stored
+  // before the split)?
   static bool hasInPassClear(const Recorder& rec, const Op* begin) {
+    bool barrier = false;
     for (const Op* o = begin + 1; o < rec.ops.data() + rec.ops.size(); ++o) {
       if (std::holds_alternative<OpEndPass>(*o)) return false;
       if (std::holds_alternative<OpClearAttachments>(*o)) return true;
+      if (std::holds_alternative<OpLocalRead>(*o)) barrier = true;
+      if (const auto* d = std::get_if<OpDraw>(o); d && barrier && !d->images.empty()) return true;
     }
     return false;
   }
 
+  // An in-pass barrier. Draws after it may read the attachments (input attachments, or the
+  // attachment image bound as a texture). Metal cannot sample a texture that is an attachment of
+  // the encoder, and framebuffer fetch reads colour only (Source 2's soft particles read depth),
+  // so: the pass is split (contents stored), each attachment those draws read is copied into a
+  // driver-owned texture of the same shape, the pass reopens loading its contents, and the reads
+  // are rebound to the copies (see draw()). Exact, at the cost of one store/load and a copy.
+  void localRead(const Recorder& rec, const Op* at) {
+    if (!passOpen) return;
+    std::vector<const Image*> read;
+    auto attachmentImage = [&](uint32_t index) -> const Image* {
+      const vpgpu::TextureId t = index < vpgpu::kMaxColorAttachments ? current.colors[index].texture : current.depth.texture;
+      if (!t) return nullptr;
+      for (const Op* o = at + 1; o < rec.ops.data() + rec.ops.size(); ++o) {
+        if (std::holds_alternative<OpEndPass>(*o) || std::holds_alternative<OpNextSubpass>(*o)) break;
+        const auto* d = std::get_if<OpDraw>(o);
+        if (!d) continue;
+        for (const Image* im : d->images)
+          if (im->id == t) return im;
+      }
+      return nullptr;
+    };
+    for (uint32_t i = 0; i <= vpgpu::kMaxColorAttachments; ++i)
+      if (const Image* im = attachmentImage(i)) read.push_back(im);
+    ++st.localReads;
+    if (read.empty() || !device) return;
+    frame.endRenderPass();
+    passOpen = false;
+    for (const Image* im : read) {
+      if (!im->localReadCopy) {
+        vpgpu::TextureDesc d = im->desc;
+        d.usage = vpgpu::usage::sampled;
+        d.transient = false, d.persistent = true, d.mutableFormat = false;
+        d.label = "vk.local_read";
+        std::lock_guard<std::mutex> lock(device->resourceMutex);
+        im->localReadCopy = device->gpu->createTexture(d);
+      }
+      if (!im->localReadCopy) continue;
+      for (uint16_t m = 0; m < im->desc.mips; ++m) {
+        vpgpu::Copy c;
+        c.kind = vpgpu::CopyKind::TextureToTexture;
+        const uint32_t w = std::max(1u, im->desc.width >> m), h = std::max(1u, im->desc.height >> m);
+        c.srcTexture = {im->id, m, 0, im->desc.layers, 0, 0, 0, w, h, 1};
+        c.dstTexture = {im->localReadCopy, m, 0, im->desc.layers, 0, 0, 0, w, h, 1};
+        c.label = "vk.local_read";
+        frame.copy(std::move(c));
+        ++st.copies;
+      }
+      localCopies.push_back({im->id, im->localReadCopy});
+    }
+    reopen();
+  }
+
+  // Reads of attachments copied by localRead() go to the copies.
+  void rebindLocalReads(vpgpu::Draw& d) const {
+    for (const auto& [from, to] : localCopies) {
+      for (vpgpu::Access& a : d.bindings) {
+        if (a.range.kind != vpgpu::ResourceRange::Kind::Texture || a.range.index != from.index ||
+            a.range.generation != from.generation)
+          continue;
+        a.range.index = to.index, a.range.generation = to.generation;
+        // The attachment's own view (an aspect or layer view) is replaced by the copy itself.
+        d.views.erase(std::remove_if(d.views.begin(), d.views.end(),
+                                     [&](const vpgpu::ViewBinding& v) { return v.kind == a.kind && v.slot == a.slot; }),
+                      d.views.end());
+      }
+    }
+  }
+
   static const uint8_t* indirectData(const Buffer* b, VkDeviceSize offset, VkDeviceSize size) {
     if (!b || !b->memory || !b->memory->host || offset + size > b->size) return nullptr;
     return b->memory->host + b->offset + offset;
@@ -402,6 +482,16 @@ struct Translator {
       ++st.skippedDraws;
       return;
     }
+    if (!localCopies.empty()) {
+      OpDraw copy = d;
+      copy.images.clear();
+      rebindLocalReads(copy.draw);
+      return drawResolved(copy);
+    }
+    drawResolved(d);
+  }
+
+  void drawResolved(const OpDraw& d) {
     if (!d.indirect) {
       frame.draw(d.draw);
       ++st.draws;
@@ -468,8 +558,8 @@ struct Translator {
 
 }  // namespace
 
-void translate(const Recorder& rec, vpgpu::Frame& frame, TranslateStats& st) {
-  Translator t{frame, st};
+void translate(const Recorder& rec, vpgpu::Frame& frame, TranslateStats& st, Device* device) {
+  Translator t{frame, st, device};
   t.run(rec);
   t.close();
 }
